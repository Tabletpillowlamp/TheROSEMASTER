// Delete these import lines if you already have them in your script file.


// Bow and arrow tiles cannot exceed 32768!
// Your bow and arrow tiles should be in the order up, down, left, right.
// This item script should be attached to the Action Script slot of an item that has a custom item class, not an existing bow. 
// D0: bow tile
// D1: bow CSet
// D2: arrow tile
// D3: arrow CSet
// D4: arrow damage
// D5: arrow step speed
item script LttPBow
{
	void run(int dummy,int bow_tile, int bow_cset, int arrow_tile, int arrow_cset, int arrow_damage, int arrow_step)
	{
		// Only triggers if the bow isn't already drawn.
		int script_name[] = "LttPBowFFC";
		int script_num = Game->GetFFCScript(script_name);
		int bow_family = this->Family;
		if (CountFFCsRunning(script_num) == 0)
		{
			float args[] = {bow_tile, bow_cset, arrow_tile, arrow_cset, arrow_damage, arrow_step, bow_family};
			RunFFCScript(script_num, args);
		}
			
	}
}

ffc script LttPBowFFC
{
	void run(int bow_tile, int bow_cset, int arrow_tile, int arrow_cset, int arrow_damage, int arrow_step, int bow_family)
	{
		itemdata A_item;
		itemdata B_item;
		itemdata X_item;
		itemdata Y_item;
		bool using_A = false;
		bool using_B = false;
		bool using_X = false;
		bool using_Y = false;
		
		A_item = Game->LoadItemData(GetEquipmentA());
		if (A_item->Family == bow_family)
		{
			using_A = true;
		}
		B_item = Game->LoadItemData(GetEquipmentB());
		if (B_item->Family == bow_family)
		{
			using_B = true;
		}
		X_item = Game->LoadItemData(GetEquipmentX());
		if (X_item->Family == bow_family)
		{
			using_X = true;
		}
		Y_item = Game->LoadItemData(GetEquipmentY());
		if (Y_item->Family == bow_family)
		{
			using_Y = true;
		}
		
		// Comment this out to give Link's bowmanship a lot less oomph.
		Link->Action = LA_ATTACKING;
		
		// Loop to draw the bow for 15 frames before firing. Similar for loops for additional frames of animation, such as taking out the bow
		// à la Link to the Past, can be placed here.
		for (int i = 0; i < 15; i++)
		{
			A_item = Game->LoadItemData(GetEquipmentA());
			B_item = Game->LoadItemData(GetEquipmentB());
			X_item = Game->LoadItemData(GetEquipmentX());
			Y_item = Game->LoadItemData(GetEquipmentY());
			
			Link->InputUp = false;
			Link->InputDown = false;
			Link->InputLeft = false;
			Link->InputRight = false;
			
			if (arrow_tile == 7932){
				i += 1;
			}
			if (arrow_tile == 7908){
				i += 2;
			}
			
			if (A_item->Family != bow_family)
			{
				Link->InputA = false;
				// Quits if you switch item.
				//if (!using_A)
				//{
				//	Quit();
				//}
			}
			if (B_item->Family != bow_family)
			{
				Link->InputB = false;
			}
			if (X_item->Family != bow_family)
			{
				Link->InputEx1 = false;
			}
			if (Y_item->Family != bow_family)
			{
				Link->InputEx2 = false;
			}
			// Disable other button inputs here if you want.
			
			// Quits if Link gets hit. Comment this out if you don't want arrow firing to be interrupted.
			if (Link->Action == LA_GOTHURTLAND)
			{
				Quit();
			}
			
			Screen->FastTile(4, Link->X + InFrontX(Link->Dir, 7), Link->Y + InFrontY(Link->Dir, 7), bow_tile + Link->Dir, bow_cset, OP_OPAQUE);
			
			Waitframe();
		}
		
		// Checks to see that you have arrows and that no previously fired arrows are on screen.
		if ( (((Game->Counter[CR_ARROWS] > 0) && (arrow_tile != 7928)) ||((Game->Counter[CR_MAGIC] > 8) && (arrow_tile == 7928))) && NumLWeaponsOf(LW_ARROW) == 0)
		{
			if (arrow_tile != 7928){
				Game->Counter[CR_ARROWS]--;
			}
			else {
				Game->Counter[CR_MAGIC] -= 8;
			}
			if (arrow_tile == 7932){
				Game->PlaySound(92);
			}
			if (arrow_tile == 7908){
				Game->PlaySound(102);
				if(Link->Item[242]){ //Eyes of God
					for(int i = -1; i <= 1; i++){
						if(i!=0){
							lweapon fyre = FireLWeaponDegAngle(LW_ARROW,Link->X,Link->Y,DirAngle(Link->Dir)+(i*10),arrow_step,arrow_damage,244,25);
							fyre->Angular = true;
							fyre->AutoRotate = true;
						}
					}
				}
			}
			else {
				Game->PlaySound(SFX_ARROW);
			}
			lweapon arrow = NextToLink(LW_ARROW, 0);
			arrow->Tile = arrow_tile + Link->Dir;
			arrow->CSet = arrow_cset;
			arrow->Damage = arrow_damage;
			arrow->Step = arrow_step;
			arrow->Dir = Link->Dir;
			
			if (bow_tile == 7924)	{
				Game->PlaySound(96);
				lweapon arrow2 = NextToLink(LW_ARROW, 0);
				arrow2->Tile = arrow_tile + Link->Dir;
				arrow2->CSet = arrow_cset;
				arrow2->Damage = arrow_damage;
				arrow2->Step = arrow_step * .5;
				lweapon arrow3 = NextToLink(LW_ARROW, 0);
				arrow3->Tile = arrow_tile + Link->Dir;
				arrow3->CSet = arrow_cset;
				arrow3->Damage = arrow_damage;
				arrow3->Step = arrow_step * .5;
				if (Link->Dir == 0){
					arrow2->Dir = 4;
					arrow3->Dir = 5;
				}
				else if (Link->Dir == 1){
					arrow2->Dir = 7;
					arrow3->Dir = 6;
				}
				else if (Link->Dir == 2){
					arrow2->Dir = 6;
					arrow3->Dir = 4;
				}
				else {
					arrow2->Dir = 5;
					arrow3->Dir = 7;
				}
			}
			
			if (Game->LoadItemData(211)->Level == 2){ //Linkle
				arrow->Step += 250;
			}
			
			//Arrow hitbox shenanigans. Modeled after ZC arrow defaults.
			if (arrow->Dir == DIR_UP || arrow->Dir == DIR_DOWN)
			{
				arrow->HitWidth = 15;
				arrow->HitHeight = 12;
				arrow->HitXOffset = 0;
				arrow->HitYOffset = 2;
				arrow->DrawXOffset = 0;
				arrow->DrawYOffset = -2;
			}
			else
			{
				arrow->HitWidth = 12;
				arrow->HitHeight = 14;
				arrow->HitXOffset = 2;
				arrow->HitYOffset = 2;
				arrow->DrawXOffset = 0;
				arrow->DrawYOffset = 1;
			}
		}
		else
		{
			if (Game->Counter[CR_ARROWS] == 0)
			{
				//Game->PlaySound(0); // Uncomment and put in appropriate number for failure sound if out of arrows.
			}
			Quit();
		}
	}
}