				}
				break;
			case 8:	//Music 2
				xPos1 = 96; xPos2 = 48; xPos3 = 64; xPos4 = 64;
				for(i = 1 ; i <= wait2 ; ++i){
					for(i1 = 0 ; i1 < hLength6 ; ++i1){
						FastTile(5, xPos1 + (16 * i1), yPos1, header6 + i1, 8, OP_OPAQUE);
					}
					for(i2 = 0 ; i2 < sLength6A ; ++i2){
						FastTile(5, xPos2 + (16 * i2), yPos2, sub6A + i2, 8, OP_OPAQUE);
					}
