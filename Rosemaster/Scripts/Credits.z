						FastTile(5, xPos3 + (16 * i3), yPos3, sub6B + i3, 8, OP_OPAQUE);
					}
					for(i4 = 0 ; i4 < sLength6C ; ++i4){
						FastTile(5, xPos3 + (16 * i4), yPos4, sub6C + i4, 8, OP_OPAQUE);
