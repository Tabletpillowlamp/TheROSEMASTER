					if(fireSFX)
						Game->PlaySound(fireSFX);
					EZB_RunEffect(1, EZB_WeaponTypeToID(ghost->Weapon), CenterX(ghost)-8, CenterY(ghost)-8, angle, 200, fireSPR, ghost->WeaponDamage);
				}
