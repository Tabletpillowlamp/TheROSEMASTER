					EZB_Waitframes(this, ghost, vars, 40);
					i3 = Rand(-18,18);
					for(i=0; i<10; ++i){
						EZB_Fire(this, ghost, vars, CenterX(ghost)-8, CenterY(ghost)-8, 36*i+i3, 150);
					}
					for(i2=0; i2<10; ++i2){
						EZB_Fire(this, ghost, vars, CenterX(ghost)-8, CenterY(ghost)-8, 36*i2+i3+18, 90);
					}
					EZB_Waitframes(this, ghost, vars, 30);
					Ghost_Data = combo;
					EZB_Waitframes(this, ghost, vars, 10);
				}
				if(attack==347){ //Valkyrie L2 2
					EZB_FaceLink(this, ghost, vars);
					EZB_FiringAnim(this, ghost, vars, 2);
					Game->PlaySound(70);
					EZB_Waitframes(this, ghost, vars, 32);
