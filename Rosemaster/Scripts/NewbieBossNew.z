					if(Game->Counter[16] == 3){ //Hard Reward
						Screen->Message(7869); EZB_Waitframes(this, ghost, vars, 10);
						RunFFCScript(56, {0x78,40,0}); Game->PlaySound(124);
						if(Link->HP <= Link->MaxHP / 2){ //Heals Link
							if(Link->MaxHP - Link->HP <= 128){
								Link->HP = Link->MaxHP;
							}
							else{
								Link->HP += 128;
							}
						}
						else{ //Damages Dragon
							Ghost_HP -= 48;
						}
						EZB_Waitframes(this, ghost, vars, 50);
					}
				}
				if(attack==346){ //Valkyrie L2 1
					EZB_FaceLink(this, ghost, vars);
					EZB_FiringAnim(this, ghost, vars, 2);
