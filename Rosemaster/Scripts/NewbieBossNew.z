							Link->MP = 0; EZB_Waitframe(this, ghost, vars);
							RunGenericScriptFrz(CheckGenericScript("freezeScreenGeneric"),{70, 124, 0x78, 40});
							EZB_Waitframes(this, ghost, vars, 40);
							k = 1;
						}
						else{ //Shooting
							i = 0; int shotHP = ghost->HP;
							while(i <= 30 && shotHP - ghost->HP < 60){
								newX = Rand(0,10); newY = Rand(0,5);
								newX *= 16; newY *= 16;
								newX += 32; newY += 32;
								//Aim
								Game->PlaySound(5);
								for(i6=0; i6<=14; ++i6){
									if(i6%2==0){
										Rectangle(2, newX, newY, newX+32, newY+32, 132, 1, 0, 0, 0, 1, OP_TRANS);
									}
									EZB_Waitframe(this, ghost, vars);
								}
								//Fire
								Game->PlaySound(102);
								eweapon fyre1 = CreateEWeaponAt(140, newX, newY);
								fyre1->UseSprite(81); fyre1->Damage = 36; fyre1->Step = 0;
								fyre1->Unblockable = UNBLOCK_ALL;
								eweapon fyre2 = CreateEWeaponAt(140, newX+16, newY);
								fyre2->UseSprite(81); fyre2->Damage = 36; fyre2->Step = 0;
								fyre2->Unblockable = UNBLOCK_ALL;
								eweapon fyre3 = CreateEWeaponAt(140, newX, newY+16);
								fyre3->UseSprite(81); fyre3->Damage = 36; fyre3->Step = 0;
								fyre3->Unblockable = UNBLOCK_ALL;
								eweapon fyre4 = CreateEWeaponAt(140, newX+16, newY+16);
								fyre4->UseSprite(81); fyre4->Damage = 36; fyre4->Step = 0;
								fyre4->Unblockable = UNBLOCK_ALL;
								i += 1;
							}
						}
						//Change Back
						EZB_Waitframes(this, ghost, vars, 20);
						Ghost_Data = combo + 2;
						EZB_Waitframes(this, ghost, vars, 50);
						Game->PlaySound(94);
						Ghost_SetAllDefenses(ghost, NPCDT_IGNORE);
						Ghost_Data = combo + 1;
						EZB_Waitframes(this, ghost, vars, 12);
						Ghost_Data = combo;
						EZB_Waitframes(this, ghost, vars, 50);
					}
					
					//Phase 2
					EZB_Waitframes(this, ghost, vars, 40);
					Screen->Message(7879);
					EZB_Waitframes(this, ghost, vars, 40);
					//Charging Flame Fill
					Game->PlaySound(35);
					for(i6=0; i6<=150; ++i6){
						if(i6%2==0){
							Rectangle(2, 32, 32, 223, 63, 132, 1, 0, 0, 0, 1, OP_TRANS);
							Rectangle(2, 32, 112, 223, 143, 132, 1, 0, 0, 0, 1, OP_TRANS);
							Rectangle(2, 32, 64, 95, 111, 132, 1, 0, 0, 0, 1, OP_TRANS);
							Rectangle(2, 160, 64, 223, 111, 132, 1, 0, 0, 0, 1, OP_TRANS);
						}
						EZB_Waitframe(this, ghost, vars);
						
						if(i6 == 70){Ghost_Data = combo + 1;}
						if(i6 == 78){Ghost_Data = combo + 2;}
						if(i6 == 100){Game->PlaySound(70); Ghost_Data = combo + 3;}
						
					}
					//Flame Fill
					Game->PlaySound(37); RunFFCScript(56, {9,50,0});
					Screen->Quake = 60;
					Link->SwordJinx = 60;
					Link->ItemJinx = 60;
					i4 = 17412; //Flame Combo
					i5 = 6588; //Smoke Combo
					for(i2=2; i2<=8; ++i2){ //Rows of Fire
						for(i3=2; i3<=13; ++i3){ //Columns of Fire
							if( !((i2 >= 4 && i2 <= 6) && (i3 >= 6 && i3 <= 9)) ){ //Open Space
								Game->LoadTempScreen(2)->ComboD[ComboAt(i3*16,i2*16)] = i4;
								Game->LoadTempScreen(3)->ComboD[ComboAt(i3*16,i2*16)] = i5;
							}
						}
					}
					EZB_Waitframes(this, ghost, vars, 80);
					Ghost_Data = combo + 2;
					EZB_Waitframes(this, ghost, vars, 50);
					Game->PlaySound(94);
					Ghost_SetAllDefenses(ghost, NPCDT_IGNORE);
					Ghost_Data = combo + 1;
					EZB_Waitframes(this, ghost, vars, 12);
					Ghost_Data = combo;
					EZB_Waitframes(this, ghost, vars, 60);
					
					//Teleporting Variables
					int cDir = 0; // 0: Up, 1: Down, 2: Left, 3: Right
					int lastDir = 4; //Last Direction Randomized
					int loopTimes = 1; int loopDelay = 16; 
					int atkType = 0; int atkSpeed = 3; int atkDelay = 12;
					
					//Teleporting Loop
					while(true){
						Game->PlaySound(120); Ghost_Data = combo + 302;
						EZB_Waitframes(this, ghost, vars, 60);
						//Disappear
						Ghost_Data = 0; Ghost_X = 0; Ghost_Y = 0;
						EZB_Waitframes(this, ghost, vars, 30);
						if(Link->MP > 0){ //Drain MP
							RunGenericScriptFrz(CheckGenericScript("freezeScreenGeneric"),{70, 124, 0x78, 40});
							Link->MP = 0; EZB_Waitframe(this, ghost, vars);
							RunGenericScriptFrz(CheckGenericScript("freezeScreenGeneric"),{70, 124, 0x78, 40});
							EZB_Waitframes(this, ghost, vars, 6);
						}
						EZB_Waitframes(this, ghost, vars, 10);
						//Conditions for Phase 3
						if(ghost->HP > dmgT3){
							loopTimes = Rand(5,18);
							loopDelay = 16; atkType = 0;
							atkSpeed = 3; atkDelay = 16;
						}
						else{
							loopTimes = Rand(8,22);
							loopDelay = 12; atkType = Rand(0,2);;
							atkSpeed = 3; atkDelay = 14;
						}
						//Appear Again
						Ghost_Data = combo;
						//Teleport Erratically
						for(i3=0; i3<loopTimes; ++i3){
							cDir = Rand(0,3);
							Game->PlaySound(56);
							//Teleport again if same
							while(cDir == lastDir){cDir = Rand(0,3);}
							//Teleport Direction
							if(cDir == 0){ //Up
								Ghost_X = 112; Ghost_Y = 16;
							}
							else if(cDir == 1){ //Down
								Ghost_X = 112; Ghost_Y = 128;
							}
							else if(cDir == 2){ //Left
								Ghost_X = 16; Ghost_Y = 72;
							}
							else{ //Right
								Ghost_X = 208; Ghost_Y = 72;
							}
							EZB_Waitframes(this, ghost, vars, loopDelay);
							lastDir = cDir; //Set last Dir
						}
						
						if(atkType < 2){ //Lunge
							//About to Attack
							Ghost_Data = combo + 303;
							EZB_Waitframes(this, ghost, vars, atkDelay);
							if(cDir <= 1){//Delay Up and Down
								EZB_Waitframes(this, ghost, vars, atkDelay);
								atkSpeed -= 1;
							}
							//=====Lunge=====
							//Combo Change
							if(cDir == 0){Ghost_Data = combo + 304;}
							else if(cDir == 1){Ghost_Data = combo + 305;}
							else if(cDir == 2){Ghost_Data = combo + 306;}
							else{Ghost_Data = combo + 307;}
							//Set Defenses weak to Sword
							ghost->Defense[NPCD_SWORD] = NPCDT_NONE;
							//Set up CenterX and CenterY
							newX = 120; newY = 68;
							//Checkpoint Boss HP
							j = ghost->HP;
							//if k != 0, then boss successfully reached center
							k = 0;
							//Strike as long as not damaged
							Screen->Quake = 30;
							Game->PlaySound(37);
							angle = Angle(CenterX(ghost), CenterY(ghost), newX, newY);
							while(((CenterX(ghost)<(newX-4)) || (CenterX(ghost)>(newX+4)) || (CenterY(ghost)<(newY-4)) || (CenterY(ghost)>(newY+4))) && ghost->HP == j){
								EZB_Trail(this, ghost, vars);
