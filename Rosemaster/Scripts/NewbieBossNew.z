								SetEWeaponMovement(wpn, EWM_HOMING_REAIM, 1, 30);
							}
						}
					}
					
					EZB_Waitframes(this, ghost, vars, 24);
					
				}
				if(attack==26){ //4 Way Shot (Normal)
					EZB_FiringAnim(this, ghost, vars, 0);
