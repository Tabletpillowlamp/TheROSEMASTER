							}
							EZB_Waitframe(this, ghost, vars);
						}
						++k;
						if ( CenterX(ghost)+24*k*-1 < 16 && CenterX(ghost)+24*k > 224 || k > 10 )
							break;
                        //stop if Link has crossed the attack
                        if ( k > 2 && Link->X+8-16 > CenterX(ghost)+24*k*-1 && Link->X+8+16 < CenterX(ghost)+24*k )
                            break;
					}
				}
