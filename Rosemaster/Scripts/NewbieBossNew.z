						if ( angle == 0 )
							EZB_Fire(this, ghost, vars, 0, Rand(8, 152), angle, 250);
						else
							EZB_Fire(this, ghost, vars, 240, Rand(8, 152), angle, 250);
						EZB_Waitframes(this, ghost, vars, 8);
					}
					EZB_Waitframes(this, ghost, vars, 24);
				}
				if(attack==30){ //Laser Storm
