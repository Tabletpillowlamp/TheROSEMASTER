						int Beam1Y = CenterY(ghost) + beamRadius * Sin(Beam1D);
						int Beam2X = CenterX(ghost)-8 + beamRadius * Cos(Beam2D);
						int Beam2Y = CenterY(ghost) + beamRadius * Sin(Beam2D);
						int Beam3X = CenterX(ghost)-8 + beamRadius * Cos(Beam3D);
						int Beam3Y = CenterY(ghost) + beamRadius * Sin(Beam3D);
						int Beam4X = CenterX(ghost)-8 + beamRadius * Cos(Beam4D);
						int Beam4Y = CenterY(ghost) + beamRadius * Sin(Beam4D);
						for(i2=0; i2<30; ++i2){
							FastCombo(1,Beam1X,Beam1Y,16570,8,OP_OPAQUE);
							FastCombo(1,Beam2X,Beam2Y,16570,8,OP_OPAQUE);
							FastCombo(1,Beam3X,Beam3Y,16570,8,OP_OPAQUE);
							FastCombo(1,Beam4X,Beam4Y,16570,8,OP_OPAQUE);
							EZB_Waitframe(this, ghost, vars);
						}
						Game->PlaySound(85);
						Screen->Quake = 40;
						Link->SwordJinx = 40;
						Link->ItemJinx = 40;
						for(i5=0; i5<spinTimes; ++i5){
							if(i5 != 0){
								Ghost_SetAllDefenses(ghost, 13);
								Ghost_Data = combo+15;
							}
							for(i=0; i<spinDuration; ++i){ //Spinning
								Beam1X = CenterX(ghost)-8 + beamRadius * Cos(Beam1D+i*spinBeamSpeed);
								Beam1Y = CenterY(ghost) + beamRadius * Sin(Beam1D+i*spinBeamSpeed);
								Beam2X = CenterX(ghost)-8 + beamRadius * Cos(Beam2D+i*spinBeamSpeed);
								Beam2Y = CenterY(ghost) + beamRadius * Sin(Beam2D+i*spinBeamSpeed);
								Beam3X = CenterX(ghost)-8 + beamRadius * Cos(Beam3D+i*spinBeamSpeed);
								Beam3Y = CenterY(ghost) + beamRadius * Sin(Beam3D+i*spinBeamSpeed);
								Beam4X = CenterX(ghost)-8 + beamRadius * Cos(Beam4D+i*spinBeamSpeed);
								Beam4Y = CenterY(ghost) + beamRadius * Sin(Beam4D+i*spinBeamSpeed);
								if((i>=90)||(i5!=0)){
									if (i % 35 == 0){ //Shoot beam 1
										EZB_Fire(this, ghost, vars, Beam1X, Beam1Y, Angle(Beam1X, Beam1Y, CenterLinkX(), CenterLinkY()), spinShostSpeed);
									}
									if (i % 40 == 0){ //Shoot beam 2
										EZB_Fire(this, ghost, vars, Beam2X, Beam2Y, Angle(Beam2X, Beam2Y, CenterLinkX(), CenterLinkY()), spinShostSpeed);
									}
									if (i % 45 == 0){ //Shoot beam 3
										EZB_Fire(this, ghost, vars, Beam3X, Beam3Y, Angle(Beam3X, Beam3Y, CenterLinkX(), CenterLinkY()), spinShostSpeed);
									}
									if (i % 50 == 0){ //Shoot beam 4
										EZB_Fire(this, ghost, vars, Beam4X, Beam4Y, Angle(Beam4X, Beam4Y, CenterLinkX(), CenterLinkY()), spinShostSpeed);
									}
								}
								FastCombo(1,Beam1X,Beam1Y,16570,8,OP_OPAQUE);
								FastCombo(1,Beam2X,Beam2Y,16570,8,OP_OPAQUE);
								FastCombo(1,Beam3X,Beam3Y,16570,8,OP_OPAQUE);
								FastCombo(1,Beam4X,Beam4Y,16570,8,OP_OPAQUE);
								EZB_Waitframe(this, ghost, vars);
							}
							Ghost_Data = combo+14;
							for(i2=0; i2<50; ++i2){
								if(i2>=20){
									if(i2==20){Game->PlaySound(35);}
									EZB_DoLaser(LAYER_EZB_LASER, Beam1X, Beam1Y, 8, Angle(CenterX(ghost)-8, CenterY(ghost), Beam1X, Beam1Y), 0, laserColors, -1, 0, i2, 30);
									EZB_DoLaser(LAYER_EZB_LASER, Beam2X, Beam2Y, 8, Angle(CenterX(ghost)-8, CenterY(ghost), Beam2X, Beam2Y), 0, laserColors, -1, 0, i2, 30);
									EZB_DoLaser(LAYER_EZB_LASER, Beam3X, Beam3Y, 8, Angle(CenterX(ghost)-8, CenterY(ghost), Beam3X, Beam3Y), 0, laserColors, -1, 0, i2, 30);
									EZB_DoLaser(LAYER_EZB_LASER, Beam4X, Beam4Y, 8, Angle(CenterX(ghost)-8, CenterY(ghost), Beam4X, Beam4Y), 0, laserColors, -1, 0, i2, 30);
								}
								FastCombo(1,Beam1X,Beam1Y,16570,8,OP_OPAQUE);
								FastCombo(1,Beam2X,Beam2Y,16570,8,OP_OPAQUE);
								FastCombo(1,Beam3X,Beam3Y,16570,8,OP_OPAQUE);
								FastCombo(1,Beam4X,Beam4Y,16570,8,OP_OPAQUE);
								EZB_Waitframe(this, ghost, vars);
							}
							Game->PlaySound(37);
							Ghost_Data = combo+3;
							restoreInDefenses(this, ghost, vars, 1);
							Screen->Quake = 40;
							Link->SwordJinx = 40;
							Link->ItemJinx = 40;
							for(i2=0; i2<30; ++i2){
								FastCombo(1,Beam1X,Beam1Y,16570,8,OP_TRANS);
								FastCombo(1,Beam2X,Beam2Y,16570,8,OP_TRANS);
								FastCombo(1,Beam3X,Beam3Y,16570,8,OP_TRANS);
								FastCombo(1,Beam4X,Beam4Y,16570,8,OP_TRANS);
								EZB_DoLaser(LAYER_EZB_LASER, Beam1X, Beam1Y, 8, Angle(CenterX(ghost)-8, CenterY(ghost), Beam1X, Beam1Y), ghost->WeaponDamage, laserColors, -1, 1, i2, 20);
								EZB_DoLaser(LAYER_EZB_LASER, Beam2X, Beam2Y, 8, Angle(CenterX(ghost)-8, CenterY(ghost), Beam2X, Beam2Y), ghost->WeaponDamage, laserColors, -1, 1, i2, 20);
								EZB_DoLaser(LAYER_EZB_LASER, Beam3X, Beam3Y, 8, Angle(CenterX(ghost)-8, CenterY(ghost), Beam3X, Beam3Y), ghost->WeaponDamage, laserColors, -1, 1, i2, 20);
								EZB_DoLaser(LAYER_EZB_LASER, Beam4X, Beam4Y, 8, Angle(CenterX(ghost)-8, CenterY(ghost), Beam4X, Beam4Y), ghost->WeaponDamage, laserColors, -1, 1, i2, 20);
								EZB_Waitframe(this, ghost, vars);
							}
							if(i5!=0){EZB_Waitframes(this, ghost, vars, 16);}
							else{Ghost_Data = combo+2;EZB_Waitframes(this, ghost, vars, 8);}
						}
						Ghost_Data = combo+4;
						if(Link->Item[151]){EZB_Waitframes(this, ghost, vars, 10);}
						else{EZB_Waitframes(this, ghost, vars, 20);}
					}
					if(atkType == 2){ //Thorn Sweep (15%)
						Game->PlaySound(35);
						Ghost_Data = combo+1;
						EZB_Waitframes(this, ghost, vars, 32);
						Ghost_Data = combo+3;
						//Shoots a homing whirlwind
						Game->PlaySound(37);
						Screen->Quake = 30;
						RunFFCScript(56, argsg);
						int wflags;
						wflags |= EWF_UNBLOCKABLE;
						if(phase==0){
							eweapon e1 = FireEWeapon(EW_ARROW, CenterX(ghost)-8, CenterY(ghost)-8, 90, 130, ghost->WeaponDamage, 13, 25, wflags);
							SetEWeaponMovement(e1, EWM_HOMING, DegtoRad(2.5), 150);
						}
						else{
							eweapon e1 = FireEWeapon(EW_ARROW, CenterX(ghost)-24, CenterY(ghost)-8, 90, 130, ghost->WeaponDamage, 13, 25, wflags);
							eweapon e2 = FireEWeapon(EW_ARROW, CenterX(ghost)+8, CenterY(ghost)-8, 90, 130, ghost->WeaponDamage, 13, 25, wflags);
							SetEWeaponMovement(e1, EWM_HOMING, DegtoRad(2.5), 150);
							SetEWeaponMovement(e2, EWM_HOMING, DegtoRad(2.5), 150);
						}
						//Move left or right
						int sweepStart = 0; //0 = Left, 1 = Right
						if(Link->X<=128){
							sweepStart = 1;
						}
						randY = 32;
						if(sweepStart==0){
							randX = 64;
						}
						else{
							randX = 176;
						}
						while((CenterX(ghost)<(randX-4)) || (CenterX(ghost)>(randX+4)) || (CenterY(ghost)<(randY-4)) || (CenterY(ghost)>(randY+4))){
							EZB_Trail(this, ghost, vars);
							angle = Angle(CenterX(ghost), CenterY(ghost), randX, randY);
							Ghost_MoveAtAngle(angle, 3, 0);
							EZB_FaceLink(this, ghost, vars);
							EZB_Waitframe(this, ghost, vars);
						}
						Ghost_Data = combo;
						EZB_Waitframes(this, ghost, vars, 28);
						//Become invincible
						Ghost_SetAllDefenses(ghost, 13);
						Game->PlaySound(102);
						Ghost_Data = combo+14;
						RunFFCScript(56, args);
						EZB_Waitframes(this, ghost, vars, 40);
						//Shoot Sweeping Thorns
						Ghost_Data = combo+15;
						int sweepDir = sweepStart;
						for(i2=0; i2<=numberRounds; i2+=1){
							if(sweepStart==0){
								sweepDir = -1;
								randX = 176;
							}
							else{
								sweepDir = 1;
								randX = 64;
							}
							i = 0;
							while((CenterX(ghost)<(randX-4)) || (CenterX(ghost)>(randX+4)) || (CenterY(ghost)<(randY-4)) || (CenterY(ghost)>(randY+4))){
								if(i % 9 == 0){
									eweapon e1 = EZB_Fire(this, ghost, vars, CenterX(ghost)-24, CenterY(ghost)+8, 90, sweepSpeed);
									eweapon e2 = EZB_Fire(this, ghost, vars, CenterX(ghost)+8, CenterY(ghost)+8, 90, sweepSpeed);
									SetEWeaponMovement(e1, EWM_HOMING, DegtoRad(0.4), 150);
									SetEWeaponMovement(e2, EWM_HOMING, DegtoRad(0.4), 150);
								}
								EZB_Trail(this, ghost, vars);
								angle = Angle(CenterX(ghost), CenterY(ghost), randX, randY);
								Ghost_MoveAtAngle(angle, 2, 0);
								EZB_FaceLink(this, ghost, vars);
								EZB_Waitframe(this, ghost, vars);
								i += 1;
							}
							if(i2%3 == 2){ //Shoot Wind
								Game->PlaySound(35);
								Ghost_Data = combo+14;
								EZB_Waitframes(this, ghost, vars, 32);
								Ghost_Data = combo+15;
								Game->PlaySound(37);
								Screen->Quake = 30;
								RunFFCScript(56, argsg);
								int wflags;
								wflags |= EWF_UNBLOCKABLE;
								if(phase==0){
									eweapon e1 = FireEWeapon(EW_ARROW, CenterX(ghost)-8, CenterY(ghost)-8, 90, 130, ghost->WeaponDamage, 13, 25, wflags);
									SetEWeaponMovement(e1, EWM_HOMING, DegtoRad(2.5), 150);
								}
								else{
									eweapon e1 = FireEWeapon(EW_ARROW, CenterX(ghost)-24, CenterY(ghost)-8, 90, 130, ghost->WeaponDamage, 13, 25, wflags);
									eweapon e2 = FireEWeapon(EW_ARROW, CenterX(ghost)+8, CenterY(ghost)-8, 90, 130, ghost->WeaponDamage, 13, 25, wflags);
									SetEWeaponMovement(e1, EWM_HOMING, DegtoRad(2.5), 150);
									SetEWeaponMovement(e2, EWM_HOMING, DegtoRad(2.5), 150);
								}
								EZB_Waitframes(this, ghost, vars, 30);
							}
							//Reset Movement
							if(sweepStart==0){sweepStart=1;}else{sweepStart=0;}
						}
						Ghost_Data = combo+14;
						EZB_Waitframes(this, ghost, vars, 24);
						restoreInDefenses(this, ghost, vars, 1);
						Ghost_Data = combo+2;
						Game->PlaySound(94);
						if(Link->Item[151]){EZB_Waitframes(this, ghost, vars, 16);}
						else{EZB_Waitframes(this, ghost, vars, 30);}
					}
					if(atkType == 3){ //Dragons (30%)
						EZB_Waitframes(this, ghost, vars, 10);
						Ghost_Data = combo+2;
						Game->PlaySound(32);
						EZB_Waitframes(this, ghost, vars, 30);
						Ghost_Data = combo+4;
						Game->PlaySound(97);
						Ghost_Z = 8;
						Ghost_SetAllDefenses(ghost, 13);
						for(i3=0; i3<50; ++i3){
							Ghost_Z += 4;
							EZB_Waitframe(this, ghost, vars);
						}
						EZB_Waitframes(this, ghost, vars, 30);
						Ghost_UnsetFlag(GHF_NO_FALL);
						Ghost_Data = GH_INVISIBLE_COMBO;
						Ghost_X = 0;
						Ghost_Y = 0;
						Ghost_Z = 0;
						EZB_Waitframes(this, ghost, vars, 10);
						//Dragons Shoot
						int leftDragonY = 0; int rightDragonY = 0;
						int lasFrames = 30;
						for(i3=0; i3<dragonTimes; ++i3){
							leftDragonY = Rand(40,144);
							if(i3!=0){
								while(Abs(leftDragonY-rightDragonY)<=32){
									leftDragonY = Rand(40,144);
								}
							}
							Game->PlaySound(8);Screen->Quake = 16;
							//Left Dragon moves 
							for(i4=0; i4<8; ++i4){
								FastCombo(2,-32+i4*4,leftDragonY-16,16640,7,OP_OPAQUE);
								FastCombo(2,-16+i4*4,leftDragonY-16,16641,7,OP_OPAQUE);
								FastCombo(2,-32+i4*4,leftDragonY,16644,7,OP_OPAQUE);
								FastCombo(2,-16+i4*4,leftDragonY,16645,7,OP_OPAQUE);
								FastCombo(2,-32+i4*4,leftDragonY+16,16648,7,OP_OPAQUE);
								FastCombo(2,-16+i4*4,leftDragonY+16,16649,7,OP_OPAQUE);
								EZB_Waitframe(this, ghost, vars);
							}
							for(i4=0; i4<dragonDelay1; ++i4){
								FastCombo(2,0,leftDragonY-16,16640,7,OP_OPAQUE);
								FastCombo(2,16,leftDragonY-16,16641,7,OP_OPAQUE);
								FastCombo(2,0,leftDragonY,16644,7,OP_OPAQUE);
								FastCombo(2,16,leftDragonY,16645,7,OP_OPAQUE);
								FastCombo(2,0,leftDragonY+16,16648,7,OP_OPAQUE);
								FastCombo(2,16,leftDragonY+16,16649,7,OP_OPAQUE);
								EZB_Waitframe(this, ghost, vars);
							} 
							for(i4=0; i4<=dragonDelay2+lasFrames; ++i4){
								FastCombo(2,0,leftDragonY-16,16642,7,OP_OPAQUE);
								FastCombo(2,16,leftDragonY-16,16643,7,OP_OPAQUE);
								FastCombo(2,0,leftDragonY,16646,7,OP_OPAQUE);
								FastCombo(2,16,leftDragonY,16647,7,OP_OPAQUE);
								FastCombo(2,0,leftDragonY+16,16650,7,OP_OPAQUE);
								FastCombo(2,16,leftDragonY+16,16651,7,OP_OPAQUE);
								if(i4==dragonDelay2+1){
									Game->PlaySound(78);
									Screen->Quake = 16;
									RunFFCScript(56, argsg);
									if(phase==1){
										for(i5=-2; i5<=2; ++i5){
											EZB_Fire(this, ghost, vars, 24, leftDragonY+8,28*i5, 450);
										}
									}
									else if(phase>=2){
										for(i5=-2; i5<=2; ++i5){
											EZB_Fire(this, ghost, vars, 24, leftDragonY+8,22*i5, 500);
										}
									}
								}
								if(i4>dragonDelay2){
									EZB_DoLaser(LAYER_EZB_LASER, 24, leftDragonY+8, 8, 0, ghost->WeaponDamage, laserColors, -1, 1, i4-dragonDelay2, lasFrames);
								}
								EZB_Waitframe(this, ghost, vars);
							}
							for(i4=0; i4<=8; ++i4){
								FastCombo(2,0-i4*4,leftDragonY-16,16640,7,OP_OPAQUE);
								FastCombo(2,16-i4*4,leftDragonY-16,16641,7,OP_OPAQUE);
								FastCombo(2,0-i4*4,leftDragonY,16644,7,OP_OPAQUE);
								FastCombo(2,16-i4*4,leftDragonY,16645,7,OP_OPAQUE);
								FastCombo(2,0-i4*4,leftDragonY+16,16648,7,OP_OPAQUE);
								FastCombo(2,16-i4*4,leftDragonY+16,16649,7,OP_OPAQUE);
								EZB_Waitframe(this, ghost, vars);
							}
							rightDragonY = Rand(40,140);
							while(Abs(rightDragonY-leftDragonY)<=32){
								rightDragonY = Rand(40,144);
							}
							Game->PlaySound(8);Screen->Quake = 16;
							//Right Dragon moves
							for(i4=0; i4<8; ++i4){
								FastCombo(2,256-i4*4,rightDragonY-16,16628,7,OP_OPAQUE);
								FastCombo(2,272-i4*4,rightDragonY-16,16629,7,OP_OPAQUE);
								FastCombo(2,256-i4*4,rightDragonY,16632,7,OP_OPAQUE);
								FastCombo(2,272-i4*4,rightDragonY,16633,7,OP_OPAQUE);
								FastCombo(2,256-i4*4,rightDragonY+16,16636,7,OP_OPAQUE);
								FastCombo(2,272-i4*4,rightDragonY+16,16637,7,OP_OPAQUE);
								EZB_Waitframe(this, ghost, vars);
							}
							for(i4=0; i4<dragonDelay1; ++i4){
								FastCombo(2,224,rightDragonY-16,16628,7,OP_OPAQUE);
								FastCombo(2,240,rightDragonY-16,16629,7,OP_OPAQUE);
								FastCombo(2,224,rightDragonY,16632,7,OP_OPAQUE);
								FastCombo(2,240,rightDragonY,16633,7,OP_OPAQUE);
								FastCombo(2,224,rightDragonY+16,16636,7,OP_OPAQUE);
								FastCombo(2,240,rightDragonY+16,16637,7,OP_OPAQUE);
								EZB_Waitframe(this, ghost, vars);
							} 
							for(i4=0; i4<=dragonDelay2+lasFrames; ++i4){
								FastCombo(2,224,rightDragonY-16,16630,7,OP_OPAQUE);
								FastCombo(2,240,rightDragonY-16,16631,7,OP_OPAQUE);
								FastCombo(2,224,rightDragonY,16634,7,OP_OPAQUE);
								FastCombo(2,240,rightDragonY,16635,7,OP_OPAQUE);
								FastCombo(2,224,rightDragonY+16,16638,7,OP_OPAQUE);
								FastCombo(2,240,rightDragonY+16,16639,7,OP_OPAQUE);
								if(i4==dragonDelay2+1){
									Game->PlaySound(78);
									Screen->Quake = 16;
									RunFFCScript(56, argsg);
									if(phase==1){
										for(i5=-2; i5<=2; ++i5){
											EZB_Fire(this, ghost, vars, 224, rightDragonY+8,180+28*i5, 450);
										}
									}
									else if(phase>=2){
										for(i5=-2; i5<=2; ++i5){
											EZB_Fire(this, ghost, vars, 224, rightDragonY+8,180+22*i5, 500);
										}
									}
								}
								if(i4>dragonDelay2){
									EZB_DoLaser(LAYER_EZB_LASER, 224, rightDragonY+8, 8, 180, ghost->WeaponDamage, laserColors, -1, 1, i4-dragonDelay2, lasFrames);
								}
								EZB_Waitframe(this, ghost, vars);
							}
							for(i4=0; i4<=8; ++i4){
								FastCombo(2,224+i4*4,rightDragonY-16,16628,7,OP_OPAQUE);
								FastCombo(2,240+i4*4,rightDragonY-16,16629,7,OP_OPAQUE);
								FastCombo(2,224+i4*4,rightDragonY,16632,7,OP_OPAQUE);
								FastCombo(2,240+i4*4,rightDragonY,16633,7,OP_OPAQUE);
								FastCombo(2,224+i4*4,rightDragonY+16,16636,7,OP_OPAQUE);
								FastCombo(2,240+i4*4,rightDragonY+16,16637,7,OP_OPAQUE);
								EZB_Waitframe(this, ghost, vars);
							}
						}
						//Fly Back
						EZB_Waitframes(this, ghost, vars, 30);
						Game->PlaySound(97);
						Ghost_X = 112;
						Ghost_Y = -32;
						Ghost_Data = combo+3;
						restoreInDefenses(this, ghost, vars, 1);
						for(i3=0; i3<26; ++i3){
							Ghost_Y += 4;
							EZB_Waitframe(this, ghost, vars);
						}
						Ghost_Data = combo+4;
						EZB_Waitframes(this, ghost, vars, 4);
						Ghost_Z = 8;
						Ghost_SetFlag(GHF_NO_FALL);
						
					}
					if(atkType == 4){ //Countdown Blast (40%)
						int countdownTime = 44;
						Game->PlaySound(70);
						Ghost_Data = combo+2;
						EZB_Waitframes(this, ghost, vars, 30);
						Game->PlaySound(95);
						RunFFCScript(56, argss);
						for(i=0; i<50; ++i){
							FastCombo(3,CenterX(ghost)-16-8,CenterY(ghost)-16,16656,10,OP_OPAQUE);
							FastCombo(3,CenterX(ghost)-8,CenterY(ghost)-16,16657,10,OP_OPAQUE);
							FastCombo(3,CenterX(ghost)+16-8,CenterY(ghost)-16,16658,10,OP_OPAQUE);
							FastCombo(3,CenterX(ghost)-16-8,CenterY(ghost),16660,10,OP_OPAQUE);
							FastCombo(3,CenterX(ghost)-8,CenterY(ghost),16661,10,OP_OPAQUE);
							FastCombo(3,CenterX(ghost)+16-8,CenterY(ghost),16662,10,OP_OPAQUE);
							FastCombo(3,CenterX(ghost)-16-8,CenterY(ghost)+16,16664,10,OP_OPAQUE);
							FastCombo(3,CenterX(ghost)-8,CenterY(ghost)+16,16665,10,OP_OPAQUE);
							FastCombo(3,CenterX(ghost)+16-8,CenterY(ghost)+16,16666,10,OP_OPAQUE);
							if(i>=30){
