									FastCombo(1,184,80,4734,8,OP_OPAQUE);
								}
								else if(rand==2){
									FastCombo(1,56,56,4734,8,OP_OPAQUE);
									FastCombo(1,184,104,4734,8,OP_OPAQUE);
								}
								else{
									FastCombo(1,48,80,4734,8,OP_OPAQUE);
									FastCombo(1,192,80,4734,8,OP_OPAQUE);
