					for(i=0; i<30; ++i){
						EZB_DrawSword(this, ghost, vars, CenterX(ghost)-8, CenterY(ghost)-8, angle, angle, arr1[0], ghost->WeaponDamage);
						EZB_Waitframe(this, ghost, vars);
