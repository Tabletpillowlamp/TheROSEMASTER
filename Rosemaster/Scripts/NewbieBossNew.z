								CreateNPCAt(464,184,104); CreateNPCAt(227,56,56);
							}
							else{ //Satellite Dish
								CreateNPCAt(421,48,80); CreateNPCAt(466,192,80);
							}
							break;
					}
					EZB_Waitframes(this, ghost, vars, 10);
