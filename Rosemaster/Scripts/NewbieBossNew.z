									}
									else{
										Ghost_Data = combo + 1;
									}
								}
								if(i == 75 || i == 130 || i == 185){Game->PlaySound(5);}
								//Countdown
								if(i >=20 && i < 75){
									Screen->DrawString(2, CenterX(ghost), CenterY(ghost)-32, 69, 0x88, -1, TF_CENTERED, "4", OP_OPAQUE, SHD_SHADOWED, 0x0F);
								}
								if(i >=75 && i < 130){
									Screen->DrawString(2, CenterX(ghost), CenterY(ghost)-32, 69, 0x88, -1, TF_CENTERED, "3", OP_OPAQUE, SHD_SHADOWED, 0x0F);
								}
								if(i >=130 && i < 185){
									Screen->DrawString(2, CenterX(ghost), CenterY(ghost)-32, 69, 0x88, -1, TF_CENTERED, "2", OP_OPAQUE, SHD_SHADOWED, 0x0F);
								}
								if(i >=185 && i < 240){
									Screen->DrawString(2, CenterX(ghost), CenterY(ghost)-32, 69, 0x84, -1, TF_CENTERED, "1", OP_OPAQUE, SHD_SHADOWED, 0x0F);
								}
								//====================
								if(i == 240){
									Link->Action=LA_NONE;
									Game->PlaySound(124);
									RunFFCScript(56, {19, 40, 0});
								}
								if(i >= 240 && i < 380){
									NoAction();
								}
								if(i == 310){
									Game->PlaySound(124);
									RunFFCScript(56, {19, 40, 0});
									Ghost_HP = curHP;
								}
								if(i == 380){
									if(special > 0){
										Ghost_Data = combo + 4;
									}
									else{
										Ghost_Data = combo;
									}
								}
								sprintf(ghostDisHP,"%d",Ghost_HP);
								Screen->DrawString(2, CenterX(ghost), CenterY(ghost)+20, 69, 0x01, -1, TF_CENTERED, ghostDisHP, OP_OPAQUE, SHD_SHADOWED, 0x0F);
								EZB_Waitframe(this, ghost, vars);
							}
						}
						//====================
						if(special == 0 || Ghost_Data >= combo + 4){
							sprintf(ghostDisHP,"%d",Ghost_HP);
							Screen->DrawString(2, CenterX(ghost), CenterY(ghost)+20, 69, 0x01, -1, TF_CENTERED, ghostDisHP, OP_OPAQUE, SHD_SHADOWED, 0x0F);
						}
						EZB_Waitframe(this, ghost, vars);
					}
				}
				if(attack==349){ //Scindo
					EZB_Waitframes(this, ghost, vars, 60);
					int dmgT1 = 750; int dmgT2 = 550; int dmgT3 = 200;
					int newX; int newY; int rangeLim = 64;
					int rangeMinX = 32; int rangeMinY = 8;
					int limitMin = 16; int limitMaxX = 224; int limitMaxY = 144;
					int rangeCheckX; int rangeCheckY; int angle2;
					i2 = Rand(4,6); i3 = 50; i4 = 70; k = 0;
					//Phase 1
					while(ghost->HP > dmgT2){
						for(j=0; j<i2; ++j){
							//Set up move position
							newX = Rand(CenterX(ghost) - rangeLim,CenterX(ghost) + rangeLim);
							newY = Rand(CenterY(ghost) - rangeLim,CenterY(ghost) + rangeLim);
							rangeCheckX = Abs(newX - CenterX(ghost));
							rangeCheckY = Abs(newY - CenterY(ghost));
							while(
							newX<limitMin||newY<limitMin||newX>limitMaxX||newY>limitMaxY||
							rangeCheckX<rangeMinX||rangeCheckY<rangeMinY
							){
								newX = Rand(CenterX(ghost) - rangeLim,CenterX(ghost) + rangeLim);
								newY = Rand(CenterY(ghost) - rangeLim,CenterY(ghost) + rangeLim);
								rangeCheckX = Abs(newX - CenterX(ghost));
								rangeCheckY = Abs(newY - CenterY(ghost));
							}
							//Shoot
							angle2 = Angle(CenterX(ghost), CenterY(ghost), CenterLinkX(), CenterLinkY());
							e = EZB_Fire(this, ghost, vars, CenterX(ghost)-8, CenterY(ghost)-8, angle2, 350);
							SetEWeaponMovement(e, EWM_SINE_WAVE, 24, 6);
							e = EZB_Fire(this, ghost, vars, CenterX(ghost)-8, CenterY(ghost)-8, angle2, 350);
							SetEWeaponMovement(e, EWM_SINE_WAVE, -24, 6);
							//Move
							angle = Angle(CenterX(ghost), CenterY(ghost), newX, newY);
							while((CenterX(ghost)<(newX-4)) || (CenterX(ghost)>(newX+4)) || (CenterY(ghost)<(newY-4)) || (CenterY(ghost)>(newY+4))){
								EZB_Trail(this, ghost, vars);
								angle = Angle(CenterX(ghost), CenterY(ghost), newX, newY);
								Ghost_MoveAtAngle(angle, 4.5, 1);
								EZB_FaceLink(this, ghost, vars);
								EZB_Waitframe(this, ghost, vars);
							}
							EZB_Waitframes(this, ghost, vars, Rand(i3,i4));
						}
						//Shoot faster after certain HP
						if(ghost->HP <= dmgT1){i2 = Rand(6,8); i3 = 35; i4 = 55;}
						else{i2 = Rand(4,6);}
						//Preparing to Shoot
						EZB_Waitframes(this, ghost, vars, 50);
						Game->PlaySound(94);
						Ghost_Data = combo + 1;
						EZB_Waitframes(this, ghost, vars, 12);
						Ghost_Data = combo + 2;
						//Set DEFENSES
						ghost->Defense[NPCD_BOMB] = NPCDT_NONE;
						ghost->Defense[NPCD_SBOMB] = NPCDT_NONE;
						ghost->Defense[NPCD_ARROW] = NPCDT_HALFDAMAGE;
						ghost->Defense[NPCD_FIRE] = NPCDT_NONE;
						ghost->Defense[NPCD_MAGIC] = NPCDT_NONE;
						ghost->Defense[NPCD_HAMMER] = NPCDT_HALFDAMAGE;
						ghost->Defense[NPCD_SWORD] = NPCDT_NONE;
						ghost->Defense[NPCD_BEAM] = NPCDT_QUARTERDAMAGE;
						ghost->Defense[NPCD_BYRNA] = NPCDT_NONE;
						ghost->Defense[21] = NPCDT_HALFDAMAGE;	//Gun
						ghost->Defense[22] = NPCDT_NONE;	//Portal Beam
						ghost->Defense[25] = NPCDT_HALFDAMAGE;	//Forest Bat
						//============
						EZB_Waitframes(this, ghost, vars, 50);
						Game->PlaySound(70); RunFFCScript(56, {9,40,0});
						Ghost_Data = combo + 3;
						EZB_Waitframes(this, ghost, vars, 50);
						if(ghost->HP <= dmgT1 && k == 0){ //MP Drain
