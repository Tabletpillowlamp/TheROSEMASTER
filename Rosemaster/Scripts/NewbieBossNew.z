				if(attack==329){ //Lotz Podcast Attack
					/* 	D[3]: First String Played
						D[5]: Messages Played
						D[4]: 1 = String 1		2 = String 2
						D[4]: 4 = String 1		8 = String 2
						D[4]: 16 = String 1		32 = String 2
						D[4]: 64 = String 1		128 = String 2
						D[4]: 256 = String 1		*/
					int lStr = 7700;
					int strSet = 0;
					int randString = 0;
					if(Screen->D[3] != 0){
						//Rolling Random Message
						while(strSet == 0){
							randString = Rand(1,9);
							switch(randString){
								case 1:
									if(!(Screen->D[4]&1)){Screen->D[4]|=1;strSet=1;}
									break;
								case 2:
									if(!(Screen->D[4]&2)){Screen->D[4]|=2;strSet=1;}
									break;
								case 3:
									if(!(Screen->D[4]&4)){Screen->D[4]|=4;strSet=1;}
									break;
								case 4:
									if(!(Screen->D[4]&8)){Screen->D[4]|=8;strSet=1;}
									break;
								case 5:
									if(!(Screen->D[4]&16)){Screen->D[4]|=16;strSet=1;}
									break;
								case 6:
									if(!(Screen->D[4]&32)){Screen->D[4]|=32;strSet=1;}
									break;
								case 7:
									if(!(Screen->D[4]&64)){Screen->D[4]|=64;strSet=1;}
									break;
								case 8:
									if(!(Screen->D[4]&128)){Screen->D[4]|=128;strSet=1;}
									break;
								case 9:
									if(!(Screen->D[4]&256)){Screen->D[4]|=256;strSet=1;}
									break;
							}
							//Random Message End
						}
						Screen->D[5] += 1;
					}
					if(Screen->D[5] >= 9){
						Screen->D[4] = 0;
						Screen->D[5] = 0;
