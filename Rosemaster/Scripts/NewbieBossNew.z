						}
						EZB_Waitframes(this, ghost, vars, 20);
						Ghost_Data = combo;
						EZB_Waitframes(this, ghost, vars, 20);
					}
					Ghost_Data = combo;
					EZB_Waitframes(this, ghost, vars, 10);
				}
				if(attack==348){ //Numbers
					int curHP = 333;
					if(special == 2){curHP = 666;}
					else if(special == 1){curHP = 420;}
					Ghost_HP = curHP;
					int ghostDisHP[256];
					
					while(true){
						if(special > 0){
							i2 = 0; i3 = 0;
							//Search to see if Numbers 1 exists.
							for(int i=Screen->NumNPCs(); i>=1; i--){ //Numbers 2
								npc n = Screen->LoadNPC(i);
								if(n->ID==480){
									i2=1;
								}
								if(n->ID==481&&special>1){ //Numbers 3
									i3=1;
								}
							}
							if(i2 == 0 && i3 == 0 && Ghost_Data == combo){
								Ghost_Data = combo + 4;
							}
						}
						if(Ghost_HP != curHP){
							//Fate Worse than Death
							if(special > 0 && Ghost_Data < combo + 4){
								Ghost_Data = combo + 1;
								Game->PlaySound(35);
								EZB_Waitframes(this, ghost, vars, 60);
