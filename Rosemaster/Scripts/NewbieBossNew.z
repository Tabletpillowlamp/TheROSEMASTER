								CreateNPCAt(363,64,112); CreateNPCAt(313,176,112);
							}
							break;
						case 2: //Normal
							for(i=0; i<60; ++i){
								if(rand == 1){
									FastCombo(1,56,48,4734,8,OP_OPAQUE);
									FastCombo(1,184,48,4734,8,OP_OPAQUE);
									FastCombo(1,120,120,4734,8,OP_OPAQUE);
									FastCombo(1,120,80,4734,8,OP_OPAQUE);
								}
								else if(rand==2){
									FastCombo(1,120,48,4734,8,OP_OPAQUE);
									FastCombo(1,120,112,4734,8,OP_OPAQUE);
									FastCombo(1,80,80,4734,8,OP_OPAQUE);
									FastCombo(1,160,80,4734,8,OP_OPAQUE);
								}
								else{
									FastCombo(1,56,80,4734,8,OP_OPAQUE);
									FastCombo(1,184,80,4734,8,OP_OPAQUE);
								}
