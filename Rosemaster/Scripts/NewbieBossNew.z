					angle = Angle(CenterX(ghost), CenterY(ghost), CenterLinkX(), CenterLinkY());
					
					arr1[0] = 16+(Max(w, h)-1)*8; //Total reach of sword
					arr1[1] = Max(w, h)*8; //Starting reach of sword
					arr1[2] = arr1[0]-arr1[1]; //Ending reach of sword
					
					m = -1;
