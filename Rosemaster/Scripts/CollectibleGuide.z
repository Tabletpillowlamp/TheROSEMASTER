					Game->PlaySound(5);
					lastCurPos = this->Data[curPos];
				}
			}
			
			// Toggle Hint
			if(Link->PressA){
				Game->PlaySound(91);
				if(this->Data[hintToggle] == 0){
					this->Data[hintToggle] = 1;
				}
				else{
					this->Data[hintToggle] = 0;
				}
			}
			
			// Cancel
			if(Link->PressB){
				Game->PlaySound(94);
				break;
			}
			
			// ====================
			
			Waitframe();
			
		}
		
	}
