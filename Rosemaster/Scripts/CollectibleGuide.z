	bool checkBT(int type){ // Bottle Check
		switch(type){
			case 1: // Bottle 1
				return true;
				break;
			case 2: // Bottle 2
				if(Game->GetDMapScreenD(335, 0x13, 5) & 1){return true;}
				break;
			case 3: // Bottle 3
				if(Game->GetDMapScreenD(72, 0x33, 5) & 32){return true;}
				break;
			case 4: // Bottle 4
				if(Game->GetDMapScreenD(107, 0x34, 5) & 1 || Game->GetDMapScreenD(6, 0x22, 5) & 1){return true;}
				break;
			
		}
		return false;
	}
	
	
