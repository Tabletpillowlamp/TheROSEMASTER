					md02->Set("This isn't Elignita, just one happy nation called Hyrule.");
					md03->Y = 120; md03->Next = 0;
					md03->Set("A happy family lives just north of here, want to take a look?");
					break;
				case 26: // Ramiel 3-3
					md01->Y = 130; md01->Next = 7902;
					char32 str01[1000];
					sprintf(str01, "That's right, Aurelia is there with her father... %cand mother...",sc(30));
					md01->Set(str01);
					if(Link->Item[180]){
						md02->Y = 130; md02->Next = 7903;
						char32 str02[1000];
						sprintf(str02, "This is the same girl who chose to live in this world. %cShe is doing just fine here.",sc(30));
						md02->Set(str02);
						md03->Y = 130; md03->Next = 7904;
						char32 str03[1000];
						sprintf(str03, "Normally, we'd prevent her from doing that. %cBut the %c%c%cLord Creator%c%c%c himself decided to let this slide.",sc(30),sc(1),sc(8),sc(8),sc(1),sc(0),sc(1));
						md03->Set(str03);
					}
					else{
						md02->Y = 130; md02->Next = 7903;
						char32 str02[1000];
						sprintf(str02, "She's not the same girl like the one in your universe. %cShe is much more carefree and happy.",sc(30));
						md02->Set(str02);
						md03->Y = 130; md03->Next = 7904;
						char32 str03[1000];
						sprintf(str03, "There was no need for her to train with the spear and become a warrior. %cShe's just a child...",sc(30));
						md03->Set(str03);
					}
					md04->Y = 130; md04->Next = 7905;
					md04->Set("Let me tell you an important fact about hopping into another universe.");
					md05->Y = 130; md05->Next = 7906;
					md05->Set("If one were to stay in a new universe, their memory will be readjusted.");
					md06->Y = 130; md06->Next = 7907;
					md06->Set("You will have such experience when you get back to your own world.");
					md07->Y = 130; md07->Next = 0;
					md07->Set("Now then, gaze upon this happy family from a distance...");
					break;
				case 27: // Ramiel 3-4
					md01->Y = 120; md01->Next = 7902;
					char32 str01[1000];
					sprintf(str01, "So sorry to interrupt this. %cBut this is not your universe.",sc(30));
					md01->Set(str01);
					md02->Y = 120; md02->Next = 7903;
					char32 str02[1000];
					sprintf(str02, "Having you interact with that girl would cause godly chaos. %cYou two were never meant to meet.",sc(30));
					md02->Set(str02);
					md03->Y = 120; md03->Next = 7904;
					char32 str03[1000];
					sprintf(str03, "You may think I am pulling a cruel trick on you. %cBut God has guided me to do this.",sc(30));
					md03->Set(str03);
					md04->Y = 120; md04->Next = 0;
					md04->Set("This is all part of the process to let you know the truth before sending you back home...");
					break;
				case 28: // Ramiel 4-1
					md01->Y = 120; md01->Next = 7902;
					md01->Set("The third universe we are about to enter is one that gives off nostalgic energy.");
					md02->Y = 120; md02->Next = 7903;
					char32 str02[1000];
					sprintf(str02, "You remember Hinnow Village, right? %cWell, it's a very old place, over 100 years old.",sc(30));
					md02->Set(str02);
					md03->Y = 120; md03->Next = 7904;
					md03->Set("We will be travelling back in time where this budding town was a simple place.");
					md04->Y = 120; md04->Next = 7905;
					md04->Set("But nevertheless, the place where one of the greatest heroes lived and overcame evil.");
					md05->Y = 120; md05->Next = 0;
					md05->Set("Let me show you what this place used to look like.");
					break;
				case 29: // Ramiel 4-2
					md01->Y = 10; md01->Next = 7902;
					char32 str01[1000];
					sprintf(str01, "Ah, isn't this place beautiful? %cThe town may have eight less bits, but look at the scenery.",sc(30));
					md01->Set(str01);
					md02->Y = 10; md02->Next = 7903;
					char32 str02[1000];
					sprintf(str02, "Hmm, I see that the hero is out adventuring. %cBut at least you get to see his house right here.",sc(30));
					md02->Set(str02);
					md03->Y = 10; md03->Next = 7904;
					md03->Set("That's right, his name was also Link. The difference is that he is in the right universe.");
					md04->Y = 10; md04->Next = 7905;
					char32 str04[1000];
					sprintf(str04, "In this universe, he and his friend, %c%c%cAurullia%c%c%c, were destined to defeat the evil %c%c%cGlory Squad%c%c%c.",sc(1),sc(8),sc(3),sc(1),sc(0),sc(1),sc(1),sc(7),sc(8),sc(1),sc(0),sc(1));
					md04->Set(str04);
					md05->Y = 10; md05->Next = 0;
					char32 str05[1000];
					sprintf(str05, "He was all good, just like you. %cAnd like him, you are destined for something similar back home.",sc(30));
					md05->Set(str05);
					break;
				case 30: // Ramiel 4-3
					md01->Y = 10; md01->Next = 7902;
					char32 str01[1000];
					sprintf(str01, "Once you know your true destiny, you will finally reach fulfillment. %cYou must experience that.",sc(30));
					md01->Set(str01);
					md02->Y = 10; md02->Next = 7903;
					char32 str02[1000];
					sprintf(str02, "Since there is not much else here, let's go back. %cI have one more universe to share with you.",sc(30));
					md02->Set(str02);
					md03->Y = 10; md03->Next = 0;
					md03->Set("And then, it will finally be time to go back to your universe.");
					break;
				case 31: // Ramiel 5-1
					md01->Y = 120; md01->Next = 7902;
					md01->Set("The fourth universe we'll visit is very well known within a particular group of people.");
					md02->Y = 120; md02->Next = 7903;
					char32 str02[1000];
					sprintf(str02, "We are going into the world of the highest rated quest on the %c%c%cPureZC Website%c%c%c.",sc(1),sc(8),sc(8),sc(1),sc(0),sc(1));
					md02->Set(str02);
					md03->Y = 120; md03->Next = 7904;
					md03->Set("What's that you ask? PureZC? It's a place where only the highest quality worlds live.");
					md04->Y = 120; md04->Next = 0;
					char32 str04[1000];
					sprintf(str04, "And here, I will show you the absolute best of the best. %Please follow me.",sc(30));
					md04->Set(str04);
					break;
				case 32: // Ramiel 5-2
					md01->Y = 120; md01->Next = 7902;
					md01->Set("Welcome to the world of Mario Quest. The best quest on PureZC.");
					md02->Y = 120; md02->Next = 0;
					char32 str02[1000];
					sprintf(str02, "Look how colorful everything is! %cDon't you want to give this quest an instant %c%c%cfive stars%c%c%c!?",sc(30),sc(1),sc(8),sc(8),sc(1),sc(0),sc(1));
					md02->Set(str02);
					break;
				case 33: // Ramiel 5-3
					md01->Y = 120; md01->Next = 7902;
					char32 str01[1000];
					sprintf(str01, "Huh? You say that he's stuck? %cIf you complained about that, it's perhaps a skill issue.",sc(30));
					md01->Set(str01);
					md02->Y = 120; md02->Next = 0;
					md02->Set("But fine, let's free Mario from being trapped in that hill.");
					break;
				case 34: // Ramiel 5-4
					md01->Y = 120; md01->Next = 7902;
					md01->Set("He didn't even give me a thank you, huh? ...");
					md02->Y = 120; md02->Next = 7903;
					md02->Set("Anyways, I should probably explain to you why you were sent here.");
					md03->Y = 120; md03->Next = 7904;
					md03->Set("This universe, just like the one you were currently living in, is called a 'fanmade' universe.");
					md04->Y = 120; md04->Next = 7905;
					md04->Set("Here, there is no concept of 'canonicity'. No matter the quality, less people will know your works.");
					md05->Y = 120; md05->Next = 7906;
					char32 str05[1000];
					sprintf(str05, "And most importantly, these worlds lack something called 'profit'. %cIt's just simply not sustainable.",sc(30));
					md05->Set(str05);
					md06->Y = 120; md06->Next = 7907;
					md06->Set("Link, the world you were meant to be in is not 'fanmade'. It's real, and it serves a greater purpose.");
					md07->Y = 120; md07->Next = 7908;
					md07->Set("You were meant to be a 'profit' maker, Link. Being in Elignita won't do such a thing.");
					md08->Y = 120; md08->Next = 0;
					md08->Set("Now that you know the truth. It's finally time for you to go back home.");
					break;
				case 35: // Ramiel 6-1
					md01->Y = 120; md01->Next = 0;
					md01->Set("Up ahead is your home universe. It's time, let's go.");
					break;
				case 36: // Ramiel 6-2
					md01 = Game->LoadMessageData(7990);
					md01->Y = 120; md01->Next = 7902;
					char32 str01[1000];
					sprintf(str01, "%c%c%c%c%c%c%c          No...%c%c  he cannot go just yet... %c%c   he must be cleansed...",sc(21),sc(138),sc(2),sc(0),sc(1),sc(7),sc(12),sc(30),sc(25),sc(30),sc(25));
					md01->Set(str01);
					md02->Y = 120; md02->Next = 7903;
					char32 str02[1000];
					sprintf(str02, "... ... ... ... %c%cThat is correct. Link...%c%cWe must cleanse you first.",sc(30),sc(25),sc(30),sc(25));
					md02->Set(str02);
					md03->Y = 120; md03->Next = 7904;
					char32 str03[1000];
					sprintf(str03, "You have become such a big changing force in this universe. %cThe memories you've built...",sc(30));
					md03->Set(str03);
					md04->Y = 120; md04->Next = 7991;
					md04->Set("Before you go, we have to cleanse you of all your memories of the friends you've made.");
					md05 = Game->LoadMessageData(7991);
					md05->Y = 120; md05->Next = 0;
					char32 str05[1000];
					sprintf(str05, "%c%c%c%c%c The Cleansing ritual will%c be the hardest test you%cwill face. prepare yourself.",sc(2),sc(0),sc(1),sc(7),sc(12),sc(25),sc(25));
					md05->Set(str05);
					break;
				case 37: // Ramiel 6-3
					md01->Y = 120; md01->Next = 7902;
					md01->Set("You must do one final battle against me in order to cleanse your memories.");
					md02->Y = 120; md02->Next = 7903;
					md02->Set("It's to let off all your powers at once, that will make easier for God to safely readjust you...");
					md03->Y = 120; md03->Next = 7904;
					md03->Set("Since you have done so much in this universe. This battle will be harder than ever.");
					md04->Y = 120; md04->Next = 7905;
					char32 str04[1000];
					sprintf(str04, "But trust in yourself, I know you can do it. %cFirst, head south to open a shortcut here.",sc(30));
					md04->Set(str04);
					md05->Y = 120; md05->Next = 0;
					md05->Set("Then, when you're ready. Head up and we will begin our cleansing ritual.");
					break;
				case 38: // 
					
					break;
				case 39: // 
					
					break;
				case 40: // 
					
					break;
				case 41: // 
					
					break;
				case 42: // 
					
					break;
			}
			//New message
			if(id != 36){
				Screen->Message(7901);	
			}
			else{
				Screen->Message(7990);
			}
		}
		
	}
	
	int sc (int value){
		return value + 1;
	}
	
