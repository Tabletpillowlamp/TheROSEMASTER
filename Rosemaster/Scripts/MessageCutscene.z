//136,152
//144
ffc script MessageCutscene{
    void run(int type, int x1, int x2, int vert){
		while(true){
			while((((Link->X>=x1)&&(Link->X<x2))&&vert==0)||(((Link->Y>=x1)&&(Link->Y<x2))&&vert==1)){
				switch(type){
					case 0:
						Screen->DrawString(6, 8, 128, 69, 0xA9, -1, 0, "My story with you began when I got ", OP_OPAQUE);
						Screen->DrawString(6, 8, 136, 69, 0xA9, -1, 0, "promoted to Sheikah Chief. I", OP_OPAQUE);
						Screen->DrawString(6, 8, 144, 69, 0xA9, -1, 0, "learned many skills from our tribe's", OP_OPAQUE);
						Screen->DrawString(6, 8, 152, 69, 0xA9, -1, 0, "former leader, Impa.", OP_OPAQUE);
						break;
					case 1:
						Screen->DrawString(6, 8, 128, 69, 0xA9, -1, 0, "That was when I was tasked to protect", OP_OPAQUE);
						Screen->DrawString(6, 8, 136, 69, 0xA9, -1, 0, "you, Cain. You were destined to be", OP_OPAQUE);
						Screen->DrawString(6, 8, 144, 69, 0xA9, -1, 0, "the Hero of Courage. And my job was to", OP_OPAQUE);
						Screen->DrawString(6, 8, 152, 69, 0xA9, -1, 0, "keep our nation's tradition.", OP_OPAQUE);
						break;
					case 2:
						Screen->DrawString(6, 8, 128, 69, 0xA9, -1, 0, "As the Hero, you were destined to", OP_OPAQUE);
						Screen->DrawString(6, 8, 136, 69, 0xA9, -1, 0, "save our Kingdom from all types of evil.", OP_OPAQUE);
						Screen->DrawString(6, 8, 144, 69, 0xA9, -1, 0, "I mobilized the Hyrulean Army to", OP_OPAQUE);
						Screen->DrawString(6, 8, 152, 69, 0xA9, -1, 0, "prepare you for battle.", OP_OPAQUE);
						break;
					case 3:
						Screen->DrawString(6, 8, 128, 69, 0xA9, -1, 0, "But you had different ideas...", OP_OPAQUE);
						Screen->DrawString(6, 8, 140, 69, 0xA9, -1, 0, "You wanted peace, not war. You rejected", OP_OPAQUE);
						Screen->DrawString(6, 8, 152, 69, 0xA9, -1, 0, "almost everything I tried to do...", OP_OPAQUE);
						break;
					case 4:
						Screen->DrawString(6, 8, 128, 69, 0xA9, -1, 0, "I increasingly became frustrated,", OP_OPAQUE);
						Screen->DrawString(6, 8, 136, 69, 0xA9, -1, 0, "But that was when I talked to the", OP_OPAQUE);
						Screen->DrawString(6, 8, 144, 69, 0xA9, -1, 0, "Chancellor about the looming threat of", OP_OPAQUE);
						Screen->DrawString(6, 8, 152, 69, 0xA9, -1, 0, "Elignita, our enemy rogue state.", OP_OPAQUE);
						break;
					case 5:
						Screen->DrawString(6, 8, 128, 69, 0xA9, -1, 0, "The rest was history. I used my", OP_OPAQUE);
						Screen->DrawString(6, 8, 136, 69, 0xA9, -1, 0, "secret spell on you, hoping to change", OP_OPAQUE);
						Screen->DrawString(6, 8, 144, 69, 0xA9, -1, 0, "your ideals. But I quickly regretted", OP_OPAQUE);
						Screen->DrawString(6, 8, 152, 69, 0xA9, -1, 0, "my choice...", OP_OPAQUE);
						break;
					case 6:
						Screen->DrawString(6, 8, 128, 69, 0xA9, -1, 0, "I did everything I could to bring", OP_OPAQUE);
						Screen->DrawString(6, 8, 136, 69, 0xA9, -1, 0, "you back to Hyrule and undo my actions.", OP_OPAQUE);
						Screen->DrawString(6, 8, 144, 69, 0xA9, -1, 0, "For I learned that you just wanted", OP_OPAQUE);
						Screen->DrawString(6, 8, 152, 69, 0xA9, -1, 0, "to live your life free from your role.", OP_OPAQUE);
						break;
					case 7:
						Screen->DrawString(6, 8, 128, 69, 0xA9, -1, 0, "There is no cure to my spell...", OP_OPAQUE);
						Screen->DrawString(6, 8, 136, 69, 0xA9, -1, 0, "You must naturally relearn who you are.", OP_OPAQUE);
						Screen->DrawString(6, 8, 144, 69, 0xA9, -1, 0, "Cain, know who you are.", OP_OPAQUE);
						Screen->DrawString(6, 8, 152, 69, 0xA9, -1, 0, "You were a leader... of PEACE!", OP_OPAQUE);
						break;
					//==================================
					case 8:
						Screen->DrawString(6, 8, 128, 69, 0xA9, -1, 0, "My dear son... take on the title", OP_OPAQUE);
						Screen->DrawString(6, 8, 136, 69, 0xA9, -1, 0, "of LEAR VIII, and make Elignita", OP_OPAQUE);
						Screen->DrawString(6, 8, 144, 69, 0xA9, -1, 0, "a nation to be feared! You must", OP_OPAQUE);
						Screen->DrawString(6, 8, 152, 69, 0xA9, -1, 0, "rule with power....", OP_OPAQUE);
						break;
					case 9:
						Screen->DrawString(6, 8, 128, 69, 0x78, -1, 0, "Enough with your nagging!", OP_OPAQUE);
						Screen->DrawString(6, 8, 136, 69, 0x78, -1, 0, "You needed to die a long time ago.", OP_OPAQUE);
						Screen->DrawString(6, 8, 144, 69, 0x78, -1, 0, "I have no plans to rule.", OP_OPAQUE);
						Screen->DrawString(6, 8, 152, 69, 0x78, -1, 0, "I just want to have fun, heh!", OP_OPAQUE);
						break;
					case 10:
						Screen->DrawString(6, 8, 128, 69, 0xA3, -1, 0, "... ... ... You're gone...", OP_OPAQUE);
						Screen->DrawString(6, 8, 136, 69, 0xA3, -1, 0, "I wanted you to see me take over.", OP_OPAQUE);
						Screen->DrawString(6, 8, 144, 69, 0xA3, -1, 0, "But I don't think you even remember me.", OP_OPAQUE);
						Screen->DrawString(6, 8, 152, 69, 0xA3, -1, 0, "Not that I'll miss you...", OP_OPAQUE);
						break;
					case 11:
						Screen->DrawString(6, 8, 136, 69, 0xA3, -1, 0, "Big brother. It's been a while.", OP_OPAQUE);
						Screen->DrawString(6, 8, 144, 69, 0xA3, -1, 0, "Do you remember me?", OP_OPAQUE);
						break;
					case 12:
						Screen->DrawString(6, 8, 128, 69, 0x78, -1, 0, "Remember you-? Oh, you're one", OP_OPAQUE);
						Screen->DrawString(6, 8, 136, 69, 0x78, -1, 0, "of my many worthless sisters.", OP_OPAQUE);
						Screen->DrawString(6, 8, 144, 69, 0x78, -1, 0, "My dad killed you all when you were", OP_OPAQUE);
						Screen->DrawString(6, 8, 152, 69, 0x78, -1, 0, "little! Why are YOU still alive!?", OP_OPAQUE);
						break;
					case 13:
						Screen->DrawString(6, 8, 128, 69, 0xA3, -1, 0, "Our uncle saved me, brother.", OP_OPAQUE);
						Screen->DrawString(6, 8, 136, 69, 0xA3, -1, 0, "Now I'm going to get revenge on dad.", OP_OPAQUE);
						Screen->DrawString(6, 8, 144, 69, 0xA3, -1, 0, "His kingdom shall be mine!", OP_OPAQUE);
						Screen->DrawString(6, 8, 152, 69, 0xA3, -1, 0, "Step down, brother!", OP_OPAQUE);
						break;
					case 14:
						Screen->DrawString(6, 8, 132, 69, 0x78, -1, 0, "You? Saved by that traitor Kalin?", OP_OPAQUE);
						Screen->DrawString(6, 8, 140, 69, 0x78, -1, 0, "You're going to follow his orders?", OP_OPAQUE);
						Screen->DrawString(6, 8, 148, 69, 0x78, -1, 0, "Stupid pathetic worm! I'll crush you!", OP_OPAQUE);
						break;
					case 15:
						Screen->DrawString(6, 8, 128, 69, 0xA3, -1, 0, "Uncle has trained me for this", OP_OPAQUE);
						Screen->DrawString(6, 8, 136, 69, 0xA3, -1, 0, "very moment, I shall create a", OP_OPAQUE);
						Screen->DrawString(6, 8, 144, 69, 0xA3, -1, 0, "revolution today if I need to.", OP_OPAQUE);
						Screen->DrawString(6, 8, 152, 69, 0xA3, -1, 0, "Have at you, brother!", OP_OPAQUE);
						break;
					case 16:
						Screen->DrawString(6, 8, 132, 69, 0xA3, -1, 0, "Today, Elignita will wake up!", OP_OPAQUE);
						Screen->DrawString(6, 8, 140, 69, 0xA3, -1, 0, "Tsar Lear VIII, you shall be no more!", OP_OPAQUE);
						Screen->DrawString(6, 8, 148, 69, 0xA3, -1, 0, "For I, Ingrid, will take over this nation!", OP_OPAQUE);
						break;
					//==================================
					case 17:
						Screen->DrawString(6, 8, 128, 69, 0x01, -1, 0, "Several months have passed since", OP_OPAQUE);
						Screen->DrawString(6, 8, 136, 69, 0x01, -1, 0, "Tsarina Ingrid took over Elignita.", OP_OPAQUE);
						Screen->DrawString(6, 8, 144, 69, 0x01, -1, 0, "Within the inner chambers of the Capital,", OP_OPAQUE);
						Screen->DrawString(6, 8, 152, 69, 0x01, -1, 0, "two cousins have a deep conversation.", OP_OPAQUE);
						break;
					case 18:
						Screen->DrawString(6, 8, 128, 69, 0xA3, -1, 0, "I've got everything secured. It seems like", OP_OPAQUE);
						Screen->DrawString(6, 8, 136, 69, 0xA3, -1, 0, "most people are fine with me in charge.", OP_OPAQUE);
						Screen->DrawString(6, 8, 144, 69, 0xA3, -1, 0, "Elena, what should be our plan now?", OP_OPAQUE);
						Screen->DrawString(6, 8, 152, 69, 0xA3, -1, 0, "We must do something about Hyrule.", OP_OPAQUE);
						break;
					case 19:
						Screen->DrawString(6, 8, 128, 69, 0x83, -1, 0, "I'm not sure...", OP_OPAQUE);
						Screen->DrawString(6, 8, 136, 69, 0x83, -1, 0, "But about you and Kalin...", OP_OPAQUE);
						Screen->DrawString(6, 8, 144, 69, 0x83, -1, 0, "He wanted you to unite Elignita and the", OP_OPAQUE);
						Screen->DrawString(6, 8, 152, 69, 0x83, -1, 0, "Eastern State to take down Hyrule?", OP_OPAQUE);
						break;
					case 20:
						Screen->DrawString(6, 8, 128, 69, 0xA3, -1, 0, "Yes, that's correct. I've been coming", OP_OPAQUE);
						Screen->DrawString(6, 8, 136, 69, 0xA3, -1, 0, "up with many plans, we even fully seized", OP_OPAQUE);
						Screen->DrawString(6, 8, 144, 69, 0xA3, -1, 0, "the Hyrulean town of Hinnow recently.", OP_OPAQUE);
						Screen->DrawString(6, 8, 152, 69, 0xA3, -1, 0, "I think we'll be ready to take it on!", OP_OPAQUE);
						break;
					case 21:
						Screen->DrawString(6, 8, 128, 69, 0x83, -1, 0, "... ... ... I know...", OP_OPAQUE);
						Screen->DrawString(6, 8, 136, 69, 0x83, -1, 0, "However, when I look at Elignita.", OP_OPAQUE);
						Screen->DrawString(6, 8, 144, 69, 0x83, -1, 0, "I feel like... there are some problems", OP_OPAQUE);
						Screen->DrawString(6, 8, 152, 69, 0x83, -1, 0, "we have to solve interally.", OP_OPAQUE);
						break;
					case 22:
						Screen->DrawString(6, 8, 128, 69, 0x83, -1, 0, "Elignitan people are miserable.", OP_OPAQUE);
						Screen->DrawString(6, 8, 136, 69, 0x83, -1, 0, "Don't you think we ought to take", OP_OPAQUE);
						Screen->DrawString(6, 8, 144, 69, 0x83, -1, 0, "care of them first? You know, before", OP_OPAQUE);
						Screen->DrawString(6, 8, 152, 69, 0x83, -1, 0, "going to war against Hyrule?", OP_OPAQUE);
						break;
					case 23:
						Screen->DrawString(6, 8, 128, 69, 0xA3, -1, 0, "I wish I could do that.", OP_OPAQUE);
						Screen->DrawString(6, 8, 136, 69, 0xA3, -1, 0, "But we don't have much time left before", OP_OPAQUE);
						Screen->DrawString(6, 8, 144, 69, 0xA3, -1, 0, "the ceasefire ends. We must prepare to", OP_OPAQUE);
						Screen->DrawString(6, 8, 152, 69, 0xA3, -1, 0, "fight a war against Hyrule very soon.", OP_OPAQUE);
						break;
					case 24:
						Screen->DrawString(6, 8, 132, 69, 0x83, -1, 0, "I see, in that case, I'm going to leave.", OP_OPAQUE);
						Screen->DrawString(6, 8, 140, 69, 0x83, -1, 0, "Warfare isn't something I can help with.", OP_OPAQUE);
						Screen->DrawString(6, 8, 148, 69, 0x83, -1, 0, "After all, I work to heal others, not harm.", OP_OPAQUE);
						break;
					case 25:
						Screen->DrawString(6, 8, 128, 69, 0x83, -1, 0, "Maybe I'll take a look at Hinnow Village", OP_OPAQUE);
						Screen->DrawString(6, 8, 136, 69, 0x83, -1, 0, "to see if I can help them out.", OP_OPAQUE);
						Screen->DrawString(6, 8, 144, 69, 0x83, -1, 0, "I hope you can change your ways and", OP_OPAQUE);
						Screen->DrawString(6, 8, 152, 69, 0x83, -1, 0, "maybe focus on your own people, too...", OP_OPAQUE);
						break;
					//==================================
					case 26:
						Screen->DrawString(6, 8, 132, 69, 0x13, -1, 0, "You Majesty, we have successfully seized", OP_OPAQUE);
						Screen->DrawString(6, 8, 140, 69, 0x13, -1, 0, "Hinnow Village! All thanks to our great", OP_OPAQUE);
						Screen->DrawString(6, 8, 148, 69, 0x13, -1, 0, "General Lotz Fitzgerald!", OP_OPAQUE);
						break;
					case 27:
						Screen->DrawString(6, 8, 128, 69, 0xA3, -1, 0, "Excellent, I knew I could count on Lotz", OP_OPAQUE);
						Screen->DrawString(6, 8, 136, 69, 0xA3, -1, 0, "to take care of the army.", OP_OPAQUE);
						Screen->DrawString(6, 8, 144, 69, 0xA3, -1, 0, "Now then, how are all our men out there", OP_OPAQUE);
						Screen->DrawString(6, 8, 152, 69, 0xA3, -1, 0, "doing? Any casualties?", OP_OPAQUE);
						break;
					case 28:
						Screen->DrawString(6, 8, 128, 69, 0x13, -1, 0, "From our army? No casualties!", OP_OPAQUE);
						Screen->DrawString(6, 8, 136, 69, 0x13, -1, 0, "According to Lotz, our seige was very", OP_OPAQUE);
						Screen->DrawString(6, 8, 144, 69, 0x13, -1, 0, "humane as well. Speaking of which, he", OP_OPAQUE);
						Screen->DrawString(6, 8, 152, 69, 0x13, -1, 0, "wants to talk to you right now...", OP_OPAQUE);
						break;
					case 29:
						Screen->DrawString(6, 8, 136, 69, 0xA3, -1, 0, "... Right now?", OP_OPAQUE);
						Screen->DrawString(6, 8, 144, 69, 0xA3, -1, 0, "Alright, bring him in.", OP_OPAQUE);
						break;
					case 30:
						Screen->DrawString(6, 8, 128, 69, 0x84, -1, 0, "Welcome, your Majesty! It is I, Lotz!", OP_OPAQUE);
						Screen->DrawString(6, 8, 136, 69, 0x84, -1, 0, "I heard we're about to be in a war", OP_OPAQUE);
						Screen->DrawString(6, 8, 144, 69, 0x84, -1, 0, "with Hyrule very soon. So I'd like to", OP_OPAQUE);
						Screen->DrawString(6, 8, 152, 69, 0x84, -1, 0, "help out, heh heh heh!", OP_OPAQUE);
						break;
					case 31:
						Screen->DrawString(6, 8, 132, 69, 0xA3, -1, 0, "Is that so?", OP_OPAQUE);
						Screen->DrawString(6, 8, 140, 69, 0xA3, -1, 0, "Do you have any ideas on how we", OP_OPAQUE);
						Screen->DrawString(6, 8, 148, 69, 0xA3, -1, 0, "can have an upper edge against Hyrule?", OP_OPAQUE);
						break;
					case 32:
						Screen->DrawString(6, 8, 128, 69, 0x84, -1, 0, "You're talking to not only the strongest", OP_OPAQUE);
						Screen->DrawString(6, 8, 136, 69, 0x84, -1, 0, "man in the world, but also the smartest!", OP_OPAQUE);
						Screen->DrawString(6, 8, 144, 69, 0x84, -1, 0, "Of course I know the perfect plan for", OP_OPAQUE);
						Screen->DrawString(6, 8, 152, 69, 0x84, -1, 0, "Elignita to be the strongest!!", OP_OPAQUE);
						break;
					case 33:
						Screen->DrawString(6, 8, 128, 69, 0x84, -1, 0, "I have a little plan, your Majesty...", OP_OPAQUE);
						Screen->DrawString(6, 8, 136, 69, 0x84, -1, 0, "There's a cool thing out there.", OP_OPAQUE);
						Screen->DrawString(6, 8, 144, 69, 0x84, -1, 0, "It's called the ROSEMASTER.", OP_OPAQUE);
						Screen->DrawString(6, 8, 152, 69, 0x84, -1, 0, "If we can get it... We'll win the war!!", OP_OPAQUE);
						break;
					//==================================
					case 34:
						Screen->DrawString(6, 136, 56, 69, 0x15, -1, 0, "... ... ...", OP_OPAQUE);
						Screen->DrawString(6, 136, 64, 69, 0x15, -1, 0, "I am playing you a", OP_OPAQUE);
						Screen->DrawString(6, 136, 72, 69, 0x15, -1, 0, "song. I call it the", OP_OPAQUE);
						Screen->DrawString(6, 136, 80, 69, 0x15, -1, 0, "SONG OF TIME.", OP_OPAQUE);
						Screen->DrawString(6, 136, 88, 69, 0x15, -1, 0, "This music holds a", OP_OPAQUE);
						Screen->DrawString(6, 136, 96, 69, 0x15, -1, 0, "very special place", OP_OPAQUE);
						Screen->DrawString(6, 136, 104, 69, 0x15, -1, 0, "in my heart...", OP_OPAQUE);
						break;
					case 35:
						Screen->DrawString(6, 136, 56, 69, 0x15, -1, 0, "Heal and Revive.", OP_OPAQUE);
						Screen->DrawString(6, 136, 64, 69, 0x15, -1, 0, "They are actions", OP_OPAQUE);
						Screen->DrawString(6, 136, 72, 69, 0x15, -1, 0, "that are fixed in", OP_OPAQUE);
						Screen->DrawString(6, 136, 80, 69, 0x15, -1, 0, "time. So in essence.", OP_OPAQUE);
						Screen->DrawString(6, 136, 88, 69, 0x15, -1, 0, "Time itself is the", OP_OPAQUE);
						Screen->DrawString(6, 136, 96, 69, 0x15, -1, 0, "ultimate HEALER.", OP_OPAQUE);
						break;
					case 36:
						Screen->DrawString(6, 136, 56, 69, 0x15, -1, 0, "So let me play", OP_OPAQUE);
						Screen->DrawString(6, 136, 64, 69, 0x15, -1, 0, "this song in order", OP_OPAQUE);
						Screen->DrawString(6, 136, 72, 69, 0x15, -1, 0, "to manipulate TIME.", OP_OPAQUE);
						Screen->DrawString(6, 136, 80, 69, 0x15, -1, 0, "For TIME, can", OP_OPAQUE);
						Screen->DrawString(6, 136, 88, 69, 0x15, -1, 0, "HEAL all aliments.", OP_OPAQUE);
						Screen->DrawString(6, 136, 96, 69, 0x15, -1, 0, "Even death...", OP_OPAQUE);
						break;
					case 37:
						Screen->DrawString(6, 136, 56, 69, 0x15, -1, 0, "But as we wander", OP_OPAQUE);
						Screen->DrawString(6, 136, 64, 69, 0x15, -1, 0, "in TIME. Think", OP_OPAQUE);
						Screen->DrawString(6, 136, 72, 69, 0x15, -1, 0, "about your choices.", OP_OPAQUE);
						Screen->DrawString(6, 136, 80, 69, 0x15, -1, 0, "As our actions to", OP_OPAQUE);
						Screen->DrawString(6, 136, 88, 69, 0x15, -1, 0, "overcome it shall", OP_OPAQUE);
						Screen->DrawString(6, 136, 96, 69, 0x15, -1, 0, "not be without a", OP_OPAQUE);
						Screen->DrawString(6, 136, 104, 69, 0x15, -1, 0, "hefty price...", OP_OPAQUE);
						break;
					case 38:
						Screen->DrawString(6, 136, 56, 69, 0x15, -1, 0, "Your mother, and", OP_OPAQUE);
						Screen->DrawString(6, 136, 64, 69, 0x15, -1, 0, "everyone you know", OP_OPAQUE);
						Screen->DrawString(6, 136, 72, 69, 0x15, -1, 0, "and love will be", OP_OPAQUE);
						Screen->DrawString(6, 136, 80, 69, 0x15, -1, 0, "revived. But TIME", OP_OPAQUE);
						Screen->DrawString(6, 136, 88, 69, 0x15, -1, 0, "itself has its own", OP_OPAQUE);
						Screen->DrawString(6, 136, 96, 69, 0x15, -1, 0, "limits on yourself.", OP_OPAQUE);
						break;
					case 39:
						Screen->DrawString(6, 136, 56, 69, 0x15, -1, 0, "Let me show you", OP_OPAQUE);
						Screen->DrawString(6, 136, 64, 69, 0x15, -1, 0, "the path to revive.", OP_OPAQUE);
						break;
				}
				Waitframe();
			}
			Waitframe();
		}
	}
}

ffc script CtsMoveRightOnly
{
    void run(int type)
	{
        while(true){
            Link->InputStart = false; Link->PressStart = false;
            Link->InputMap = false; Link->PressMap = false;
			if(type==0){
				Link->PressLeft = false;
				Link->InputLeft = false;
			}
			else if(type==1){
				Game->SkipF6 = true;
				Link->PressLeft = false;
				Link->InputLeft = false;
				Link->PressRight = false;
				Link->InputRight = false;
				Link->PressUp = false;
				Link->InputUp = false;
			}
			Link->PressA = false;
			Link->InputA = false;
			Link->PressB = false;
			Link->InputB = false;
			Link->PressEx1 = false;
			Link->InputEx1 = false;
			Link->PressEx2 = false;
			Link->InputEx2 = false;
			Link->PressEx3 = false;
			Link->InputEx3 = false;
			Link->PressEx4 = false;
			Link->InputEx4 = false;
            Waitframe();
        }
    }
}

ffc script strngCutsceneScene{
	void run (int id, int wait, int type){
		Waitframes(wait);
		if (type == 0){
			messagedata md01 = Game->LoadMessageData(7601);
			messagedata md02 = Game->LoadMessageData(7602);
			messagedata md03 = Game->LoadMessageData(7603);
			messagedata md04 = Game->LoadMessageData(7604);
			messagedata md05 = Game->LoadMessageData(7605);
			messagedata md06 = Game->LoadMessageData(7606);
			messagedata md07 = Game->LoadMessageData(7607);
			messagedata md08 = Game->LoadMessageData(7608);
			messagedata md09 = Game->LoadMessageData(7609);
			messagedata md10 = Game->LoadMessageData(7610);
			switch(id)
			{
				case 0:	//Test
					md01->PortraitTile = 54640; md01->Y = 120; md01->PortraitY = 125;
					md01->Set("Test");
					md01->Next = 0;
					break;
				case 1:	//Aurelia Diner of Courage Scene 1
					md01->PortraitTile = 54720; md01->Y = 10; md01->PortraitY = 15;
					char32 str01[1000];
					sprintf(str01, "%c%c%c%c%cAurelia:%c%c%c Hey, Linky! Time to take that Lotzy Lotz down, yay!!",sc(21),sc(64),sc(1),sc(8),sc(3),sc(1),sc(0),sc(1));
					md01->Set(str01);
					md01->Next = 7602;
					md02->PortraitTile = 54720; md02->Y = 10; md02->PortraitY = 15;
