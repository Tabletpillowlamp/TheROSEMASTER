			case 298: // Hinox L2 (2)
				CreateNPCAt(121, 136, 56); CreateNPCAt(121, 136, 136);
				break;
			case 299: // Octorock L3 (8), Keese Master L2 (1), Keese Master L3 (1)
				CreateNPCAt(139, 120, 48); CreateNPCAt(139, 144, 48);
				CreateNPCAt(139, 168, 48); CreateNPCAt(139, 192, 48);
				CreateNPCAt(139, 120, 144); CreateNPCAt(139, 144, 144);
				CreateNPCAt(139, 168, 144); CreateNPCAt(139, 192, 144);
				CreateNPCAt(191, 132, 96); CreateNPCAt(423, 180, 96);
				break;
			case 300: // Rope L3 (8), Valkyrie L1 (2)
				CreateNPCAt(373, 120, 48); CreateNPCAt(373, 144, 48);
				CreateNPCAt(373, 168, 48); CreateNPCAt(373, 192, 48);
				CreateNPCAt(373, 120, 144); CreateNPCAt(373, 144, 144);
				CreateNPCAt(373, 168, 144); CreateNPCAt(373, 192, 144);
				CreateNPCAt(424, 132, 96); CreateNPCAt(424, 180, 96);
				break;
			
			// RNG Groups
			case 301: // Five Weak, One Strong
				CreateNPCAt(enemyList2[rr1], 184, 64); CreateNPCAt(enemyList1[rr2], 184, 120);
				CreateNPCAt(enemyList1[rr3], 152, 64); CreateNPCAt(enemyList1[rr4], 152, 120);
				CreateNPCAt(enemyList1[rr5], 120, 64); CreateNPCAt(enemyList1[rr6], 120, 120);
				break;
			case 302: // Four Weak, Two Strong
				CreateNPCAt(enemyList2[rr1], 184, 64); CreateNPCAt(enemyList2[rr2], 184, 120);
				CreateNPCAt(enemyList1[rr3], 152, 64); CreateNPCAt(enemyList1[rr4], 152, 120);
				CreateNPCAt(enemyList1[rr5], 120, 64); CreateNPCAt(enemyList1[rr6], 120, 120);
				break;
			case 303: // Three Weak, Two Strong, One Very Strong
				CreateNPCAt(enemyList3[rr1], 184, 64); CreateNPCAt(enemyList2[rr2], 184, 120);
				CreateNPCAt(enemyList2[rr3], 152, 64); CreateNPCAt(enemyList1[rr4], 152, 120);
				CreateNPCAt(enemyList1[rr5], 120, 64); CreateNPCAt(enemyList1[rr6], 120, 120);
				break;
			case 304: // Two Weak, Two Strong, Two Very Strong
				CreateNPCAt(enemyList3[rr1], 184, 64); CreateNPCAt(enemyList3[rr2], 184, 120);
				CreateNPCAt(enemyList2[rr3], 152, 64); CreateNPCAt(enemyList2[rr4], 152, 120);
				CreateNPCAt(enemyList1[rr5], 120, 64); CreateNPCAt(enemyList1[rr6], 120, 120);
				break;
		}

		//==============
		
		//Move Link either until he's in position or 4 seconds have passed
		for(int i=0; i<=240&&(Link->X!=id1||Link->Y!=id2); i++){
			//Prevent moving around while moving Link into position
			Link->InputStart = false; Link->PressStart = false;
			Link->InputMap = false; Link->PressMap = false;
			PegasusBoots::UserInterruptDash();
			NoAction();
			//Apply inputs that should be active
			if(Abs(Link->X-id1)<=2){
				Link->X = id1;
			}
			else{
				if(Link->X<id1)
					Link->InputRight = true;
				else if(Link->X>id1)
					Link->InputLeft = true;
			}
			if(Abs(Link->Y-id2)<=2){
				Link->Y = id2;
			}
			else{
				if(Link->Y<id2)
					Link->InputDown = true;
				else if(Link->Y>id2)
					Link->InputUp = true;
			}
			Waitframe();
		}
		
		//Close Door
		Game->PlaySound(9);
		Game->LoadTempScreen(2)->ComboD[ComboAt(0,32)] = 18029;
		Game->LoadTempScreen(2)->ComboD[ComboAt(0,48)] = 18030;
		Game->LoadTempScreen(2)->ComboD[ComboAt(0,64)] = 18030;
		Game->LoadTempScreen(2)->ComboD[ComboAt(0,80)] = 18030;
		Game->LoadTempScreen(2)->ComboD[ComboAt(0,96)] = 18031;
		Game->LoadTempScreen(2)->ComboD[ComboAt(0,112)] = 6372;
		Game->LoadTempScreen(5)->ComboD[ComboAt(0,32)] = 6588;
		Game->LoadTempScreen(5)->ComboD[ComboAt(0,48)] = 6588;
		Game->LoadTempScreen(5)->ComboD[ComboAt(0,64)] = 6588;
		Game->LoadTempScreen(5)->ComboD[ComboAt(0,80)] = 6588;
		Game->LoadTempScreen(5)->ComboD[ComboAt(0,96)] = 6588;
		Game->LoadTempScreen(5)->ComboD[ComboAt(0,112)] = 6588;
		
		//Wait for all enemies defeated
		while(!Screen->SecretsTriggered()){
			Waitframe();
		}
		
		//Add to Score
		Game->Counter[wave]++;
		if(Game->Counter[best] < Game->Counter[wave]){
			Game->Counter[best] = Game->Counter[wave];
		}
		
		//Record wave id to last 20 pool
		if(rng <= 300){
			int lastPos = Game->Counter[pos] + 47;
			Game->Counter[lastPos] = rng;
			if(Game->Counter[pos] >= 20){
				Game->Counter[pos] = 1;
			}
			else{
				Game->Counter[pos]++;
			}
		}
		
		//Cleared 150 rooms
		if(Game->Counter[wave] == 150 && !Link->Item[253]){
			//Close Wall
			Game->LoadTempScreen(4)->ComboD[ComboAt(240,32)] = 18029;
			Game->LoadTempScreen(4)->ComboD[ComboAt(240,48)] = 18030;
			Game->LoadTempScreen(4)->ComboD[ComboAt(240,64)] = 18030;
			Game->LoadTempScreen(4)->ComboD[ComboAt(240,80)] = 18030;
			Game->LoadTempScreen(4)->ComboD[ComboAt(240,96)] = 18031;
			Game->LoadTempScreen(4)->ComboD[ComboAt(240,112)] = 6372;
			
			//Move Link to center
			id1 = 120; id2 = 96;
			while(Link->X!=id1||Link->Y!=id2){
				//Prevent moving around while moving Link into position
				Link->InputStart = false; Link->PressStart = false;
				Link->InputMap = false; Link->PressMap = false;
				PegasusBoots::UserInterruptDash();
				NoAction();
				//Apply inputs that should be active
				if(Abs(Link->X-id1)<=2){
					Link->X = id1;
				}
				else{
					if(Link->X<id1)
						Link->InputRight = true;
					else if(Link->X>id1)
						Link->InputLeft = true;
				}
				if(Abs(Link->Y-id2)<=2){
					Link->Y = id2;
				}
				else{
					if(Link->Y<id2)
						Link->InputDown = true;
					else if(Link->Y>id2)
						Link->InputUp = true;
				}
				Waitframe();
			}
			
			//Warp
			Link->WarpEx({WT_IWARP,363,32,-1,-1,WARPEFFECT_NONE,25,4});
			
		}
		else{
			Game->PlaySound(9);
		}
		
		//Rewards
		CreateItemAt(86, 120, 96);
	
	} //Closing gen Bracket
		
	else if (genID == 1){ //Reset Past Rooms
		for(int i=48; i<=67; ++i){
			Game->Counter[i] = 0;
		}
	}
		
		
	}
}