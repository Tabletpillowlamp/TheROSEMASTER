ffc script StarlightExpress{
	void run(int genID){
		
		if(genID == 0){
		
		int pos = 16;
		int wave = 17;
		int rng;
		int best = 47;
		int id1 = 16; int id2 = 96;
		
		//Summon Enemies
		/*
		Waves 001 - 019: Group 1
		Waves 020 - 029: Group 1, Group 2
		Waves 030 - 059: Group 2, Group 3
		Waves 060 - 079: Group 3, Group 4
		Waves 080 - 099: Group 4, Group 5
		Waves 100 - 119: Group 5, Group 6
		Waves 120 - 139: Group 6, Group 7
		Waves 140 - 179: Group 6, Group 7, Group 8
		Waves 180 - 219: Group 7, Group 8
		Waves 220 - 269: Group R1 (5 weak, 1 strong)
		Waves 270 - 319: Group R2 (4 weak, 2 strong)
		Waves 320 - 399: Group R3 (3 weak, 2 strong, 1 Very Strong)
		Waves 400+     : Group R4 (2 weak, 2 strong, 2 Very Strong)
		*/
		
		//Roll RNG
		if( Game->Counter[wave] < 20 ){ rng = Rand(1,20); }
		else if( Game->Counter[wave] >= 20 && Game->Counter[wave] < 30 ){ rng = Rand(1,50); }
		else if( Game->Counter[wave] >= 30 && Game->Counter[wave] < 60 ){ rng = Rand(21,70); }
		else if( Game->Counter[wave] >= 60 && Game->Counter[wave] < 80 ){ rng = Rand(51,90); }
		else if( Game->Counter[wave] >= 80 && Game->Counter[wave] < 100 ){ rng = Rand(71,120); }
		else if( Game->Counter[wave] >= 100 && Game->Counter[wave] < 120 ){ rng = Rand(91,180); }
		else if( Game->Counter[wave] >= 120 && Game->Counter[wave] < 140 ){ rng = Rand(121,250); }
		else if( Game->Counter[wave] >= 140 && Game->Counter[wave] < 180 ){ rng = Rand(121,300); }
		else if( Game->Counter[wave] >= 180 && Game->Counter[wave] < 220 ){ rng = Rand(181,300); }
		//RNG Battles
		else if( Game->Counter[wave] >= 220 && Game->Counter[wave] < 270 ){ rng = 301; }
		else if( Game->Counter[wave] >= 270 && Game->Counter[wave] < 320 ){ rng = 302; }
		else if( Game->Counter[wave] >= 320 && Game->Counter[wave] < 400 ){ rng = 303; }
		else { rng = 304; }
		
		int safeLock = 0;
		
		//Reroll RNG if same as previous 20
		while( safeLock < 30 &&
			  (rng == Game->Counter[48] || rng == Game->Counter[49] || rng == Game->Counter[50] ||
