// Silver Dragon Spell
generic script IvoryBlessing
{
    void run()
    {
		this->ExitState[GENSCR_ST_CONTINUE] = true;
		this->ExitState[GENSCR_ST_RELOAD] = true;
		
		//Setup Bottle Effects
		int botCheck = 1;
		//Check for first open bottle 
		for(int i = 1; i <= 4; i++){
			if(Game->BottleState[botCheck] == 0){
				botCheck += 1;
			}
		}
		if(botCheck > 4){botCheck=4;}
		int type = Game->BottleState[botCheck];
		int k = 0;
		Game->PlaySound(35);
		for(int i=0; i<60; i++){
			if(i > 10){
				k = 1;
			}
			switch(type){
				case 1: FastTile(4,Link->X,Link->Y-18,21789,8,OP_OPAQUE); break;
				case 2: FastTile(4,Link->X,Link->Y-18,21790,8,OP_OPAQUE); break;
				case 3: FastTile(4,Link->X,Link->Y-18,21791,8,OP_OPAQUE); break;
				case 4: FastTile(4,Link->X,Link->Y-18,21792,8,OP_OPAQUE); break;
				case 5: FastTile(4,Link->X,Link->Y-18,21793,8,OP_OPAQUE); break;
				case 6: FastTile(4,Link->X,Link->Y-18,21794,8,OP_OPAQUE); break;
				case 7: FastTile(4,Link->X,Link->Y-18,21795,8,OP_OPAQUE); break;
				case 8: FastTile(4,Link->X,Link->Y-18,21796,8,OP_OPAQUE); break;
				case 9: FastTile(4,Link->X,Link->Y-18,21797,8,OP_OPAQUE); break;
				case 10: FastTile(4,Link->X,Link->Y-18,21798,8,OP_OPAQUE); break;
				case 11: FastTile(4,Link->X,Link->Y-18,21799,8,OP_OPAQUE); break;
			}
			Link->Action=LA_NONE;
			Link->Action=LA_ATTACKING;
			if(Link->Item[ENHANCED_DS_ID] && Link->PressA && k == 1){
				Game->PlaySound(5);
				if(type == 11){
					type = 1;
				}
				else{
					type += 1;
				}
				i = 0;
			}
			if(Link->Item[ENHANCED_DS_ID] && Link->PressB && k == 1){
				Game->PlaySound(5);
				if(type == 1){
					type = 11;
				}
				else{
					type -= 1;
				}
				i = 0;
			}
			Waitframe();
		}
		switch(type){
			case 1:	//Red Potion
				Game->PlaySound(124);
				RunFFCScript(56, {0x06, 30, 0});
				Link->HP += 160;
				break;
			case 2:	//Green Potion
				Game->PlaySound(124);
				RunFFCScript(56, {0x13, 30, 0});
				Link->MP = Link->MaxMP;
				break;
			case 3:	//Yellow Potion
				Game->PlaySound(124);
				RunFFCScript(56, {0x88, 30, 0});
				Link->HP = Link->MaxHP;
				break;
			case 4:	//Blue Potion
				Game->PlaySound(124);
				RunFFCScript(56, {0x0A, 30, 0});
				Link->HP += 160;
				Link->MP = Link->MaxMP;
				break;
			case 5:	//Crystal Potion
				Game->PlaySound(124);
				RunFFCScript(56, {0x09, 30, 0});
				Link->HP = Link->MaxHP;
				Link->MP = Link->MaxMP;
				break;
			case 6:	//Fairy
				Game->PlaySound(124);
				RunFFCScript(56, {0x83, 30, 0});
				Link->HP += Link->MaxHP/2;
				break;
			case 7:	//Golden Fairy
				Game->PlaySound(124);
				RunFFCScript(56, {0x88, 30, 0});
				Link->HP = Link->MaxHP;
				break;
			case 8:	//Supplement Goop
				Game->PlaySound(124);
				RunFFCScript(56, {0xB9, 30, 0});
				Game->DCounter[2] = Game->MCounter[2];
				Game->DCounter[3] = Game->MCounter[3];
				Game->DCounter[7] = Game->MCounter[7];
				break;
			case 9:	//White Potion
				bitmap b = Game->CreateBitmap(16,16);
				b->Own();
				RunFFCScript(56, {9, 40, 0});
				Game->PlaySound(124);
				for(int i = 0; i<360; i++){
					b->Clear(0);
					b->FastTile(0,0,0,Link->Tile,6,OP_OPAQUE);
					if(i%4 < 2){
						b->ReplaceColors(0,0x01,0x01,0xFF);
						b->Blit(SPLAYER_PLAYER_DRAW,RT_SCREEN,0,0,16,16,Link->X,Link->Y-Link->Z,16,16,0,0,0,BITDX_NORMAL,0,true);
					}
					FastCombo(6,240,0,15331,11,OP_OPAQUE);
					Hero->InvFrames = 8;
					Waitframe();
					if (i==300){
						RunFFCScript(56, {9, 60, 0});
						Game->PlaySound(124);
					}
				}
				break;
			case 10: //Black Potion
				RunFFCScript(56, {15, 60, 0});
				Game->PlaySound(89);
				Screen->Wavy = 15;
				npc enemys;
				for(int i = 1; i<=Screen->NumNPCs(); i++){
					enemys = Screen->LoadNPC(i); 
					enemys->HP-=64; 
				}
				break;
			case 11: //Seashell Vodka
				bitmap b = Game->CreateBitmap(16,16);
				b->Own();
				//====================================
				//Copy Pasted Code from Seashell Vodka
				//====================================
				int args[8] = {10, 60, 0};
				int effect1 = 0; int effect2 = 0; int effect3 = 0;
				int effect4 = 0; int effect5 = 0; int effect6 = 0;
				int effect7 = 0; int effect8 = 0;
				int RNG = 0; int num = 1; int tim = 300;
				//Seashell Check
				if(Game->Counter[14]>=3500){num = 8;}
				else if(Game->Counter[14]>=3000){num = 7;}
				else if(Game->Counter[14]>=2500){num = 6;}
				else if(Game->Counter[14]>=2000){num = 5;}
				else if(Game->Counter[14]>=1500){num = 4;}
				else if(Game->Counter[14]>=1000){num = 3;}
				else if(Game->Counter[14]>=500){num = 2;}
				//Generate Randomness
				for(int i=0; i<num; ++i){
					RNG = Rand(1,8);
					while(RNG < 10){
						if((RNG==1)&&(effect1==0)){
							effect1 = 1;
							RNG = 10;
						}
						else if((RNG==2)&&(effect2==0)){
							effect2 = 1;
							RNG = 10;
						}
						else if((RNG==3)&&(effect3==0)){
							effect3 = 1;
							RNG = 10;
						}
						else if((RNG==4)&&(effect4==0)){
							effect4 = 1;
							RNG = 10;
						}
						else if((RNG==5)&&(effect5==0)){
							effect5 = 1;
							RNG = 10;
						}
						else if((RNG==6)&&(effect6==0)){
							effect6 = 1;
							RNG = 10;
						}
						else if((RNG==7)&&(effect7==0)){
							effect7 = 1;
							RNG = 10;
						}
						else if((RNG==8)&&(effect8==0)){
							effect8 = 1;
							RNG = 10;
						}
						else{
							RNG = Rand(1,8);
						}
					}
				}
				//Effects
				RunFFCScript(56, args);
				Game->PlaySound(124);
				
				if(effect1){
					Player->Item[252]=true;
				}
				if(effect2){
					Link->HP = Link->MaxHP;
				}
				if(effect3){
					Link->MP = Link->MaxMP;
				}
				if(effect6){
					Game->PlaySound(89);
					Screen->Wavy = 15;
					npc enemys;
					for(int i = 1; i<=Screen->NumNPCs(); i++){
						enemys = Screen->LoadNPC(i); //Targets those enemies.
						enemys->HP-=32; 
					}
				}
				if(effect8){
					CreateItemAt(73, ((Link->X)-24), ((Link->Y)-24));
					CreateItemAt(80, ((Link->X)+24), ((Link->Y)-24));
					CreateItemAt(154, ((Link->X)-24), ((Link->Y)+24));
					CreateItemAt(60, ((Link->X)+24), ((Link->Y)+24));
				}
				if(Game->Counter[14]>=4500){tim = 360;}
				if(Game->Counter[14]>=6000){tim = 720;}
				if(effect1||effect4||effect5||effect7){
					for(int i = 0; i<tim; i++){
						if(effect1){
							FastCombo(6,240,0,15590,7,OP_OPAQUE);
						}
						if(effect4){
							if(i%2){Link->HP += 1;}
							if(effect1){
								FastCombo(6,224,0,15556,8,OP_OPAQUE);
							}
							else{
								FastCombo(6,240,0,15556,8,OP_OPAQUE);
							}
						}
						if(effect7){
							b->Clear(0);
							b->FastTile(0,0,0,Link->Tile,6,OP_OPAQUE);
							if(i%4 < 2){
								b->ReplaceColors(0,0x01,0x01,0xFF);
								b->Blit(SPLAYER_PLAYER_DRAW,RT_SCREEN,0,0,16,16,Link->X,Link->Y-Link->Z,16,16,0,0,0,BITDX_NORMAL,0,true);
							}
							Hero->InvFrames = 8;
							if(effect1&&effect4){
								FastCombo(6,208,0,15331,11,OP_OPAQUE);
							}
							else if(effect1||effect4){
								FastCombo(6,224,0,15331,11,OP_OPAQUE);
							}
							else{
								FastCombo(6,240,0,15331,11,OP_OPAQUE);
							}
						}
						if((effect5)&&(i%60==0)){
							for(int i; i < 15; i++){
							Game->PlaySound(32);
							lweapon magic = CreateLWeaponAt(2, Link->X, Link->Y);
							magic->Angular = true;
							magic->Angle = DegtoRad(i*24);
							magic->Step = 420;
							magic->UseSprite(183);
							magic->Damage = 22;
							}
						}
						Waitframe();
						if (i==(tim-60)){
							RunFFCScript(56, args);
							Game->PlaySound(124);
						}
					}
				}
				Player->Item[252]=false;
				//====================================
				//End of Copy Paste
				//====================================
				break;
		}
		
		Link->Action=LA_NONE;
		while(true)
		{
			Waitframe();
		}
	}
}

