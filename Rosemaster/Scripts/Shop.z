//D0: ID of the item
//D1: Price of the item
//D2: Message that plays when the item is bought
//D3: Message that plays when you don't have enough rupees
//D4: Input type 0=A 1=B 2=L 3=R
ffc script SimpleShop{
    void run(int itemID, int price, int m, int n, int input, int bottle, int unique, int seth){
        int loc = ComboAt(this->X,this->Y);
		int bot1 = 29;
		int bot2 = 195;
		int bot3 = 189;
		int bot4 = 219;
		if((itemID!=11)||(Player->Item[222]==true)){
			while(true){
				while(!AgainstComboBase(loc) || !SelectPressInput(input)){
					Waitframe();
					if(((Link->Y <= ComboY(loc)+16)&&(Link->Y>=ComboY(loc))) && Abs(Link->X-ComboX(loc)) < 8){
						itemDisplayName(itemID, bottle);
					}
				}
				SetInput(input,false);
				if((!Game->DCounter[CR_RUPEES])&&(seth!=2))
				{
					if(Game->Counter[CR_RUPEES] >= price)
					{
						if(bottle == 0)
						{
							if ((unique == 1) && Link->Item[itemID])	//Already owned the item
							{
								Screen->Message(n+154);
							}
							else if ( (itemID == 139) && (Link->Item[51]) )	//Concert Ticket
							{
								Screen->Message(n+154);
							}						
							else
							{
								if ((Game->Counter[0] >= Game->MCounter[0]) && ((itemID == 2) || (itemID == 160) || (itemID == 34) || (itemID == 69)))	//Health
								{
									Screen->Message(n+154);
								}
								if ((Game->Counter[4] >= Game->MCounter[4]) && ((itemID == 59) || (itemID == 60)))	//Magic
								{
									Screen->Message(n+154);
								}
								else if ((Game->Counter[2] >= Game->MCounter[2]) && ((itemID == 77) || (itemID == 78) || (itemID == 79)|| (itemID == 80)))	//Bombs
								{
									Screen->Message(n+154);
								}
								else if ((Game->Counter[3] >= Game->MCounter[3]) && ((itemID == 70) || (itemID == 71) || (itemID == 72)|| (itemID == 73)))	//Arrows
								{
									Screen->Message(n+154);
								}
								else if ((Game->Counter[6] >= Game->MCounter[6]) && (itemID == 48))	//Super Bombs
								{
									Screen->Message(n+154);
								}
								else if ((Game->Counter[7] >= Game->MCounter[7]) && ((itemID == 152) || (itemID == 153) || (itemID == 173) || (itemID == 154)))	//Bombchus
								{
									Screen->Message(n+154);
								}
								else
								{
									item shpitm = CreateItemAt(itemID, Link->X, Link->Y);
									shpitm->Pickup = IP_HOLDUP;
									Game->DCounter[CR_RUPEES] -= price;
									if (seth == 1){Game->Counter[13] += price;}
									Screen->Message(m);
								}
							}
						}
						else
						{
							if(Game->BottleState[1] == 0)
							{
								Game->DCounter[CR_RUPEES] -= price;
								Game->BottleState[1] = itemID;
								Hero->Action = LA_HOLD1LAND;
								Hero->HeldItem = bot1;
								holdUpBottle(itemID);
								if (seth == 1){Game->Counter[13] += price;}
							}
							else if(Game->BottleState[2] == 0 && Link->Item[bot2])
							{
								Game->DCounter[CR_RUPEES] -= price;
								Game->BottleState[2] = itemID;
								Hero->Action = LA_HOLD1LAND;
								Hero->HeldItem = bot2;
								holdUpBottle(itemID);
								if (seth == 1){Game->Counter[13] += price;}
							}
							else if(Game->BottleState[3] == 0 && Link->Item[bot3])
							{
								Game->DCounter[CR_RUPEES] -= price;
								Game->BottleState[3] = itemID;
								Hero->Action = LA_HOLD1LAND;
								Hero->HeldItem = bot3;
								holdUpBottle(itemID);
								if (seth == 1){Game->Counter[13] += price;}
							}
							else if(Game->BottleState[4] == 0 && Link->Item[bot4])
							{
								Game->DCounter[CR_RUPEES] -= price;
								Game->BottleState[4] = itemID;
								Hero->Action = LA_HOLD1LAND;
								Hero->HeldItem = bot4;
								holdUpBottle(itemID);
								if (seth == 1){Game->Counter[13] += price;}
							}
							else
							{
								Screen->Message(n+154);
							}
						}
					}
					else
					{
						Screen->Message(n);
					}
					
				}
				else if(seth==2){
					if(Game->Counter[14] >= price){
						Game->Counter[14] -= price;
						item shpitm = CreateItemAt(itemID, Link->X, Link->Y);
						shpitm->Pickup = IP_HOLDUP;
						
					}
					else {
						Screen->Message(4815);
					}
				}
				Waitframe();
			}
		}
    }
	void holdUpBottle(int id){
		Game->PlaySound(20);
		Waitframes(1);
		botMessage(id);
		}
	void botMessage(int bt){
		if(bt == 1){
			Screen->Message(160);
		}
		else if(bt == 2){
			Screen->Message(161);
		}
		else if(bt == 3){
			Screen->Message(162);
		}
		else if(bt == 4){
			Screen->Message(163);
		}
		else if(bt == 5){
			Screen->Message(164);
		}
		else if(bt == 6){
			Screen->Message(165);
		}
		else if(bt == 7){
			Screen->Message(166);
		}
		else if(bt == 8){
			Screen->Message(167);
		}
		else if(bt == 9){
			Screen->Message(6969);
		}
		else if(bt == 10){
			Screen->Message(6970);
		}
		else if(bt == 11){
			Screen->Message(7144);
		}
	}
