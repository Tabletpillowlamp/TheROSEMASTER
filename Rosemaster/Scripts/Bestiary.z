    void ArrayCopySetSize(int dest, int src)
    {
        ResizeArray(dest, SizeOfArray(src));
        ArrayCopy(dest, src);
    }

    enum BestiaryGenericStat
    {
        GENSTAT_HP,
        GENSTAT_DAMAGE,
        GENSTAT_WDAMAGE,
        GENSTAT_STEP,
        GENSTAT_COUNT
    };

    class BestiaryPage
    {
        genericdata BestiaryEventGeneric;
        subscreendata Subscreen;
        subscreenwidget wIcon; // Tile Block
        subscreenwidget wName; // Text widget
        subscreenwidget wDescription; // Text box widget
        subscreenwidget wDescriptionScrollbar; // Rectangle widget
        subscreenwidget wEnemyList; // Rectangle widget
        subscreenwidget wEnemyListScrollbar; // Rectangle widget
        subscreenwidget wStatGeneric[GENSTAT_COUNT]; // Text widget
        subscreenwidget wStatCustom[0]; // Text widget
        subscreenwidget wStatIcons[3]; // Text widget
        subscreenwidget wStatStrings[3]; // Text widget
        subscreenwidget wCompletionFrac; // Text widget
        subscreenwidget wCompletionPct; // Text widget

        subscreenwidget wDrawOverlay; // Created by script

        int TileUnknown;

        int EnemyIDs[0];
        // BestiaryEnemy Enemies[0];
        WrappedString DescriptionString;

        int SelectedEnemy;
        int DiscoveredEnemies;

        int TextScroll;
        int MaxTextScroll;

        bitmap TextBoxBitmap;
        bitmap DrawOverlayBitmap;
        bool UpdateDraws;

        MenuInputHandler InputHandler;

        BestiaryPage(subscreendata sub, int page)
        {
			genericdata bitmapgeneric = Game->LoadGenericData(CheckGenericScript("GlobalSubscreenBitmaps"));
            BestiaryEventGeneric = Game->LoadGenericData(CheckGenericScript("BestiaryEvent"));
            Subscreen = sub;
            Bestiary_GetEntryList(EnemyIDs);
            //InitEnemies(Enemies);
            subscreenpage p = Subscreen->Pages[page];
            wIcon = p->GetWidget("BESTIARY_ICON");
            ValidateWidget(wIcon, 18, "Tile Block");
            if(wIcon)
                //TileUnknown = wIcon->Tile[0];
                TileUnknown = 105480;
            wName = p->GetWidget("BESTIARY_NAME");
            ValidateWidget(wName, 2, "Text");
            wDescription = p->GetWidget("BESTIARY_DESCRIPTION");
            ValidateWidget(wDescription, 23, "Text Box");
            if(wDescription)
            {
                DescriptionString = new WrappedString(wDescription->Font, "", wDescription->W, BESTIARY_DESCRIPTION_LINE_PADDING);
				TextBoxBitmap = bitmapgeneric->Data[GSUBBIT_TEXTBOX];
				//TextBoxBitmap->Own();
				//printf("Bitmap %d\n", TextBoxBitmap);
                MakeInvisible(wDescription);
            }
            wDescriptionScrollbar = p->GetWidget("BESTIARY_DESCRIPTION_SCROLLBAR");
            ValidateWidget(wDescriptionScrollbar, 4, "Rectangle");
            wEnemyList = p->GetWidget("BESTIARY_LIST");
            if(wEnemyList)
                MakeInvisible(wEnemyList);
            ValidateWidget(wEnemyList, 4, "Rectangle");
            wEnemyListScrollbar = p->GetWidget("BESTIARY_LIST_SCROLLBAR");
            ValidateWidget(wEnemyListScrollbar, 4, "Rectangle");
            wStatGeneric[GENSTAT_HP] = p->GetWidget("BESTIARY_STAT_HP");
            ValidateWidget(wStatGeneric[GENSTAT_HP], 2, "Text");
            wStatGeneric[GENSTAT_DAMAGE] = p->GetWidget("BESTIARY_STAT_DAMAGE");
            ValidateWidget(wStatGeneric[GENSTAT_DAMAGE], 2, "Text");
            wStatGeneric[GENSTAT_WDAMAGE] = p->GetWidget("BESTIARY_STAT_WDAMAGE");
            ValidateWidget(wStatGeneric[GENSTAT_WDAMAGE], 2, "Text");
            wStatGeneric[GENSTAT_STEP] = p->GetWidget("BESTIARY_STAT_STEP");
            ValidateWidget(wStatGeneric[GENSTAT_STEP], 2, "Text");
            ResizeArray(wStatCustom, BESTIARY_MAX_ENEMY_STATS);
            for(int i=0; i<BESTIARY_MAX_ENEMY_STATS; ++i)
            {
                int str[64];
                sprintf(str, "BESTIARY_STAT_CUSTOM_%d", i);
                wStatCustom[i] = p->GetWidget(str);
                ValidateWidget(wStatCustom[i], 2, "Text");
            }
            for(int i=0; i<3; ++i)
            {
                int str[64];
                sprintf(str, "BESTIARY_STAT_ICONS_%d", i);
                wStatIcons[i] = p->GetWidget(str);
                ValidateWidget(wStatIcons[i], 18, "Tile Block");
                if(wStatIcons[i])
                    MakeInvisible(wStatIcons[i]);
            }
            for(int i=0; i<3; ++i)
            {
                int str[64];
                sprintf(str, "BESTIARY_STAT_STRING_%d", i);
                wStatStrings[i] = p->GetWidget(str);
                ValidateWidget(wStatStrings[i], 2, "Text");
            }
            wCompletionFrac = p->GetWidget("BESTIARY_COMPLETION_FRACTIONAL");
            ValidateWidget(wCompletionFrac, 2, "Text");
            wCompletionPct = p->GetWidget("BESTIARY_COMPLETION_PERCENT");
            ValidateWidget(wCompletionFrac, 2, "Text");

            DrawOverlayBitmap = bitmapgeneric->Data[GSUBBIT_OVERLAY];
			//DrawOverlayBitmap->Own();
			//printf("Bitmap %d\n", DrawOverlayBitmap);
            wDrawOverlay = p->CreateWidget(18);
            wDrawOverlay->Tile[0] = TIL_BESTIARY_DRAW_OVERLAY;;
            wDrawOverlay->W = 16;
            wDrawOverlay->H = 11;
            wDrawOverlay->Flags[0] = true;

            InputHandler = new MenuInputHandler({CB_SELECTUP, CB_SELECTDOWN, CB_FSELECTUP, CB_FSELECTDOWN}, 16);
            InputHandler->SetHoldAcceleration(1, 2);
            DiscoveredEnemies = GetEnemyCount();
            SelectedEnemy = BestiaryEventGeneric->Data[BED_CURSORPOS];
            UpdateFields(SelectedEnemy);
            Draw();
        }
        ~BestiaryPage()
        {
            delete DescriptionString;
        }

        int GetEnemyCount()
        {
            int sz = SizeOfArray(EnemyIDs);
            int count;
            for(int i=0; i<sz; ++i)
            {
                if(BestiaryEventGeneric->Data[EnemyIDs[i]])
                    ++count;
            }
            return count;
        }

        void ValidateWidget(subscreenwidget w, int expectedType, char32 name)
        {
            if(w)
            {
                if(w->Type!=expectedType)
                {
                    int lbl[64];
                    w->GetLabel(lbl);
                    printf("Error! Subscreen Widget %d with label %s is the wrong type. (Should be %s)\n", w->Index, lbl, name);
                }
            }
        }
        void UpdateFields(int slot)
        {
            UpdateDraws = true;
            int id = EnemyIDs[slot];
            //BestiaryEnemy stats = Enemies[slot];
            npcdata nd = Game->LoadNPCData(id);
            char32 unknown = "???";
            char32 unknownDesc = " ";
            bool found;
            if(BestiaryEventGeneric->Data[id])
            {
                found = true;
                BestiaryEventGeneric->Data[id] = 2;
            }

            if(wIcon)
                wIcon->Tile[0] = found?Bestiary_Tile(id):TileUnknown;
            char32 nameBuf[0];
            Bestiary_Name(nameBuf, id);
            if(wName)
                wName->SetText(found?nameBuf:unknown);
            if(wDescription)
            {
                char32 descBuf[0];
                Bestiary_Description(descBuf, id);
                DescriptionString->Init(wDescription->Font, found?descBuf:unknownDesc, wDescription->W, BESTIARY_DESCRIPTION_LINE_PADDING);
                TextScroll = 0;
                MaxTextScroll = Max(DescriptionString->H-wDescription->H, 0);
            }
            if(wStatGeneric[GENSTAT_HP])
            {
                int buf[16];
                sprintf(buf, "%d", nd->HP);
                wStatGeneric[GENSTAT_HP]->SetText(found?buf:unknown);
            }
            if(wStatGeneric[GENSTAT_DAMAGE])
            {
                int buf[16];
                sprintf(buf, "%d", nd->TouchDamage);
                wStatGeneric[GENSTAT_DAMAGE]->SetText(found?buf:unknown);
            }
            if(wStatGeneric[GENSTAT_WDAMAGE])
            {
                int buf[16];
                sprintf(buf, "%d", nd->WeaponDamage);
                wStatGeneric[GENSTAT_WDAMAGE]->SetText(found?buf:unknown);
            }
            if(wStatGeneric[GENSTAT_STEP])
            {
                int buf[16];
                sprintf(buf, "%d", nd->Step);
                wStatGeneric[GENSTAT_STEP]->SetText(found?buf:unknown);
            }
            // for(int i=0; i<BESTIARY_MAX_ENEMY_STATS; ++i)
            // {
            //     if(wStatCustom[i])
            //     {
            //         int buf[16];
            //         sprintf(buf, "%d", stats->Stats[i]);
            //         wStatCustom[i]->SetText(found?buf:unknown);
            //     }
            // }
            char32 statString1[0];
            char32 statString2[0];
            char32 statString3[0];
            Bestiary_StatStrings(statString1, statString2, statString3, id);
            int statStrings[] = {statString1, statString2, statString3};
            for(int i=0; i<3; ++i)
            {
                if(wStatStrings[i])
                {
                    wStatStrings[i]->SetText(found?statStrings[i]:unknown);
                }
            }
            if(wCompletionFrac)
            {
                int buf[256];
                sprintf(buf, "%d/%d", DiscoveredEnemies, SizeOfArray(EnemyIDs));
                wCompletionFrac->SetText(buf);
            }
            if(wCompletionPct)
            {
                int buf[256];
                sprintf(buf, "%d%%", Floor((DiscoveredEnemies/SizeOfArray(EnemyIDs))*100));
                wCompletionPct->SetText(buf);
            }
            DrawDescriptionBitmap();
        }

        void MakeInvisible(subscreenwidget w)
        {
            for(int i=0; i<4; ++i)
                w->VisibleFlags[i] = false;
        }
        void Select(int offset)
        {
            int prev = SelectedEnemy;
            int totalEnemies = SizeOfArray(EnemyIDs);
            SelectedEnemy += offset;
            if(SelectedEnemy<0)
                SelectedEnemy = totalEnemies-1;
            else if(SelectedEnemy>=totalEnemies)
                SelectedEnemy = 0;
            SelectedEnemy = Clamp(SelectedEnemy, 0, totalEnemies-1);
            BestiaryEventGeneric->Data[BED_CURSORPOS] = SelectedEnemy;
            if(SelectedEnemy!=prev)
            {
                Audio->PlaySound(SFX_BESTIARY_CURSOR);
                UpdateFields(SelectedEnemy);
            }
        }
        void Update(int page)
        {
			//printf("CUR %d\n", Subscreen->CurPage);
			//printf("%d\n", BESTIARY_PAGE);
            //if(Subscreen->CurPage!=BESTIARY_PAGE)
				
            if(Subscreen->CurPage!=page)
                return;
            if(Game->ActiveSubscreenY!=-56)
                return;
            if(Subscreen->TransClock!=-1)
                return;

            InputHandler->Update();
			
			//printf("PressUp %s PressDown %s\n", Link->PressUp?"TRUE":"FALSE", Link->PressDown?"TRUE":"FALSE");

            if(Link->PressUp||InputHandler->ButtonFired(CB_SELECTUP))
                Select(-1);
            else if(Link->PressEx1||InputHandler->ButtonFired(CB_FSELECTUP))
                Select(-BESTIARY_ENEMY_LIST_VISIBLE_COUNT);
            if(Link->PressDown||InputHandler->ButtonFired(CB_SELECTDOWN))
                Select(1);
            else if(Link->PressEx2||InputHandler->ButtonFired(CB_FSELECTDOWN))
                Select(BESTIARY_ENEMY_LIST_VISIBLE_COUNT);

            if(Input->Button[CB_DESCSCROLLUP])
            {
                TextScroll = Clamp(TextScroll-TEXT_SCROLL_SPEED, 0, MaxTextScroll);
                DrawDescriptionBitmap();
                UpdateDraws = true;
            }
            else if(Input->Button[CB_DESCSCROLLDOWN])
            {
                TextScroll = Clamp(TextScroll+TEXT_SCROLL_SPEED, 0, MaxTextScroll);
                DrawDescriptionBitmap();
                UpdateDraws = true;
            }
			if(Input->Press[CB_A])
            {
				printf("CLEAR");
            //    DrawOverlayBitmap->Free();
            //    TextBoxBitmap->Free();
            }

            Draw();
        }

        void Draw()
        {
            if(!UpdateDraws)
                return;
            DrawOverlayBitmap->Clear(0);
            DrawDescription();
            DrawStatIcons();
            DrawEnemyList();
            for(int x=0; x<16; ++x)
            {
                for(int y=0; y<11; ++y)
                {
                    DrawOverlayBitmap->WriteTile(0, x*16, y*16, TIL_BESTIARY_DRAW_OVERLAY+x+y*20, true, false);
                }
            }
        }

        void DrawDescriptionBitmap()
        {
            TextBoxBitmap->Clear(0);
            if(wDescription)
                DescriptionString->Draw(TextBoxBitmap, 0, 1, 1-TextScroll, wDescription->ColorText, wDescription->ColorBG, wDescription->Align, OP_OPAQUE, wDescription->ShadowType, wDescription->ColorShadow);
        }

        void DrawDescription()
        {
            if(!wDescription)
                return;
            int w = wDescription->W+2;
            int h = wDescription->H+2;
            TextBoxBitmap->Blit(0, DrawOverlayBitmap, 0, 0, w, h, wDescription->X-1, wDescription->Y-1, w, h, 0, 0, 0, BITDX_NORMAL, 0, true);
            DrawScrollbar(wDescriptionScrollbar, TextScroll, MaxTextScroll);
        }

        void DrawStatIcons()
        {
            //BestiaryEnemy stats = Enemies[SelectedEnemy];
            int id = EnemyIDs[SelectedEnemy];
            if(!BestiaryEventGeneric->Data[id])
                return;
            int statIcons1[0];
            int statIcons2[0];
            int statIcons3[0];
            int iconSets[] = {statIcons1, statIcons2, statIcons3};
            Bestiary_StatIcons(statIcons1, statIcons2, statIcons3, id);
            for(int i=0; i<3; ++i)
            {
                if(wStatIcons[i])
                {
                    int icons = iconSets[i];
                    int sz = SizeOfArray(icons);
                    for(int j=0; j<sz; ++j)
                    {
                        DrawOverlayBitmap->FastTile(0, wStatIcons[i]->X+j*BESTIARY_STAT_ICON_SPACING, wStatIcons[i]->Y, wStatIcons[i]->Tile[0]+icons[j], wStatIcons[i]->CSet[0], OP_OPAQUE);
                    }
                }
            }
        }

        void DrawEnemyList()
        {
            if(!wEnemyList)
                return;
            char32 unknown = "???";
            int topY = wEnemyList->Y;
            int bottomY = wEnemyList->Y+wEnemyList->H-Text->FontHeight(FONT_BESTIARY_ENEMY_LIST);
            int totalEnemies = SizeOfArray(EnemyIDs);
            int displayCount = Min(totalEnemies, BESTIARY_ENEMY_LIST_VISIBLE_COUNT);
            int scrollOffset = SelectedEnemy - Floor(BESTIARY_ENEMY_LIST_VISIBLE_COUNT/2);
            scrollOffset = Max(Min(scrollOffset, totalEnemies-BESTIARY_ENEMY_LIST_VISIBLE_COUNT), 0);
            int numDigits = 1;
            int te = totalEnemies;
            if(BESTIARY_ENEMY_NUMBERS_ZERO_INDEXED)
                --te;
            if(te>99)
                numDigits = 3;
            else if(te>9)
                numDigits = 2;
            for(int i=0; i<displayCount; ++i)
            {
                int j = scrollOffset+i;
                int id = EnemyIDs[j];
                int killed = BestiaryEventGeneric->Data[id];
                int buf[256];
                char32 nameBuf[0];
                Bestiary_Name(nameBuf, id);
                if(BESTIARY_SHOW_ENEMY_NUMBERS)
                {
                    int num = j;
                    if(!BESTIARY_ENEMY_NUMBERS_ZERO_INDEXED)
                        ++num;
                    int numBuf[16];
                    switch(numDigits)
                    {
                        case 1: sprintf(numBuf, "%01d: ", num); break;
                        case 2: sprintf(numBuf, "%02d: ", num); break;
                        case 3: sprintf(numBuf, "%03d: ", num); break;
                    }
                    sprintf(buf, "%s%s", numBuf, killed?nameBuf:unknown);
                }
                else
                {
                    sprintf(buf, "%s", killed?nameBuf:unknown);
                }
                int y = Lerp(topY, bottomY, i/(BESTIARY_ENEMY_LIST_VISIBLE_COUNT-1));
                int c = C_TEXT_BESTIARY_ENEMY_LIST;
                if(j==SelectedEnemy)
                {
                    c = C_TEXT_BESTIARY_ENEMY_LIST_SELECTED;
                    if(TIL_SELECTOR)
                    {
                        DrawOverlayBitmap->FastTile(0, wEnemyList->X-16, y+Text->FontHeight(FONT_BESTIARY_ENEMY_LIST)/2-8, TIL_SELECTOR, CS_SELECTOR, OP_OPAQUE);
                    }
                }
                else if(killed==1)
                    c = C_TEXT_BESTIARY_ENEMY_LIST_UNREAD;
                else if(killed==0)
                    c = C_TEXT_BESTIARY_ENEMY_LIST_UNKNOWN;
                DrawOverlayBitmap->DrawString(0, wEnemyList->X, y, FONT_BESTIARY_ENEMY_LIST, c, -1, TF_NORMAL, buf, OP_OPAQUE, SHD_BESTIARY_ENEMY_LIST, C_TEXT_BESTIARY_OUTLINE);
                DrawScrollbar(wEnemyListScrollbar, SelectedEnemy, totalEnemies-1);
            }
        }

        void DrawScrollbar(subscreenwidget w, int val, int maxVal)
        {
            if(!w)
                return;
            if(maxVal==0)
                return;
            int pct = val/maxVal;
            DrawOverlayBitmap->FastTile(0, w->X-(SCROLLBAR_WIDTH-w->W)/2, w->Y+Lerp(0, w->H-SCROLLBAR_HEIGHT, pct), TIL_SCROLLBAR, CS_SCROLLBAR, OP_OPAQUE);
        }
    }

