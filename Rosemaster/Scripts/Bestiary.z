    generic script BestiaryEvent
    {
        void run()
        {
            this->DataSize = BED_SIZE;
            this->ReloadState[GENSCR_ST_CONTINUE] = true;
            this->ReloadState[GENSCR_ST_RELOAD] = true;
            this->ReloadState[GENSCR_ST_CHANGE_SCREEN] = true;
            this->EventListen[GENSCR_EVENT_ENEMY_DEATH] = true;
            while(true)
            {
				//Debug
				//for (int i = 0; i <= 510; i++){
				//	if(!this->Data[i] && i!= 503 && i!= 497 && i!= 495 && i!= 475 && i!= 494 && i!= 496 && i!= 478 && i!= 488 && i!= 490 && i!= 356 && i!= 477 ){
				//		this->Data[i] = 1;
				//	}
				//}
				
				//Exceptions
				if(Game->Counter[11] >= 2 && !this->Data[195]){	//Beamos 1
					this->Data[195] = 1;
				}
				if(Game->Counter[11] >= 8 && !this->Data[280]){	//Beamos 2
					this->Data[280] = 1;
				}
				if(Game->Counter[11] >= 3 && !this->Data[75]){	//Fire Snake
					this->Data[75] = 1;
				}
				if(Game->Counter[12] >= 30 && !this->Data[397]){	//Chain Chomp L1
					this->Data[397] = 1;
				}
				if(Link->Item[207] && !this->Data[327]){	//Chain Chomp L2
					this->Data[327] = 1;
				}
				if(Link->Item[185] && !this->Data[301]){	//Lonk 1
					this->Data[301] = 1;
				}
				if(Link->Item[185] && !this->Data[411]){	//Lonk 2
					this->Data[411] = 1;
				}
				if(Link->Item[64] && !this->Data[157]){	    //Great Beast
					this->Data[157] = 1;
				}
				
				
                switch(WaitEvent())
                {
                    case GENSCR_EVENT_ENEMY_DEATH:
                        npc n = Game->EventData[GENEV_EDEATH_NPC];
                        int id = n->ID;
                        // Change ID for enemies that share an entry
                        switch(id)
                        {
                            case 22: id = 20; break; 	// Red Octorock
                            case 23: id = 21; break; 	// Blue Octorock
                            case 63: id = 62; break; 	// Gleeok
                            case 64: id = 62; break; 
                            case 92: id = 91; break; 	// Lakitu
                            case 110: id = 109; break;  // Fire Gleeok
                            case 99: id = 113; break;   // Fire Wizzrobe
                            case 94: id = 443; break;   // Bomb Wizzrobe
							//Left Facing
                            case 510: id = 58; break;   // Red Aquamentus
                            case 509: id = 341; break;  // Dancing Lion L2
							//Splitting Enemies
							case 504: id = 52; break;	// Vire L1
							case 505: id = 336; break;	// Vire L2
							case 506: id = 50; break;	// Darknut L2
							case 508: id = 159; break;	// Darknut L3
							//Bari
							case 183: // Bari L2
								if(!this->Data[id]){this->Data[id] = 1;}
								id = 182;
								break;
							case 315: // Bari L4
								if(!this->Data[id]){this->Data[id] = 1;}
								id = 314;
								break;
                        }
                        if(!this->Data[id])
                            this->Data[id] = 1;
                        break;
                }
            }
        }
    }

