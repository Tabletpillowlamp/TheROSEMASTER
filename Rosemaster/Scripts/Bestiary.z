    // Descriptions for all bestiary entries by ID
    void Bestiary_Description(char32 buf, int id)
    {
        switch(id)
        {
            case  38: // 001 Keese (L1)
                sprintf(buf, "They are common creatures worldwide. You'll find them just about everywhere. They are simple minded and are generally harmless, unless you touch them.");
				break;
			case  40: // 002 Keese (L2)
				sprintf(buf, "These keese have a special diet that makes them more lethal to the touch. More common in Hyrule, some homeless folks in the outlands regrettably hunt and eat them.");
				break;
			case  90: // 003 Keese (L3)
				sprintf(buf, "Keese that live long enough develop a potent toughness that makes them more harmful to the touch. They usually live as the leader in the pack, often residing in the deepest depth of dungeons.");
				break;
			case 185: // 004 Popo (L1)
				sprintf(buf, "These strange plant like creatures will slowly move to targets they find as food. Studies show that they are closely related to sea sponges, but have adapted to exclusively live on land.");
				break;
			case 186: // 005 Popo (L2)
				sprintf(buf, "Long exposure to the sun allows these specific types of popo to store more energy. This allows them to move much faster and deal more damage. Despite all of that, they still do not have brains.");
				break;
			case 187: // 006 Popo (L3)
				sprintf(buf, "The most threatening variant of popo, they live in damp dark places. It is unknown where they get their energy from. Some studies claim that they store dark matter, which allows them to move in very fast bursts.");
				break;
			case  41: // 007 Stalfos (L1)
				sprintf(buf, "These boney little guys were once humans. Legends say that those who have made a deal with the devil turn into stalfos when they die.");
				break;
			case  79: // 008 Stalfos (L2)
				sprintf(buf, "Stalfos with unusually bad karma can gather enough energy to shoot out a burst of magic. The magic however, can easily be blocked by a big shield. Still, these blue armored boney guys will keep on fighting.");
				break;
			case 120: // 009 Stalfos (L3)
				sprintf(buf, "Their immense lust for power has turned their bones blue. They effortlessly wield powerful energy shots. However, it comes at a cost, for they now are very weak to light. A very heavy price to pay for them turning into a boney blue guy.");
				break;
			case 479: // 010 Stalfos (L4)
				sprintf(buf, "The premier boney guy. It does not care for pure raw power. It prioritizes looking absolutely fabulous, and who can blame them? Even the cheapest piece of bone on them is measured to be 99.97 percent pure and is worth 100 million rupees.");
				break;
			case 160: // 011 Rat
				sprintf(buf, "Rats have a life expectancy of two to four years. Despite how short they live, they are chonky little bundles. Fun Fact: When they stop, there's a 50 percent chance they will squeak, can you hear it?");
				break;
			case  20: // 012 Octorok (L1)
				sprintf(buf, "They suck in rocks and mold them into tiny little balls that they can use as a projectile. One might think they use this as a defense mechanism, but actually, they just do it because they're bored. Also, if you are really hungry, do NOT eat octoroks.");
				break;
			case  21: // 013 Octorok (L2)
				sprintf(buf, "Octoroks who eat too much do not gain weight, instead all the excess body fat turn into special energy that turns their skin blue, hence why they have more health. For many years, scientists tried to replicate this energy for human models, but to no use.");
				break;
			case 139: // 014 Octorok (L3)
				sprintf(buf, "Octoroks are smart creatures, some even study in schools. Those who graduate from the finest wizardry schools turn purple and can shoot out magic. They are partly responsible in turning the Tower of Fiends into a sophisticated place of learning.");
				break;
			case  25: // 015 Tektite (L1)
				sprintf(buf, "They are rather harmless arachnids despite their large size. They jump all day long, always jumping. Some studies show that if they stop jumping, their heart stops.");
				break;
			case  24: // 016 Tektite (L2)
				sprintf(buf, "These red tektite variants reside in mountainous regions. As a result of their geography, these tektites are known to jump higher and more often. Still, they seem to continue to always jump without any explanation.");
				break;
			case  42: // 017 Tektite (L3)
				sprintf(buf, "These variants are said to have come from a far away land known as Australia. A place where the most dangerous of animals live. They weren't imported here, historians cite that they got bored and started to hop through the ocean to get here.");
				break;
			case  26: // 018 Leever (L1)
				sprintf(buf, "They spend most of their lives underground. Some people say that they have a highly developed society underground with schools, hospitals, and a government system. Such claims have yet to be proven, and it might be false due to them lacking brains.");
				break;
			case  27: // 019 Leever (L2)
				sprintf(buf, "Despite being physically stronger, they lack the spatial awareness of their red brothers. These leevers will wander aimlessly once they pop out from the sand. Studies show it may be due to their higher sensitivity to light.");
				break;
			case 137: // 020 Leever (L3)
				sprintf(buf, "These leevers are the most aggressive types in their species. They have a different diet consisting of meat, which may explain their faster beelining speed towards anything that moves.");
				break;
			case  44: // 021 Rope (L1)
				sprintf(buf, "Ropes are basically just snakes, when they see a prey in its line of direction, it will sprint and quickly charge towards them. They do not see other living beings as friends, only food.");
				break;
			case  80: // 022 Rope (L2)
				sprintf(buf, "Ropes that train to be more venomous turn green. Often used as traps, particularly in the Ancient Maze, where the place was expertly designed to store a bundle of them on the ceiling, attacking unexpecting visitors.");
				break;
			case 373: // 023 Rope (L3)
				sprintf(buf, "Ropes that have reached a certain point of enlightenment will turn a majestic blue and gain the ability to shoot out powerful magic. Even though they gained such tremendous power, they behave very much like any other normal rope.");
				break;
			case  28: // 024 Moblin (L1)
				sprintf(buf, "Boars that have evolved to walk on two legs become moblins. The distinct factor that sets them apart from other feeble minded creatures is their ability to forge weapons like spears and throw them.");
				break;
			case  29: // 025 Moblin (L2)
				sprintf(buf, "They are intelligent boars that have built a primitive civilization for themselves in Elignita Field. Their most sophisticated creation, known as the 'Moblin House' was a technological feat like no other.");
				break;
			case  45: // 026 Goriya (L1)
				sprintf(buf, "They are fierce rivals of moblins, often fighting for territory in the untamed fields. They refuse to use spears, seeing them as barbaric. Instead, the boomerang is their weapon of choice.");
				break;
			case  46: // 027 Goriya (L2)
				sprintf(buf, "Goriyas that have won many battles against moblins are painted blue and given a green tunic. This symbolizes the courage they possess. It is most likely a reference to the one and only 'Hero'.");
				break;
			case 245: // 028 Goriya (L3)
				sprintf(buf, "Goriya who rely too much on throwing their boomerang turn into these variants. Zealous forms that throw boomerangs every step they take. They are so crazy that they pretty much built an immunity to most weapons.");
				break;
			case 136: // 029 Goriya (L4)
				sprintf(buf, "This elusive variant of goriya is feared by their peers. They have mastered the art of the boomerang, and will strategically use them to wipe out an entire army of moblins.");
				break;
			case  32: // 030 Peahat
				sprintf(buf, "They are plant creatures that move by the wind. Meteorologists have used them in the past to predict the weather. But nowadays they mostly reside in natural areas barely touched by civilization.");
				break;
			case  53: // 031 Like Like
				sprintf(buf, "When they capture their target, like likes suck out the life energy of their victims before sloppily discarding them. It seems like their slow speed has contributed to their global population drop. As they are now classified as 'critically endangered'.");
				break;
			case 184: // 032 Buzz Blob (L1)
				sprintf(buf, "When active, they possess electrical energy that causes high voltage to anyone hitting it with a sword. Instead, first subdue this creature by stunning it with a boomerang.");
				break;
			case 237: // 033 Buzz Blob (L2)
				sprintf(buf, "These types of buzz blobs thrive in the cold, where their electrical energy stored in their bodies become a lot more potent. Some Rito have these guys in their houses as a power bank.");
				break;
			case  33: // 034 Zora (L1)
				sprintf(buf, "Unlike their sea counterparts, these river zoras became aggressive and learned the art of shooting various projectiles from their mouths. When they dive underwater, they have a light snack that regenerates their HP when they get back up.");
				break;
			case 268: // 035 Zora (L2)
				sprintf(buf, "These zoras are warm-blooded, unlike their peers. Despite that, they still live in habitats not suited for them. Because of this, they store the heat in their bodies and release them when out of the water, turning it into fire.");
				break;
			case 322: // 036 Zora (L3)
				sprintf(buf, "These zora dwell mostly in the cities and have a healthy diet of trash. Their body materializes the food they eat into bombs. You might say they sure have an explosive appetite, but it's really just their way of living.");
				break;
			case  88: // 037 Gel
				sprintf(buf, "A tiny blob that is about 4 cm tall. They dissolve when hit by just about anything. It's understandable why gels huddle together to transform themselves into zols after some time.");
				break;
			case  89: // 038 Zol
				sprintf(buf, "The amalgamation of a gel that has gathered enough dust and trash. They are quite bulky and will often turn into gels when hit. But with a very strong attack, they might just instantly disintegrate.");
				break;
			case 196: // 039 Eyegore (L1)
				sprintf(buf, "They are tough creatures that work as guards. Eyegores tend to hate moving around, so when they do have to be mobile, they become irritable. As the name suggests, they are weak to arrows, and one shot may turn their eyes quite gory.");
				break;
			case 197: // 040 Eyegore (L2)
				sprintf(buf, "These hulking giants are vulnerable to very few weapons when they open their eyes. It makes you wonder why they don't just keep their eyes closed the entire time. Perhaps they have developed ethics and want to play the game fair.");
				break;
			case 240: // 041 Eyegore (L3)
				sprintf(buf, "The premier eyegore. Other eyegores look up on them with the utmost respect. When they move, they focus on killing their target, even if it means exposing their weak eye spot. While arrows are their main weakness, magic is also effective.");
				break;
			case 181: // 042 Bari (L1)
				sprintf(buf, "They are jellyfish like creatures that store massive amounts of electricity. As a way to recharge their energy, their bodies may sometimes spew out heavy voltage, heavily damaging anyone who touches it.");
				break;
			case 182: // 043 Bari (L2)
				sprintf(buf, "These variants can split into smaller versions of themselves when hit. All while still possessing the same electrical energy as their blue counterparts. It is unknown why they split when hit. But it could be some form of defense.");
				break;
			case 183: // 044 Bari (L2, Biri)
				sprintf(buf, "The tiny form of the red bari. Some scientist got lazy one day and just wanted to go home, so they hastily came up with the name 'Biri', even though they are part of the same bari creature.");
				break;
			case 264: // 045 Bari (L3)
				sprintf(buf, "These bari act very much like any other ones, with a few exceptions. They not only emit more damaging electricity, but they are also a lot more resilient to common weapons. Research shows that their diet makes them tougher.");
				break;
			case 314: // 046 Bari (L4)
				sprintf(buf, "The strongest variant of bari. They act similarly to their red counterparts, where they split when hit. But there has been no proof that this is a form of defense mechanism. In fact, they probably do this just to troll people.");
				break;
			case 315: // 047 Bari (L4, Biri)
				sprintf(buf, "Residual of the green bari. One would think by splitting into two, the biris would inherit half of the bari's organs. In actuality, one carries the brain and heart, and the other carries the spinal cord. Wait, what? Baris have spinal cords? Yes!");
				break;
			case 195: // 048 Beamos (L1)
				sprintf(buf, "The eye that spins around the statue is a living organ. They live to spin all day, every day to shoot lasers at its target. Legends say that if the eye stops moving, then its heart will stop beating.");
				break;
			case 280: // 049 Beamos (L2)
				sprintf(buf, "The orange color of the statue causes the eye to act a lot more erratic for some reason. Perhaps the eye hates the color orange. Either way, it's not only speed that increases, but the lasers it shoots is a lot more damaging.");
				break;
			case 199: // 050 Anti-Fairy (L1)
				sprintf(buf, "A fairy that is condemned by God turns into this evil creature. When it attacks its target, they may lose some magic. This is due to its fairy powers acting haywire and causing a fragmentation in its magical attributes.");
				break;
			case 329: // 051 Anti-Fairy (L2)
				sprintf(buf, "Only a holy weapon like a boomerang can turn these creatures back to their original fairy forms. When they revert back into a fairy, they lose all memories and just wander aimlessly, waiting to be captured by a bug net.");
				break;
			case  37: // 052 Armos
				sprintf(buf, "Statues that are not taken care of manifest into living hateful creatures that charge towards its target. Some say this is the work of dark magic, but perhaps the dark magic was the human neglect and lack of love.");
				break;
			case  39: // 053 Crow (L1)
				sprintf(buf, "They patiently wait to strike a target they deem meaty and worthy. Some of them probably wait too long and starve to death. Really makes you wonder if this specific type of crow is actually intelligent.");
				break;
			case 258: // 054 Crow (L2)
				sprintf(buf, "They act very much like their blue counterparts, but with one difference, when they wait patiently for their target, they lift weights on the side. That is why they are far tougher and deal a lot more damage.");
				break;
			case 204: // 055 Wakata (L1)
				sprintf(buf, "The wakata are long beaked creatures that walk continuously until the day they die. Their purpose in life is to walk and walk all day. In fact, if they stop walking, their heart will stop beating.");
				break;
			case 214: // 056 Wakata (L2)
				sprintf(buf, "Wakata that have walked 500 marathons in their lifetime will turn into these variants. Their speed and power increases, but they never stray away from their ultimate purpose in life, that is of course walking.");
				break;
			case 333: // 057 Wakata (L3)
				sprintf(buf, "In 1837, several Wakata formed a committee where they discussed if maybe they should change their behavior from 'walking' to 'running'. This sparked a massive outrage in the wakata population, leading to many internal wars... of walking.");
				break;
			case  49: // 058 Darknut (L1)
				sprintf(buf, "Once feared warriors, darknuts now wander throughout the world without a home. Advanced techniques in sword slashing have caused their shield formation to be easily exploited. Still, some have adapted by shooting energy beams.");
				break;
			case  50: // 059 Darknut (L2)
				sprintf(buf, "Darknuts have built a new strategy with the help of their friends, the zols. Two red darknuts would use the power of fusion to transform into an ironclad blue darknut. Far more powerful now, they have a rather large ego.");
				break;
			case 159: // 060 Darknut (L3)
				sprintf(buf, "These final forms of darknut start with four red darknuts in a bar discussing the great idea of fusion. Two pairs would fuse into blue variants, and those darknuts would fuse into the ultimate form. Quite the plan, isn't it?");
				break;
			case 165: // 061 Mad Darknut
				sprintf(buf, "These rouge darknut isn't like the others. They developed a new strategy based on speed and offense. Ironically, this new artform of fighting has allowed them to resist most weapons. But they have one weakness; a very sharp sword.");
				break;
			case  60: // 062 Dodongo
				sprintf(buf, "'Dodongo dislikes smoke, try to think what causes smoke.' For centuries, brave warriors died to dodongos because they did not know what it's weak to. That was until a very smart old man gave that powerful hint.");
				break;
			case  54: // 063 Gibdo (L1)
				sprintf(buf, "They are desert dwellers who excel in defense. When hit with fire, they turn into stalfos, exposing the truth that all the undead are no different from one another. It is unknown why some stalfos choose to become gibdo.");
				break;
			case 335: // 064 Gibdo (L2)
				sprintf(buf, "Their red tint emitting from their wraps are formed by extreme heat. When exposed to fire, these gibdo turn into fire snakes. Perhaps this disproves the idea that all undeads are the same, or maybe this kind of gibdo is not undead.");
				break;
			case  52: // 065 Vire (L1)
				sprintf(buf, "Keese that have formed some form of intelligence turn into vires. The vire's form is rather fragile, so one hit may revert them back into their primitive bat form. Some say that black magic is the cause for their transformation.");
				break;
			case 336: // 066 Vire (L2)
				sprintf(buf, "When two powerful red keese fuse together, they become this form of vire that can shoot fire while jumping around. There is discussion whether or not a vire is made of two living keese or are just one organism. Maybe just ask them?");
				break;
			case  48: // 067 Wall Master (L1)
				sprintf(buf, "They are rather odd creatures that grab trespassers from above to bring them back to the entrance. One would think maybe it's a better idea to just kill its target instead. But perhaps they do this as a form of mental torture.");
				break;
			case  65: // 068 Wall Master (L2)
				sprintf(buf, "Wall masters that live in corrupted ceilings turn green and become immune to most weapons. But the most potent effect on them is the huge increase in frequency and speed of their grabbing ability. Up to a point where it could be annoying.");
				break;
			case 231: // 069 Poe (L1)
				sprintf(buf, "Spirits of the dead materialize into a poe. The candle they carry represents the sorrow and regret of all the souls without a home. It searches for those with a pure heart to take over and corrupt.");
				break;
			case 230: // 070 Poe (L2)
				sprintf(buf, "Exceptionally corrupted souls form into this variant of poes. The evil aura becomes unstable, and the undead creature must release some of them in the form of a black flame. The flame corrupts anyone who touches it.");
				break;
			case 198: // 071 Macer (L1)
				sprintf(buf, "Macers are simple creatures that one day found a mace on the ground. As they swing the mace, they become obsessed. Even stopping daily tasks like eating and drinking just to swing their little fidget until the day they die.");
				break;
			case 236: // 072 Macer (L2)
				sprintf(buf, "Macers who have swung enough of their mace have transformed their bodily functions to act as one with the mace swing. They swing their mace all day, every day. If they stop swinging, their heart stops beating.");
				break;
			case  59: // 073 Moldorm (L1)
				sprintf(buf, "They developed a highly integrated body system where if one segment of their body is damaged, it simply discards it until it's just a head. It's important to strike the end of the moldorm first.");
				break;
			case 255: // 074 Moldorm (L2)
				sprintf(buf, "As a moldorm lives in peace and maintains a healthy diet, it not only becomes a very long boy, but also gains a significant speed boost. That is why when it finally starts taking damage again, it becomes extremely aggressive.");
				break;
			case  75: // 075 Fire Snake
				sprintf(buf, "These are not living beings, they are simply just a natural phenomenon where fire forms into a beast due to climate change. Could this be nature's way of punishing humanity? Or maybe it's a sign that life is always fragile.");
				break;
			case 188: // 076 Ropa (L1)
				sprintf(buf, "These creatures look like sea anemones but live on land. They have developed into aggressive carnivores that feed on only the most courageous of warriors. Their hopping patterns may appear erratic, but actually, they just have no plan.");
				break;
			case 189: // 077 Ropa (L2)
				sprintf(buf, "The redness of their bodies shows a strong desire for blood. Or perhaps it actually is blood on them and they just recently devoured their victim. Either way, a successful hunt makes these ropa very aggressive and makes them crave for more.");
				break;
			case 190: // 078 Ropa (L3)
				sprintf(buf, "Ropas that have mastered the art of unpredictable jumping turn into these monstrosities. Their jumping is so erratic, some brave warriors made it an effort to hunt these kinds down. Nowadays they are rare, but also dangerous!");
				break;
			case 216: // 079 Frog
				sprintf(buf, "Frogs are tailless, amphibious vertebrates belonging to the order Anura. Famous for their long hind legs adapted for jumping and bulging eyes, they are cold-blooded creatures that breathe through their moist skin. With nearly 8,000 species worldwide.");
				break;
			case 138: // 080 Fire Kodongo (L1)
				sprintf(buf, "The dodongo, the absolute unit it is, have garnered a lot of popularity back in the old days. One such group, known as the kodongos tried to replicate their lifestyle to match that of the dodongo, despite being different creatures."); 
				break;
			case 323: // 081 Fire Kodongo (L2)
				sprintf(buf, "Kodongos who spit out powerful flames gain respect among the crowd and become leaders of the pack. As their influence from the dodongo dwindles, they have built a new identity, one of flame spitting.");
				break;
			case 259: // 082 Ice Kodongo (L1)
				sprintf(buf, "These creatures were once one of the same with their fire variant, but they had a civil war and the ice faction veered off, establishing their own identity. One where they shoot ice instead of fire. The difference, however, is negligible.");
				break;
			case 343: // 083 Ice Kodongo (L2)
				sprintf(buf, "Powerful ice kodongos rank up to become this form. Some of them argued that to distance themselves with the fire kodongos, they should call themselves the 'coldongos' but the elder ice kodongos found that change to be too corny.");
				break;
			case 193: // 084 Hardhat Beetle (L1)
				sprintf(buf, "These creatures carry a large orb on top of their heads which allows them to be quite resistant. It is said that the orb is made of sapphire and can net very high prices in the black market.");
				break;
			case 194: // 085 Hardhat Beetle (L2)
				sprintf(buf, "The red orb allows these creatures to take a lot more hits than their blue counterparts. Their diet consists of mostly rocks, which they consume to absorb its nutrients. The leftover mineral is used to repair any damages to its orb.");
				break;
			case 334: // 086 Hardhat Beetle (L3)
				sprintf(buf, "The toughness of the green orb they carry is unmatched, drastically increasing their damage potential. Despite their toughness, they are susceptible to many strong weapons. As the orb reacts violently to them.");
				break;
			case 496: // 087 Hardhat Beetle (L4)
				sprintf(buf, "Hardhat beetles that carry their orb long enough manifest into this ultimate form, where their toughness exceeds the metaphysical concept of what was previously known. The bloodshot eyes represent their unyielding endurance.");
				break;
			case 201: // 088 Fairy Master
				sprintf(buf, "Fairy masters were once maidens who wandered off too deep into the forest. Surrounded by fairies, the maidens learned the art of throwing explosive fairies and went mad. The fairy energy in them suppresses their humanity.");
				break;
			case 261: // 089 Hokkubokku (L1)
				sprintf(buf, "This creature was tired of being called a 'pokey' in its universe, so it decided to find its way here in this world. Scientists are baffled on how the segments in its body work.");
				break;
			case 345: // 090 Hokkubokku (L2)
				sprintf(buf, "Each segment contains one of the Hokkubokku's senses. As they lose more segments, they slowly start to lose their identity. Ultimately, they turn into a jumping head, having no care for the world.");
				break;
			case 347: // 091 Hokkubokku (L3)
				sprintf(buf, "Some say that these are the healthiest kind of hokkubokku, even when they get split apart, the segment bounces as if it was full of life. There has been no recorded evidence of a hokkubokku regenerating its segments.");
				break;
			case  36: // 092 Ghini
				sprintf(buf, "When a spirit lies between the metaverse and the real world, it becomes a ghini. It is immune to almost every weapon. The cool factor of this creature inspired an Italian car brand to name their cars after it, the Lambor'ghini'.");
				break;
			case 229: // 093 Zombie (L1)
				sprintf(buf, "A body of a dead human reanimates into this when their desire for rampage overshadows their need to rest eternally. Such abominations need to be put to rest by force, otherwise, their desires may inspire other corpses.");
				break;
			case 252: // 094 Zombie (L2)
				sprintf(buf, "As the body continues to deteriorate the longer they stay reanimated, the foul stench turns them a lot more aggressive and powerful. There they will wait until the perfect moment to pop out from the ground to strike its target.");
				break;
			case 238: // 095 Evil Knight (L1)
				sprintf(buf, "Back in the Elignita Hyrulean war, these soldiers were noble mercenaries. After the ceasefire, they had no purpose. Disgruntled knights wandered the nations and became rogue. As they become more violent, they lose their humanity.");
				break;
			case 332: // 096 Evil Knight (L2)
				sprintf(buf, "Some evil knights formed gangs and established undergound networks where they rule as a small community. Many of these evil knights are responsbile for various terrorist attacks in both Hyrule and Elignita.");
				break;
			case 497: // 097 Evil Knight (L3)
				sprintf(buf, "Back during the war, exceptionally powerful mercenaries like these knights were banished to the Starlight Express after the ceasefire. Their hatred grew as time went on. Some consider them not only evil, but a manifestation of death itself.");
				break;
			case  30: // 098 Lynel (L1)
				sprintf(buf, "The infamous lynel, half horse, half demon, represents the pride of the two nations and is officially the national animal of Hyrule. Still, they are widely hunted by daredevils as their meat sell for a lot in the black market.");
				break;
			case  31: // 099 Lynel (L2)
				sprintf(buf, "These rarely seen lynels only inhabit places where the air looms in despair. They feed on death and destruction, which powers them up to a an immeasureable rate. The sword they swing was created by the gods themselves.");
				break;
			case  56: // 100 Red Wizzrobe
				sprintf(buf, "Any creature who masters the art of magic can turn into these little guys. Found commonly in dungeons, groups of wizzrobes specialize in the art of asynchronous teleportation. This makes them appear a lot tougher than they actually are.");
				break;
			case 243: // 101 Purple Wizzrobe
				sprintf(buf, "The purple wizzrobe likes to play it simple. When it was still in wizardry school, it learned the fireball shot, and has since then hyperfocused on mastering that technique. Sadly, fireballs aren't as scary as actual magic.");
				break;
			case  57: // 102 Blue Wizzrobe
				sprintf(buf, "The blue wizzrobe looks down upon their purple brothers. Despite having the same stats, the blue wizzrobe sees itself as objectively superior with their faster magic shots. Blue wizzrobes adapt to their environments, no matter what.");
				break;
			case 100: // 103 Green Wizzrobe
				sprintf(buf, "The green wizzrobes were class clowns back in wizardry schools, where they would pull cruel pranks on their peers. That might explain why their specialty is wind that sends its target back to the entrance, those pesky clowns!");
				break;
			case 113: // 104 Fire Wizzrobe
				sprintf(buf, "Wizzrobes who are exceptionally gifted learn the black magic of 8-way flame shot. Because of the immense amount of energy it emits, each shot takes 1.5 years away from the wizzrobe's lifespan, but they don't care. Power is truly everything to them.");
				break;
			case 443: // 105 Black Wizzrobe
				sprintf(buf, "These wizzrobes dropped out of wizardry school, not because they didn't have the skills, but out of boredom. They are natural savants in their field. But why do all of them specialize in the art of bomb making?");
				break;
			case 358: // 106 Terrorpin (L1)
				sprintf(buf, "Their hard shells make them immune to almost every attack. Only a strike from the hammer can flip them over and expose their weak spots. The genius who invented the megaton hammer must really hate these little guys.");
				break;
			case 390: // 107 Terrorpin (L2)
				sprintf(buf, "Some terrorpins adapt to their inevitable hammer weakness by mastering the art of 8-way fireball shots. These shots prove to be effective against hammer wielders, exploiting the weakness in how users can approach with said weapon.");
				break;
			case  85: // 108 Green Fire
				sprintf(buf, "The glowing manifestation created by the sacred fiend of wrath. They are impervious to most weapons, but the gust of wind produced by the almighty megaton hammer carry so much aura it can suppress the green fire's immunities.");
				break;
			case 176: // 109 Blue Fire
				sprintf(buf, "Blue fires are very much like green fires, but are hotter. Produced by the almighty demon duke Dantalion, they have improved resistance and can withstand two gusts of wind from the megaton hammer.");
				break;
			case 256: // 110 Flare (L1)
				sprintf(buf, "These rejected wizzrobes carry a weight of unfulfillment and hatred. They manifest their hate into fire magic. Even though they practice the art of black magic and wear robes, they do not have the wizzrobe mindset.");
				break;
			case 338: // 111 Flare (L2)
				sprintf(buf, "Flares who live long enough get promoted to these variants. The blue robes they wear are sacred and are supposed to represent high status within their small tight-knit community. Some establish their own religion, worshipping the flame.");
				break;
			case  55: // 112 Pols Voice (L1)
				sprintf(buf, "These tiny rabbit-like creatures have very sensitive ears. One might think they are weak to loud noises. In truth, they are aichmophobic, and faint at the sight of a sharp object, like an arrow.");
				break;
			case 414: // 113 Pols Voice (L2)
				sprintf(buf, "Pols Voices are native to the moon, but some decide to make themselves at home on earth. Those who stay here on this blue planet become stronger due to stronger gravity. This requires them to build more muscle to jump higher.");
				break;
			case 263: // 114 Luciby (L1)
				sprintf(buf, "This cute little ice fairy loves to teleport around. They make sure their ice shots are heart-shaped before they throw it. In luciby culture, hearts represent a war cry, sending a declaration of war to its target.");
				break;
			case 310: // 115 Luciby (L2)
				sprintf(buf, "As a luciby gains more fighting experince, they turn purple and gain the power of electricity. Many go on to fight using their newfounded powers. But some return home to power up the houses of their families. I mean... it's free electricity!");
				break;
			case 408: // 116 Luciby (L3)
				sprintf(buf, "These variants of luciby have chosen an alternative path to power. They learned the art of flames and have become the element's most fearsome wielders. Their strategic way of encircling themselves in flames prove to be a powerful defensive technique.");
				break;
			case 265: // 117 Horse Head (L1)
				sprintf(buf, "Horse heads are powered by magic energy. As the energy depletes, the horse head turns into stone, waiting to be powered up once more. However, when active, any type of magic can cause it to overflow and dissolve.");
				break;
			case 342: // 118 Horse Head (L2)
				sprintf(buf, "The special coating on these specific horse statues violently reacts to magic. When awakened, the horse head absorbs the coating and gains a large amount of power and speed. They become more focused and aggressive.");
				break;
			case 300: // 119 Kaguya (L1)
				sprintf(buf, "The beautiful lunar princess was born inside a bamboo and was taken in by two human parents. She then had to return to the moon. There she reverted back to her true form, one with the bamboo.");
				break;
			case 350: // 120 Kaguya (L2)
				sprintf(buf, "This particular form of Kaguya found an obsession with carrots. Carrots quickly became her favorite plant, overshadowing her bamboo identity. Instead of restructuring her anatomy to be a carrot princess, she instead just painted the bamboos orange.");
				break;
			case 274: // 121 Critter (L1)
				sprintf(buf, "These little creatures are lizard-shaped, but one can hardly call them actual lizards. They move, turn, and stop at unpredictable rates. Some consider them as pests that live in buildings that are poorly kept.");
				break;
			case 367: // 122 Critter (L2)
				sprintf(buf, "These critters can live up to 90 years feeding on nothing but the mold on building walls. When a building gets too old, critters collectively migrate from one building to another. often carrying essential food like cardboard and trash.");
				break;
			case 279: // 123 Hyu (L1)
				sprintf(buf, "They are the crazy cousins of poes who found the thrill of spewing out fire. They shoot fire in two patterns, '+' shaped and 'x' shaped. Every night, it prays to the gods that some day it can shoot out both patterns at the same time.");
				break;
			case 292: // 124 Hyu (L2)
				sprintf(buf, "Hyus who decide to learn a new skill unlock the ability to reanimate. They can call L1 Zombies to do their bidding as they shoot out flames. Perhaps the flames they shoot out are the souls of the zombies they summon, one of the same.");
				break;
			case  82: // 125 Hyu (L3)
				sprintf(buf, "Hyus that pray every night for enhanced firepower get blessed by the gods and turn red. With their newfounded power, they have the ability to shoot flames in eight directions all at once. Every night, the hyu thanks the gods for their newfounded power.");
				break;
			case 455: // 126 Hyu (L4)
				sprintf(buf, "These hyus were sent by the gods themselves to punish humanity for their sins. Their flames burn with light, and they have the ability to summon L2 zombies. They represent the ultimate spirit incarnate.");
				break;
			case 278: // 127 Phantom Knight (L1)
				sprintf(buf, "These ghostly knights appear only when someone steps on their button trap. It takes them 2 weeks to set up that trap, so that might explain why they get so angry when someone steps on it.");
				break;
			case 450: // 128 Phantom Knight (L2)
				sprintf(buf, "Studies show that the traps are actually biologically part of the phantom knight. they are one and the same, in fact, the trap might just be one of the most sensitive areas of the knight. So stepping on their trap must be painful to them.");
				break;
			case 283: // 129 Keese Master (L1)
				sprintf(buf, "These creatures were once lonely little guys. One day, they found a keese and formed a close friendship with them. Over time, they developed a symbiotic relationship with the keese species, and now, they fight together.");
				break;
			case 191: // 130 Keese Master (L2)
				sprintf(buf, "Keese masters who befriend red keese paint themselves red as a way to show respect to the keese species. When they summon red keese, they use a special teleportation spell that sends the keese from their home out to where ever the keese master is.");
				break;
			case 423: // 131 Keese Master (L3)
				sprintf(buf, "When this keese master unleashes its swarm attack, it specifically commands the keese to move in a slightly tilted pattern to inflict maximum damage to the target. Such strategies like this are considered a war crime.");
				break;
			case 206: // 132 Hyrulean Soldier (L1)
				sprintf(buf, "Red soldiers like these are the lowest ranked soldiers in the Hyrulean army. They are armed with the basic M4A1 Carbine rifle. Their aim is rather bad, but that is because they only had 2 months of training.");
				break;
			case 289: // 133 Hyrulean Soldier (L2)
				sprintf(buf, "Hyrulean soldiers with a slightly higher rank are given blue uniforms and a flamethrower. Their primary goal is to burn down foliage to make the terrain easier to navigate. However, their flamethrowers tend to not be powerful enough to do this.");
				break;
			case 290: // 134 Hyrulean Soldier (L3)
				sprintf(buf, "These soldiers are in a special defense force, known as the 'delta jump force'. For every round of shots they take, they are required to jump. They are given special combat boots that allow them to jump higher.");
				break;
			case 288: // 135 Hyrulean Soldier (L4)
				sprintf(buf, "These soldiers are one of the highest ranks and have acted as Rusl's personal bodyguards. They all have at least five years of military service training and learned the special technique of the spread shot.");
				break;
			case 291: // 136 Hyrulean Soldier (L5)
				sprintf(buf, "Blue soldiers who are exceptionally skilled at burning foliage are given green uniforms and are told to just burn whatever they see fit. They are rather unconventional fighters of the Hyrulean army, but they sure are effective.");
				break;
			case 286: // 137 Hyrulean Tank
				sprintf(buf, "The preferred vehicle of choice for the Hyrulean army, this machine can withstand the roughest of terrains and carry a large ammunition capacity. They are nearly resistant to almost every weapon, but it comes as a sacrifice in speed.");
				break;
			case 316: // 138 Pikit (L1)
				sprintf(buf, "Strange plant-like creatures that burst into eight fireballs when shot. Scientists ponder about their unusual anatomy. Some speculate that the fireballs are the pikit's internal organs, which burst into flames the moment this creature dies.");
				break;
			case 142: // 139 Pikit (L2)
				sprintf(buf, "These pikit's burst fireballs are a lot more damaging. This could potentially be a result from poor diet and their preferred home in the dark. As their organs start to fail, more energy is needed to make them function normally.");
				break;
			case 309: // 140 Zirro (L1)
				sprintf(buf, "When a zirro eats food, they do not have a way to discard its waste. As a result, they must spit it out. However, the digestive process of this species makes the waste extremely explosive, so that's why they spit out bombs.");
				break;
			case 153: // 141 Zirro (L2)
				sprintf(buf, "When the weight of the explosives becomes too much for its feeble body, it spits them out in a glorious fashion. Standing close to this zirro when it is about to spit out its bombs is a good way to avoid this attack.");
				break;
			case 448: // 142 Zirro (L3)
				sprintf(buf, "This zirro lives in the stratosphere. Because gravity works differently there, they have learned to convert their waste into pure energy instead of explosives. So when they spit out projectiles, it becomes colorful space beams.");
				break;
			case 318: // 143 Zazak (L1)
				sprintf(buf, "These lizard enemies are actually quite intelligent, despite their aloof personality. They were once trained under the dark lord of Hyrule and banished to the golden land. But once they broke free, they just wandered around.");
				break;
			case 294: // 144 Zazak (L2)
				sprintf(buf, "These powerful variants of zazaks have increased mobility and more aggressive flame spitting. They worked as the dark lord's right hand man until the hero of Hyrule caused a major split in the faction. Now they just wander around aimlessly.");
				break;
			case 319: // 145 Hinox (L1)
				sprintf(buf, "They are usually gentle giants until they see a target worth attacking. Despite being a hulking giant with massive attacking power, they prefer to throw bombs at their target. Could this be due to insecurity?");
				break;
			case 121: // 146 Hinox (L2)
				sprintf(buf, "With its eye fully exposed, they are susceptible to arrows. But to make up for this weakness, they go a little aggressive by throwing streams of bombs at targets. These variants are a lot more confident, and will often use a powerful charge attack.");
				break;
			case 313: // 147 Snapdragon (L1)
				sprintf(buf, "These plant creatures are rather chill, they just hop around. Contrary to popular belief, their hearts actually do not stop when they stand still. Maybe these little guys are just hyperactive and choose to jump all day, every day.");
				break;
			case 363: // 148 Snapdragon (L2)
				sprintf(buf, "Tired of their weaker brothers being abused, these snapdragons snapped and decided to fight back with leafy projectiles. While very damaging, the 'X' shaped pattern these leaves travel in make the attack quite predictable.");
				break;
			case 111: // 149 Snapdragon (L3)
				sprintf(buf, "When a snapdragon loses all hope for humanity, it turns into a violent gray color and significantly powers up its leaf attacks. They upgrade their attack to move in an 8-way pattern. The leaves are so sharp they can cut through steel!");
				break;
			case 162: // 150 Slugga (L1)
				sprintf(buf, "When a building gets abandoned, sluggas will usually reside there. The flames they produce are actually their farts. They must be really gassy boys. Just be grateful those flames aren't stinky.");
				break;
			case 166: // 151 Slugga (L2)
				sprintf(buf, "The green color of the flames they produce might come from a highly toxic compound found in their bodies. Despite being poisonous, Hyrule exports 30 million of these to France every year. There, they are considered a delicacy.");
				break;
			case 444: // 152 Slugga (L3)
				sprintf(buf, "This variant of slugga are ones that are near the end of their lifespan. The flames they produce have a noticeable odor of death. Despite all of that, crazy groups of people will still eat them every day.");
				break;
			case 351: // 153 Thief (L1)
				sprintf(buf, "District 4 has had a major crime problem ever since the Malo Corp. took over most of the city. These thieves will suck out every rupee from their target until they are killed. Such is the life of a criminal.");
				break;
			case 352: // 154 Thief (L2)
				sprintf(buf, "Hyrule's economy has been stagnant since 2008. Because of this, many people struggle financially and turn to a life of crime. As a person becomes a thief for a longer period of time, they lose their humanity.");
				break;
			case 353: // 155 Thief (L3)
				sprintf(buf, "The global economic recession has caused despair even to those who once had stable jobs. These thieves have previously worked for the IRS, so that might explain why they are so good at stealing money from other people.");
				break;
			case 328: // 156 Anti-Kirby
				sprintf(buf, "Is that Kirby from the hit series 'Kirby'? Perhaps yes? But it seems like these little puff balls are corrupted. Instead of sucking in their targets, they summon a rainfall of fire from the sky. Maybe Kirby was God's punishment to humanity...");
				break;
			case 140: // 157 Slarock
				sprintf(buf, "Octoroks who are exposed to radioactive elements turn into these malformed creatures. Native to the Eastern State, the Slarock's exsistance may come from the result of the famous nuclear explosion of 1986 in the Eastern State.");
				break;
			case 360: // 158 Witch (L1)
				sprintf(buf, "They use powerful light-element magic to strike down foes. These witches have no morals and made a deal with the devil to possess this wicked weapon. Often, their magic will malfunction and they shoot two arched magic that completely miss the target.");
				break;
			case 383: // 159 Witch (L2)
				sprintf(buf, "These witches ride on a crescent moon. The material is actually made up of moon rocks. Perhaps these witches found a way to get to the Lunar Garden? Or maybe, they ordered these moon rocks using the online shopping website, Malozon.");
				break;
			case 494: // 160 Witch (L3)
				sprintf(buf, "Witches who have mastered their magic turn into these variants. Their magic becomes so potent and powerful that they become the witch's only source of energy. No longer do they need to eat, drink, or sleep. The magic does it all.");
				break;
			case 364: // 161 Stink Beetle (L1)
				sprintf(buf, "He a stinky boy. When it dies, it releases damaging fumes. It's best to attack this enemy from a distance. Doing this will also allow the attacker to avoid its stinky breath attack.");
				break;
			case 415: // 162 Stink Beetle (L2)
				sprintf(buf, "He a very stanky boy. It acts very much like their purple brothers. Only this time, the fumes gain a deathly black odor. The strategy is still the same, attack from a distance. But they live in more cramped areas, which makes it harder to hit it.");
				break;
			case 320: // 163 Bomb-omb
				sprintf(buf, "The bomb-omb will explode when exposed to just about anything. It's more of a hazard than an enemy. Scientists were able to dissect a bomb-omb and found that they in fact do have organs. Some of them look frighteningly similar to a human's.");
				break;
			case 212: // 164 Nut Cracker
				sprintf(buf, "While this was a German invention, it was popularized by the 1892 Russian ballet of the same name. Inspired by its red patriotism, the Eastern State turned these guys into war machines armed with AK-47s. They just forgot to remove the Russian voicebox.");
				break;
			case 155: // 165 Plazmy
				sprintf(buf, "When hit, this electrical enemy becomes enraged and starts shooting out radioactive plasma. These plasma bolts turn into Yellow Bari-shaped bolts after some time. It's best to kill them as soon as possible.");
				break;
			case 365: // 166 Soviet Tank
				sprintf(buf, "These T-26 style tanks are the pride and joy of the Eastern State. They may be lightweight, but are easy to mass produce. The General Secretary Kalin once famously rode one of these when he was active during the war.");
				break;
			case 372: // 167 Armarry (L1)
				sprintf(buf, "The national bird and animal of the Eastern State. Radioactivity in the Eastern State has caused this two-headed bird to easily lose their feathers. But instead of lightly dropping their feathers, these war birds use them as powerful projectiles.");
				break;
			case 392: // 168 Armarry (L2)
				sprintf(buf, "It is unknown how these birds have two heads in the first place. Some say that long ago, scientists did an unholy experiment on two dead eagles in hopes to revive them. Now they live as one organism.");
				break;
			case 396: // 169 Star
				sprintf(buf, "This creature materialized from the arrogance or pride of Hyrulewood actors. The stars it shoots out represents the sins of wealthy celebrities that get way too much attention on tabloids and social media.");
				break;
			case  70: // 170 Uncle Sam
				sprintf(buf, "The embodiment of liberty and democracy, whatever that means. This creature was originally a CIA agent who made a deal with the devil. All he asked for was his second amendment rights and red, blue, and white colored freedom!");
				break;
			case 397: // 171 Chain Chomp (L1)
				sprintf(buf, "A popular pet that rich folks keep. Despite being responsible for 70 percent of all dog attacks, this vicious animal still hasn't been banned in Hyrule yet. All of this and Chain Chomp owners still insist their little 'cupcake' won't hurt a fly.");
				break;
			case 327: // 172 Chain Chomp (L2)
				sprintf(buf, "Particularly dangerous Chain Chomps are banished to the Astral Tower. Where they guard the realm of God. It's sad how easily people give up on their pets. Maybe they should consider chain chomp obedience school first before ditching them?");
				break;
			case 398: // 173 Muerte Doll (L1)
				sprintf(buf, "Advanced android-like dolls developed and based on the mad and vain inventor Miss Muerte. They are equipped with guns and are designed to be bodyguards. However, their cuteness is prioritized over actual proficiency.");
				break;
			case 405: // 174 Muerte Doll (L2)
				sprintf(buf, "This doll is five times more expensive than their L1 counterpart. Equipped with highly effective homing bullets, this doll is twice as lethal. Parents unknowingly buy this dangerous weapon for their kids just because it looks adorable.");
				break;
			case 413: // 175 Muerte Doll (L3)
				sprintf(buf, "Miss Muerte's latest version, ten times more expensive than the L2 counterpart, it comes with a feature designed for her superfans. This doll has the ability to perform massages and sing karaoke. It sold out in minutes.");
				break;
			case 118: // 176 Dancing Lion (L1)
				sprintf(buf, "The ancient Chinese tradition of two people dancing in a giant lion costume materialized into this demonic creature. It shoots out exquisite flames that arch in a beautiful pattern. One could say that being stylish is in the Dancing Lion's heart.");
				break;
			case 341: // 177 Dancing Lion (L2)
				sprintf(buf, "When the dancing lion masters the art of double flame spitting, it turns into a beautiful cool blue color. One can dodge their flame attack by standing in the correct position, but the real show is to watch how these flames move.");
				break;
			case  51: // 178 Shadgoon
				sprintf(buf, "These blobbed creatures were once a beautiful intelligent species. They had a thriving civilization in the desert. That was until Abaddon wrecked havoc and caused the population to barely survive. They guard the Ascalon, their only source of hope.");
				break;
			case  87: // 179 Deku Scrub
				sprintf(buf, "They are forest dwellers who are distant cousins of the octorok. When the Lost Woods rose up to the skies, these little guys had to quickly adapt to the elements of space. As such, they have became a bit stronger than their peers back on earth.");
				break;
			case  81: // 180 Wolfos
				sprintf(buf, "The proud canine of the forest howls when it is about to attack. Usually, they will use their agile speed to charge at their target. But often, they will also shoot fireballs which manifests from the sage powers of the forest.");
				break;
			case  91: // 181 Lakitu
				sprintf(buf, "Tired of being stuck in the Mario universe, this enemy turned to this world to see how annoying it could be. It is equipped with two new attacks. First, it shoots lightning bolts. Second, they throw exploding bomb-ombs.");
				break;
			case 122: // 182 Lady Mandrake (L1)
				sprintf(buf, "The lady mandrake is the manifestation of the forest's beauty. While it may look like a pretty lady, they are in fact plants. Their powers used to be a lot stronger back when the Lost Woods was cursed with Dark Energy.");
				break;
			case 359: // 183 Lady Mandrake (L2)
				sprintf(buf, "When this plant starts to wither, they turn orange and their attacks suddenly become a lot more lethal. Perhaps this came as a result of being exposed to humanity's sins and building up dark energy.");
				break;
			case 495: // 184 Lady Mandrake (L3)
				sprintf(buf, "These variants of lady mandrakes are the most powerful of their kind. The leaves they shoot are blessed by the gods themselves. They are also the most beautiful, with stunning locks and enticing looks that they use to lure in their targets.");
				break;
			case 135: // 185 Damngun (L1)
				sprintf(buf, "This specific model of the Damngun is the 2-87-XR. It comes equipped with a powerful laser shot and a gun that is condemned by the gods, hence why it is called the damngun. Despite that, it never actually uses the gun.");
				break;
			case 478: // 186 Damngun (L2)
				sprintf(buf, "This damngun is L1 Damngun's evil older brother. They once had an epic fight across the galaxy that lasted for 500 years. This damngun got pushed into a black hole during the fight, but sucked in its dark energy to become stronger.");
				break;
			case  35: // 187 Wosu
				sprintf(buf, "These wolf-like creatures grew up in Grass Land and train their whole lives to be the guardians of the Great Palace. They learn the ways of the Hero and test upon wandering travelers who seek the blessings of the TRIFORCE.");
				break;
			case 161: // 188 Fokkeru (L1)
				sprintf(buf, "These birds dance and dance until their feet start to burn and spew out fire. It takes a lot of practice to perform this type of fiery ritual. They train to be powerful and elegant, yet some people still call them 'spicy chickens'.");
				break;
			case 464: // 189 Fokkeru (L2)
				sprintf(buf, "These spicy chickens perfected the art of fiery dancing, their feet can produce more powerful green flames that have further reach. When they get angry, they spit out this fire from their mouth. Now that's really spicy!");
				break;
			case 227: // 190 Fokka (L1)
				sprintf(buf, "The feared guardians of the Great Palace, with a variety of attacks in their arsenal. Their katanas are folded 1,000 times in pure Japanese steel. Contrary to popular belief, they are a different species to the Rito.");
				break;
			case 277: // 191 Fokka (L2)
				sprintf(buf, "Despite being humanoid birds like the Ritos, Fokkas are ten times more intelligent. This can be demonstrated by the Blue Fokka, who has perfected the deadly technique of combining devastating attacks with jumping.");
				break;
			case  73: // 192 Ninji
				sprintf(buf, "The hidden assassins of the Great Palace, they ambush unexpecting trial goers on the top floor where movement is more limited. They have excellent agility, so striking them with ranged weapons is the key in defeating them.");
				break;
			case  76: // 193 Mago
				sprintf(buf, "The evil priest of the Great Palace guards the TRIFORCE with its life. They all serve the magus Heavenly King, and in turn are blessed with a piece of magic power from the golden treasure itself.");
				break;
			case  72: // 194 Soldier Spirit (L1)
				sprintf(buf, "The battle in the Capital a year ago caused many casualties, while the entirety of the Elignitan army was wiped out, Hyrule took a devastating hit as well. The souls of the enemy soldiers wail in agony as they wander around in the station for eternity.");
				break;
			case 354: // 195 Soldier Spirit (L2)
				sprintf(buf, "Blue soldiers who had perished in the battle a year ago wander around with the flamethrowers fully loaded. They have no care for the world, and only want to watch the world burn. They burn, burn, burn until they lose all their fuel.");
				break;
			case 454: // 196 Frilly Milly
				sprintf(buf, "These maids are loyal to their home owners, and went to school for many years perfecting the art of pottery. So when they see a broken pot, they freak out and must repair it. Really makes you regret breaking those pots.");
				break;
			case 424: // 197 Valkyrie (L1)
				sprintf(buf, "Fierce women warriors from the amazon. They work part time as bodyguards for a high price, and their powers are simply unmatched. This variant of valkyrie can shoot lightning bolts, leave some space in order to dodge them.");
				break;
			case 476: // 198 Valkyrie (L2)
				sprintf(buf, "Valkyries who prove to have enough experience switch to use intense fire magic. They sacrifice range for pure firepower. The hot energy produced by their flames also turns them red and angry.");
				break;
			case 489: // 199 Mirranjo (L1)
				sprintf(buf, "Once a daughter to a magus family whose entire tribe got wiped out by a calamity, she infused herself inside a mirror and mastered the art of light magic. Powerful laser shots from her mirrors can only be dodged with perfect spacing.");
				break;
			case 490: // 200 Mirranjo (L2)
				sprintf(buf, "The mirrors she summons come from pure energy of the gods. Once her magic powers reach a certain level, the mirrors she summons becomes one with her soul. It turns into an extension of her mirrored desires.");
				break;
			case 457: // 201 Tin Man (L1)
				sprintf(buf, "The desperate creature looking for love has no heart. The lack of heart means regular attacks to nothing to this metal being. Instead, heavy weapons should be enough to break this monster free from its suffering.");
				break;
			case 477: // 202 Tin Man (L2)
				sprintf(buf, "Once a kind man who just wanted to find true love, he became trapped in his hometown. In a desperate attempt, an estranged lover tried to win his heart by using a spell on him, only to turn his heart to tin.");
				break;
			case 461: // 203 Dove
				sprintf(buf, "Some say this magnificent bird is the holy spirit itself. It sure hits like one, definitely do not come into contact with this highly damaging bird. Perhaps this represents the intense love the lord has for this world.");
				break;
			case 421: // 204 Licorice Duo (L1)
				sprintf(buf, "These two are high school girls who got a part-time job as ruthless assassins. The red girl refuses to murder, so she instead stuns the target with a flash attack while the blue girl deals the killing blow.");
				break;
			case 475: // 205 Licorice Duo (L2)
				sprintf(buf, "Even though they are excellent killing machines, the two girls hope to one day open up a cafe shop in Tokyo. They are allegedly very close platonic friends, but it seems like their fans ship them together regardless.");
				break;
			case 466: // 206 Satellite Dish (L1)
				sprintf(buf, "It used to just be an ordinary satellite dish. But the Malo Corp. forced the manufacturers to implement AI technology into it. Now hackers found a way to make the satellites shoot lasers for some reason.");
				break;
			case 473: // 207 Satellite Dish (L2)
				sprintf(buf, "When a satellite dish becomes extremely corrupted, it turns a bright hot red due to overheating. Apparently, it holds up to 99TB of laser shooting software. Studies show the software was manufactured in North Korea.");
				break;
			case 487: // 208 Meteor Pillar (L1)
				sprintf(buf, "The pillar stands tall and proud with a magical rock on top. The rock was sent by the gods as a way to monitor life on earth. When threatened, the pillar sends a signal, and the gods lock onto the target and smites it with meteors.");
				break;
			case 488: // 209 Meteor Pillar (L2)
				sprintf(buf, "The meteors that shoot out from this pillar do not come from the heavens, rather, it comes from dark matter. This might explain why the pattern is unpredictable. Chaos thrives in darkness, and this pillar is truly evil.");
				break;
			case 463: // 210 Hyrulean Lieutenant
				sprintf(buf, "Senior officers like these soldiers usually sit back and let their younger peers fight to the death. But ever since Lotz took over Hyrule with the help of the Malo Corp. he forced these old geezers to defend him.");
				break;
			case 301: // 211 Green Lonk
				sprintf(buf, "This strange Link-shaped creature that mimics your movement is anything but Link. Remember his name, Lonk! Lonk shoots magic when you press the 'A' button. Perhaps they were designed that way for puzzle solving purposes?");
				break;
			case 411: // 212 Blue Lonk
				sprintf(buf, "This little fella is also named Lonk! He has a special property, when you hit him with a weapon, the two of you switch places. Or perhaps you two swap bodies? Let's hope you didn't give up your body to a lonk, that would be very bad.");
				break;
			case 158: // 213 Glory Minion
				sprintf(buf, "The most loyal of soldiers. They serve the one and only dark lord Takagon. After Takagon's death hundreds of years ago, many still worship him and pray for the day a prophet can revive him. Miss Muerte was the closest to achieve that.");
				break;
			case 157: // 214 Great Beast
				sprintf(buf, "This invincible beast waits for the innocent soul that steps into the line of sight of the Glory Security system. When it charges at its target, it doesn't stop until the victim becomes a pile of guts. No one really knows its origin.");
				break;
			case 446: // 215 Wonder Egg (L1)
				sprintf(buf, "This strange egg-shaped being might have originated from heaven. When it starts flashing, hit it with enough damage to prevent it from sucking all of your magic. When you lose your magic, that is when it starts going aggressive.");
				break;
			case 447: // 216 Wonder Egg (L2)
				sprintf(buf, "This ethereal creature focuses on taking its target out as quickly as possible. It doesn't care about your defense. When it successfully charges its flashing attack, it will set your HP down to one heart. Kill it quickly before it does that.");
				break;
			case 474: // 217 DIE Fighter (L1)
				sprintf(buf, "This death machine was the product of the Galactic Empire, it has the ability to fly at mach speed and shoot one to three laser beams without delay. Approaching these death machines from afar is the best strategy to defeat them.");
				break;
			case 356: // 218 DIE Fighter (L2)
				sprintf(buf, "The Galactic Empire's forbidden DIE Model. Hyrule initially imported them in hopes to use these planes for war. But they prove to be far too costly and destructive. Instead, these DIE fighters were banished to the shadow realm.");
				break;
			case 484: // 219 Goomba
				sprintf(buf, "In the Mario universe where these creatures originated, they are considered pitiful and weak foes. Now here in this universe, they're just about the same. It would be downright embarrassing to lose your life to these weaklings!");
				break;
			case 205: // 220 Aquamentus
				sprintf(buf, "The mighty unicorn dragon, Aquamentus. When you face this fiercesome beast, you know it's guarding something very important. It mainly uses the shine of its fabulous horn to attack. When enraged, its horn shines even brighter.");
				break;
			case 203: // 221 Moblin Leader
				sprintf(buf, "The de facto leader of the moblins. He built the Moblin house all by himself, how kind of this little fella to let his species live here rent free. Perhaps this moblin should've invested in better security.");
				break;
			case 202: // 222 Giant Rabbit
				sprintf(buf, "This giant furry creature does what it does best, hopping around. Sometimes, it may specifically jump to target you. It's best to keep a safe distance from this beast and strike it when it lands.");
				break;
			case 233: // 223 Mysterious Man
				sprintf(buf, "This mysterious robed man with a turban wants Cain to follow him? What could he possibly have in store? Perhaps these two have a long extensive history together or something. Maybe he could be the key in regaining Cain's memory.");
				break;
			case 207: // 224 Eligor
				sprintf(buf, "The great fiend of pride. He uses his trusty steed to travel through paintings. The crosses he throws are a sign and devotion to god. But if he is so holy, why is he considered a demon? Perhaps there is more to the fiends than we realize.");
				break;
			case  62: // 225 Gleeok
				sprintf(buf, "The classic scary looking dragon. You will see many of them in your quest, some with one head, others with multiple. When fighting multi-headed Gleeoks, if you slay one head, it will float around to support its brother in a fierce last stand.");
				break;
			case 174: // 226 Flame Generator
				sprintf(buf, "These pesky runts are responsible for the fire in the pub cellar. Use Ciela's ice magic to freeze them. Only then can the crew figure out who that pink masked warrior is.");
				break;
			case 211: // 227 Digdogger
				sprintf(buf, "The blobby eyeball beast was formed by yeast from decades of beer brewing. It was born to enact one goal, shoot fireballs. It's rather slimy in texture, so it can easily slide around the wet arena when fought.");
				break;
			case  68: // 228 Digdogger Kid
				sprintf(buf, "When a digdogger is slain, it does not simply dissolve, instead it makes it a last ditch effort to survive. The four little kids they produce will use their jumping ability to strike their target until they themselves die.");
				break;
			case 180: // 229 Armos Knights
				sprintf(buf, "A slightly bigger and more powerful version of the little armos knights. Despite carrying large swords, their main method of attack is simply jumping. When five knights are defeated, the last one panics and simply goes on pure offense.");
				break;
			case 164: // 230 Wizzrobe Leader
				sprintf(buf, "This wizzrobe leader was the class valedictorian when he graduated wizardry school. He wanted to be cool, so he mastered the rare 8-shot fireball spell. It takes a lot of time to learn this magic, but is it really worth it?");
				break;
			case 213: // 231 Ammit
				sprintf(buf, "The hungry fiend of gluttony ruled the desert until it was captured by the sage of light. There, she became the guard of the Ancient Maze, feasting on those who dare disturb the sage. Her victim's skulls later become her main projectile.");
				break;
			case 355: // 232 Lotz
				sprintf(buf, "The young, handsome, powerful alpha male of Elignita. His net worth is estimated to be around 300 billion rupees. Still, he yearns for more. Perhaps he wants to rule Elignita himself, or maybe he has a greater goal in mind.");
				break;
			case 217: // 233 Freaky Jr.
				sprintf(buf, "Oh my gosh! Is that a complete freak? Kill him, before he destroys your eyes with his ugliness! :P Trust me, he may look defenseless, but he shakes more than a drill for god's sake!");
				break;
			case 218: // 234 Freaky Sr.
				sprintf(buf, "He wants nothing more than revenge, but can you really blame him? You k-killed his brother! So now he wants a challenge, and oh boy is he going to give you one! :P Wait... you killed him already? Maybe they're just weak freaks...");
				break;
			case 219: // 235 Eternal Nightmare
				sprintf(buf, "The bane that holds back the Radiant Sword manifests itself as the ultimate freak. For he has already destroyed your eyes with his ugliness. But fight back hard, and the Radiant Sword shall be yours.");
				break;
			case  61: // 236 Manhandala
				sprintf(buf, "The infamous plant boss monster makes its grand entrance in the Theatre of Lust. Strike it with bombs or attack from a distance with arrows. As each head gets destroyed, this beast will start to move faster and faster.");
				break;
			case 220: // 237 Asmody (L1)
				sprintf(buf, "Soja's new lover who turned out to be an evil fiend, you must destroy her before she seals the deal with the wedding! As the fiend of Lust, she attacks with heart shaped magic. Agent A of course is immune to her infatuation.");
				break;
			case 222: // 238 Asmody (L2)
				sprintf(buf, "Asmody spent about 20 million rupees on this wedding dress, so it's odd why she would want to potentially ruin it by wearing it in battle. Maybe her wedding dress carries more secrets than one might know. Truly, a demonic secret.");
				break;
			case 223: // 239 Chimera
				sprintf(buf, "The beast was captured by Asmody and stored deep in the theatre of lust. Originally, she planned for the chimera to be slain and be the main course of the wedding feast. But its firepower proved to be better used as a bodyguard.");
				break;
			case 225: // 240 Asmodeus
				sprintf(buf, "The majestic Fiend of Lust's final form, she dresses in a rather revealing outfit and learns the art of constant teleportation. Attacking from a distance is probably the best strategy against this fiend's constant heart attacks.");
				break;
			case 234: // 241 Gwonam
				sprintf(buf, "The truth has been revealed, Cain is the Hyrulean Hero? Why did Gwonam wait until now to reveal such news? Perhaps he spent years training to master the arts of the Sheikah before taking on this tough task of deliverance.");
				break;
			case 242: // 242 Page 64
				sprintf(buf, "The first page master commands the octorok class. He is a beloved teacher who teaches the art 'octorok mouth polishing' and 'rock shooting 201'. Throughout his career, 5,000 octorocks have graduated from the school of fiends.");
				break; 
			case 246: // 243 Page 128
				sprintf(buf, "The second page master, he is the tower's PE coach. His agile skills in boomerang throwing makes him a fan favorite with the Goriya class. During his time as professor, he wrote many studies on the perfect boomerang arc.");
				break;
			case 244: // 244 Page 256
				sprintf(buf, "The third page master. Simply known as the boring old teacher, he shows up and just teaches magic, nothing more, nothing less. His simple ways of teaching makes him well liked by the wizzrobe gang.");
				break;
			case 248: // 245 Page 512
				sprintf(buf, "The final page master. He's no teacher, just the tower's custodian. He's a little crazy, and loves to decorate the tower with green fire. Once the arena is filled with green fire, he teleports uncontrollably with glee. Quite odd, no?");
				break;
			case 250: // 246 Flauros
				sprintf(buf, "The mad fiend of wrath is also the originator of green fire. He is fast, he will strike you down with his unique firepower, and will make quick work of weaklings. Despite all of that, what's so special about green fire anyways?");
				break;
			case 262: // 247 Talo
				sprintf(buf, "Malo's personal bodyguard assassin. They were childhood friends back in Ordon Village. According to Malo's autobiography, Talo went to college while Malo listened to alpha male podcasts, that's why Malo became much more successful.");
				break;
			case 285: // 248 Crystal Barrier
				sprintf(buf, "Magical security systems that power up the Lunar Garden Tree. The great fiend of envy does not want to be disturbed, so he built this magical obstacle to guard the barrier towers. It's about 5 cm in length.");
				break;
			case 271: // 249 Leviathan
				sprintf(buf, "The envious fiend of the moon was the byproduct of Abaddon. He is told to guard the mystical powers of healing magic. The serpent can dive underwater to regenerate itself, so strike its tail with magic when it dives down.");
				break;
			case 287: // 250 Beelzebub
				sprintf(buf, "Hyrule is famous for their pork. Once, a slaughtered pig head got possessed by the devil and grew in size. Instead of destroying it, Rusl and his army decided to turn it into a weapon of mass destruction upon Elignita.");
				break;
			case 275: // 251 Killer Rabbit
				sprintf(buf, "When a giant rabbit gets exposed to the elements of dark magic, it turns into this evil monstrosity. Their jumps become more desperate and frantic. And their eyes turn a bloodshot red. Every night, it prays for strength to the God among Hares.");
				break;
			case 273: // 252 Maloware System
				sprintf(buf, "The Malo Corp's premier antivirus software. Every Hyrulean computer must have this downloaded, and customers must pay 65,000 rupees a month in a subscription service. Deep dive shows this software actually spies and sells user data to the dark web.");
				break;
			case 305: // 253 Abaddon
				sprintf(buf, "The fiend that has taken over Auru's body goes by many names. The fiend of fiends, the dark energy, or simply just Abaddon. He is darkness personified, and holds the power needed to cause ultimate destruction upon this world.");
				break;
			case 284: // 254 Abaddon (Phantom)
				sprintf(buf, "The foul fiend of fiends many forms, The Dark Energy itself is the combination of the evils of this world, it does not have a singular form. But this monstrous formation with spider legs is the dark energy's most common appearance.");
				break;
			case 298: // 255 Agent A
				sprintf(buf, "It's the one and only magnificent and adorable demon hunter Agent A! 'A' definitely does NOT stand for 'Aurelia' by the way. She says that she spent at least four years training the art of spear wielding from the Hinnow Village Chief.");
				break;
			case 302: // 256 Cain
				sprintf(buf, "A once so-called 'Hero' became a thief when he ended up in Elignita. He made very few friends in his new life, but those he deemed trustworthy, he will defend them until the end. Despite losing his memory, his fighting skills stayed intact.");
				break;
			case 308: // 257 Rusl
				sprintf(buf, "The ruthless Chancellor of Hyrule wasn't always like this. Before the ceasefire, an Elignitan raid killed his son Colin. That was when he lost his humanity and desire for any form of peace. If only he didn't go too far with the TRIFORCE.");
				break;
			case 293: // 258 Archangel
				sprintf(buf, "The statue that represents healing and soothing has come to life to attack! It isn't malicious, the angel is just doing its job as the protector of fairies. Perhaps she has malfunctioned or something.");
				break;
			case 321: // 259 Abaddon
				sprintf(buf, "The evil dark energy incarnate itself has gone mad and fully taken over the body of Auru. Abaddon's power allows Auru to unlock his true potential physical ability. This, however, comes at a sacrifice of his lifespan.");
				break;
			case 152: // 260 Summoning Warlord
				sprintf(buf, "This zealous wizzrobe learned the dark arts of summoning. The monsters it summons come directly from hell. For every monster this creature lets loose from the underworld, the devil himself glees with red hot passion.");
				break;
			case  58: // 261 Red Aquamentus
				sprintf(buf, "An aquamentus who decided to face right. This new perspective allowed the dragon to unlock its true potential. Its shine attack increased in power dramatically, not only that, it can also bounce off of walls!");
				break;
			case 337: // 262 Knil
				sprintf(buf, "The so-called 'sword master' of Hyrule. He has hired a ton of minions to do his bidding while he shoots out fireballs. He is a rather wealthy individual, due to his exceptionally rare sword collection. Most of them stay untouched.");
				break;
			case 109: // 263 Fire Gleeok
				sprintf(buf, "Gleeoks who are extra vile turn into these monstrosities. They shoot out a breath of fire that can only be blocked by the mirror shield. When facing multi-headed variants, the fire breath attack still applies to the floating heads.");
				break;
			case 339: // 264 Mothula
				sprintf(buf, "The great magical beast is said to have granted its slayers magical powers, whatever that means. It specializes in its hypno ring attacks that may cause hallucinations to any target it hits. Best to avoid them and strike the moth with fire.");
				break;
			case 340: // 265 Baby Mothula
				sprintf(buf, "How can a moth be a baby? Don't they start off as caterpillars first? These species of evil creatures mature very quickly, when a Mothula gives birth, the babies gain wings in about 2 milliseconds. They may grow fast, but also die fast as well.");
				break;
			case 295: // 266 Vampire Lady
				sprintf(buf, "Keese love some company, and what better company can they be around than a beautiful vampire lady like this? She will quickly move around and do various attacks such as summoning keese and conjuring fast fireballs.");
				break;
			case 366: // 267 Hot Drop
				sprintf(buf, "This evil creature came from the bowels of the demon fiend of sloth. Don't let its origins get to the better of you, strike this fiery drop with all your force. It jumps around and burns everything it sees with its red hot flames.");
				break;
			case 368: // 268 Armos Knights
				sprintf(buf, "These armos knights have hopped for centuries. One would think this may cause them to wear down, but constant movement has only made them stronger. Their speed is unmatched, and they march so elegantly, almost as if they are professionals.");
				break;
			case 374: // 269 Matryoshka (XL)
				sprintf(buf, "The famous Russian nesting doll gained sentience to support the Eastern State. The largest sister of the group is an absolute unit. She will bounce around and cause massive damage when touched. So attack from a distance if possible.");
				break;
			case 375: // 270 Matryoshka (L)
				sprintf(buf, "When the first layer is destroyed, the second sister moves more quickly at the sacrifice of power. The beams she shoots come from the combined energy all of them have when they stay nested.");
				break;
			case 376: // 271 Matryoshka (M)
				sprintf(buf, "The second smallest of the Matryoshka acts similarly to her older sisters, but to a less effective degree. It's said that this particular sister is the smartest of the group. But unfortunately, this doesn't translate to battle prowess.");
				break;
			case 377: // 272 Matryoshka (S)
				sprintf(buf, "The innermost layer of the Matryoshka. She is a nimble little fella. Of the four sisters, she is considered the jokester. It is unclear what makes this sister a jokester other than her extremely janky hitbox.");
				break;
			case 378: // 273 Elena
				sprintf(buf, "A well known doctor of the Eastern State, she spent a lot of her time overseeing her cousin in Elignita. Despite being a citizen of a country hostile to Hyrule, she went to medical school in the most prestigious Hyrulean university.");
				break;
			case 382: // 274 Belphegor
				sprintf(buf, "The lazy fiend of sloth mainly wields fire as his weapon. His flaming toilet was custom made in Japan and comes with extra warm heated seating and a comprehensive bidet. No wonder why he stayed sitting on it for so long!");
				break;
			case 395: // 275 Malo Corp. CFO
				sprintf(buf, "His real name is Tingle, and boy does he love rupees! He got bullied as a kid for being a complete weirdo. It seemed life was over for him until he made a podcast. Now, after years of hard work, he's finally the alpha male he dreamed to be.");
				break;
			case 399: // 276 Ankle
				sprintf(buf, "A disciple of the Malo Corp. CFO. He loves rupees as well, and together, the group made a podcast talking about things like 'Hyrulean values' and how to be masculine. Ankle always seems to be the one making scandalous comments in their podcast.");
				break;
			case 192: // 277 Liberty Demon
				sprintf(buf, "When Malo wanted his company to go global, he decided to make a public stunt and buy the Statue of Liberty from the United States. After buying it, the gods turned the statue into a demon. Malo thought that was funny and made it a shareholder.");
				break;
			case 400: // 278 David Jr.
				sprintf(buf, "He used to be a scrawny guy until he joined to host the Malo Corp. CFO Podcast. There, he learned to lift weights and read books like 'Atlas Shrugged' and '12 Rules for Life: An Antidote to Chaos'. Soon, he too turned into an alpha male.");
				break;
			case 401: // 279 Mammon
				sprintf(buf, "The elegant fiend of greed manifests herself as a chess piece made of rupees. Some say she started her life as a mere pawn, and after pulling herself up by her bootstraps, she reached the other side of the chess board and became a queen.");
				break;
			case  77: // 280 Eternal Nightmare
				sprintf(buf, "This specific Eternal Nightmare is born from the curse of the Sealed Realm. When one falls into the realm's trap, they face off against this shaky freak. Do not hold back, this thing can still kill you with its ugliness.");
				break;
			case 141: // 281 Scott (L1)
				sprintf(buf, "The ancient Prince of Hyrule vowed and searched for power. He got his wish in forming the ROSEMASTER. Little does he know that the Dark Energy within this rose caused him to transform into his true desires. One that is an abomination.");
				break;
			case 172: // 282 Scott (L2)
				sprintf(buf, "When one uses the ROSEMASTER as a weapon for too long, they transform into the dark energy itself. Once said energy takes over the body, the soul of the wielder ceases to exist. Scott's soul was saved by his killer at the sacrifice of his body.");
				break;
			case  66: // 283 Patra
				sprintf(buf, "The pest of evil uses its younger siblings as its meat shield. Once the creature is left to fend for itself, it attacks with violent ring beams. Strike it down while keeping a safe distance away from its projectiles.");
				break;
			case 145: // 284 Shade
				sprintf(buf, "This ancient warrior was a proud Hyrulean knight. Famous for warning the princess of an impending doom of the Dark Lord as a child. He soon lived his life as a hermit in the Lost Woods, where he sought to be the protector of the forest.");
				break;
			case 143: // 285 Guardian
				sprintf(buf, "A high tech weapon created by the Sheikah Tribe. This Guardian was originally meant to prepare the nation against a potential dark lord. But later turned into a conventional weapon. Let's hope a future calamity doesn't possess these machines...");
				break;
			case 151: // 286 Jermafenser
				sprintf(buf, "The first heavenly king. This proud warrior of the Great Palace uses his various masks to strike his enemies. He starts off with a lady mask that fires out homing fireballs, then a Kitsune mask, then finally a demon mask as a last resort.");
				break;
			case 232: // 287 Cold Head
				sprintf(buf, "It's a giant ice block in the shape of Malo! Could it be a creation of one of the four heavenly kings of the Great palace? Maybe this could be the ultimate test for Ciela, and perhaps, a foreshadowing.");
				break;
			case 169: // 288 Gooma
				sprintf(buf, "The great demonic brute is the second of the Four Heavenly Kings. Why did he freeze himself like that? Perhaps he doesn't mind the cold and was just patiently waiting for a candidate to thaw him out as a challenge.");
				break;
			case 235: // 289 Gwonam's Memory
				sprintf(buf, "The spirit of Gwonam protects his journal in hopes the only worthy one to defeat him can see it. Cain, the one to defeat this spirit, realizes the truth on how he ended up the way he is long ago.");
				break;
			case 304: // 290 Carock
				sprintf(buf, "The magus Heavenly King of the Great Palace oversees the top floor of the dungeon. He has mastered the arts of courageous magic for over 1,000 years. When he is not in battle, he meditates to recharge his mana.");
				break;
			case 306: // 291 Thunderbird
				sprintf(buf, "The levin Heavenly King is sealed away deep within the Great Palace, meant to be the penultimate test by those who built the trial of courage, this demon proves its strength through a powerful combination of fire and lightning attacks.");
				break;
			case 163: // 292 Dark Link
				sprintf(buf, "Link's darkest sins manifests into this amalgamation. As a final test, the candidate must overcome his evil-filled shadow. Once slain, the candidate will have proven to cleanse their soul of all evil, therefore being worthy to become the Hero.");
				break;
			case 407: // 293 Vampire Queen
				sprintf(buf, "When a vampire lady controls enough keese, she elevates into royalty. The Queen rules over the keese kingdoms with her dark aura and elegant demeanor. The fireballs she shoots become more chaotic, and her summoning skills grow in number.");
				break;
			case 389: // 294 Gale
				sprintf(buf, "A mage that goes where the wind takes him. One day, he had a vision of a great battle against a worthy opponent, so he rented an apartment complex in Hyrule to stand and wait. For he longs to call forth the winds in battle once again.");
				break;
			case 445: // 295 Hal
				sprintf(buf, "A black eared fox warrior who specializes in the power of ice. It's said that he came from a distant island called Koholint. He found a way to rise to the top in Hyrule, albeit in corrupt ways. His rivalry against his alter ego knows no bounds.");
				break;
			case 420: // 296 Emily
				sprintf(buf, "A skilled archer who had a simple goal of climbing a mysterious tower. For some reason, she ended up in this universe. It felt unfamiliar to her, so she wanted to go home. But not before making a friend before she leaves this universe forever.");
				break;
			case 425: // 297 Alloces
				sprintf(buf, "The great duke of Hell. Apparently, he's very well versed in various studies like astrology and liberal sciences. But don't let that detract you from his fabulous silver horse and frighteningly speedy attacks.");
				break;
			case 226: // 298 Kronos
				sprintf(buf, "The evil ruler of titans has the ability to eat the Gods themselves. Perhaps that might explain why the skulls this demon spits out seems like they have ethereal powers like the ability to home in on you.");
				break;
			case 150: // 299 Lilith
				sprintf(buf, "Legends say she was the original manifestation of femininity. Rejecting to submit to her role under God, she carved her own path. This path away from the light has caused this demon to turn to the dark side and gain powers from hell.");
				break;
			case 215: // 300 Dantalion
				sprintf(buf, "The great duke of hell. He is the most well educated in the underworld. This demon loves to hang out in places of abundant wisdom. Where he studies and shares this knowledge to the world. But does the world appreciate his act? Not so...");
				break;
			case 168: // 301 Ogopogo
				sprintf(buf, "The great mythical monster of urban legends makes its debut in... Hyrule? Hunting this creature down may prove to be a great challenge in itself. Its magic attacks leave a devastating explosion effect, so attack from a distance.");
				break;
			case 361: // 302 Satan
				sprintf(buf, "It's not enough that the devil has possessed a pig's head. It must now face right, only then does it truly command the flies. Some may say this is the ultimate devil itself, but in truth the devil takes on many forms, including this one.");
				break;
			case 105: // 303 Lucifer
				sprintf(buf, "This fallen angel has seen better days. It's unclear why this fella is on the toilet as well. Perhaps he made friends with Belphegor and found a common interest in taking the number 2 for way too long. Let's not forget his skills in swordplay, too.");
				break;
			case 112: // 304 Gremory
				sprintf(buf, "A powerful duke of hell that is an expert of all things romance and love. Perhaps this demon should've been the fiend of lust. But it looks like Asmodeus got in line for the application before they did.");
				break;
			case 426: // 305 Iblis
				sprintf(buf, "Great evil doesn't just exist within the Dark Energy itself. This demon is considered the ultimate devil himself according to many people. His dark energy surpasses even the evils of Abaddon, so fight against him, or he will conquer you.");
				break;
			case 107: // 306 Contractor of Antiquity
				sprintf(buf, "The wisest of all wizzrobes, he gave himself such a long title it couldn't fit in the bestiary name list, how arrogant of him! Anyways, this creature can summon monsters that get more powerful the less health it has.");
				break;
			case 384: // 307 God Among Hares
				sprintf(buf, "All rabbits worship this, this creature became a venerated being when it hopped so high it reached the moon. Each hop made this beast more and more powerful, up to a point to where every time it lands, it causes a great explosion.");
				break;
			case  69: // 308 The Thirteenth Imam
				sprintf(buf, "The great sage lost to time. He knows the secrets of the universe, but refuses to elaborate any further. Legends say that once he returns and reveals his face, the world will end. Hopefully, it won't be until a very long time.");
				break;
			case 409: // 309 Dictator
				sprintf(buf, "A leader with absolute power. He turned his country from a republic into an empire in one grand speech. Everyone clapped in a thunderous applause, but little do they know that this will be the most free they will ever be.");
				break;
			case 385: // 310 Grand Matriarch (XL)
				sprintf(buf, "The manifestation of the matriarchy incarnate. The layers are bonded by the most powerful of all sisterhoods. When this creature bounces about, the whole world will know the true power of the matriarch.");
				break;
			case 386: // 311 Grand Matriarch (L)
				sprintf(buf, "The outer layer may be destroyed, but the bonds of sisterhood must continue on. While packing less of a punch, this stage of the matriarch becomes much more nimble. Take cover when they shoot their fireballs.");
				break;
			case 387: // 312 Grand Matriarch (M)
				sprintf(buf, "With half the layers destroyed, the order of the matriarch becomes more desperate. Faster and faster they go, but the strategies they use remain the same. Respond back by being more nimble in order to strike this layer down.");
				break;
			case 388: // 313 Grand Matriarch (S)
				sprintf(buf, "The matriarchy's last stand. This little tiny bundle uses its last stand to strike in anger and fear. You can see it bounce in agony, knowing that the sisterhood of the matriarch depends on its success.");
				break;
			case 410: // 314 Failed Experiment
				sprintf(buf, "This beast was planned to be the ultimate apex killer bodyguard for a king. But something went wrong, very wrong. The monster was far too dangerous to maintain, the chaotic flames it spews out must be blocked by at least a big shield.");
				break;
			case 412: // 315 Page 65,636
				sprintf(buf, "The teacher with forbidden knowledge. He loves pop quizzes, which made him so feared among students, he got moved to the advanced placement department. There, this beast conjures up the most wicked questions to ask.");
				break;
			case 317: // 316 Taste of Democracy
				sprintf(buf, "Every time an evil dictatorship country embraces democracy, this statue turns more and more golden. Right now, this creature shines with gold so bright, one could go blind by looking at it for too long. Beware of its fire burst attack.");
				break;
			case  74: // 317 Knuckle
				sprintf(buf, "A former member of the Malo Corp. CFO podcast. He would say the most outrageous and politically incorrect things on live. The rest of the crew had to kick him out in order to monetize their podcast. Knuckle now made his own podcast on the dark web.");
				break;
			case 416: // 318 Origin of Pests
				sprintf(buf, "The birth of evil, where all the annoying insects lie. This beast represents the beginning of the end for all the bugs of this world. The hypno beams it shoots come from the combined energy of all the buzzes and beetles in the world.");
				break;
			case 417: // 319 Baby Pest
				sprintf(buf, "The baby of all things evil insects. It brings about a new hope of bugs ruling over the world. A simple fire may kill them, but they return fast. It goes to show that no human can ever truly defeat the bugs.");
				break;
			case 303: // 320 Knil's Evil Brother
				sprintf(buf, "If you ever thought Knil was a weird guy, you clearly haven't met his older brother. He would yell his love and desire to wield the master sword every night. One day, he finally made his trip to the Temple of Time to grab the sword for himself.");
				break;
			case 418: // 321 Light Link
				sprintf(buf, "If Dark Link was the manifestation of all his evil deeds, then this Link is one with all his good deeds. It turns out Link is a pretty good dude, so this Link is far more powerful than Dark Link as a result.");
				break;
			case 452: // 322 Abaddon (Phantom)
				sprintf(buf, "The menace strikes back as a more powerful phantom. It still dies in one hit, but sustainability is not the main point of this monster. It's meant to be a distraction as the true Abaddon strikes you down with heavier hits.");
				break;
			case 281: // 323 Abaddon
				sprintf(buf, "Abaddon's true form, the draconic shape of this demon is created after it swallowed up the entirety of the Sealed Realm. The amalgamation of the death and whimper of the Shadgoons allowed this fiend to manifest darkness itself.");
				break;
			case 326: // 324 Abaddon Core
				sprintf(buf, "The core of the Dark Energy is one that can't be hit by any simple weapon. The Shadgoon crafted the magnificent Ascalon for the purpose of slaying the heart of this draconic beast. Beware, the artery system will defend the heart with everything it has!");
				break;
			case 456: // 325 Manhandala
				sprintf(buf, "Manhandala has come back for sweet revenge. Here, it has mastered the arts of bomb spitting, it definitely had several study sessions with its best friend, the Zirro. Either way, it combines that with its fast agility once you strike its heads down.");
				break;
			case 458: // 326 Saladin
				sprintf(buf, "Lived from 1137-1193, this legendary Sultan is best known for being a great adversary against the crusades and leading the Muslim conquest throughout many parts of the Middle East. In 1187, he captured Jerusalem, driving the ruling Christians out.");
				break;
			case 460: // 327 Genghis Khan
				sprintf(buf, "The great Khan of the Mongol Empire who lived from 1162-1227. Most well known for creating the largest contiguous land empire in the world. His warriors are exceptionally skilled in horseback archery. When he died, his empire split into smaller ones.");
				break;
			case 462: // 328 Charles Martel
				sprintf(buf, "The Frankish warrior King who lived from 688-741 is well known for his resistance against the invading Umayyad Caliphate. In the Battle of Tours, he successfully fended off the invaders and sustained Christendom in Western Europe.");
				break;
			case 428: // 329 Corbin
				sprintf(buf, "The new chancellor of Hyrule after Rusl's death. He trained as a warrior and was considered the favorite disciple by his late teacher. While calm in demeanor, he commands the Hyrulean Army in a more orderly strategic approach.");
				break;
			case 465: // 330 Malo
				sprintf(buf, "The CEO of the Malo Corp. He worked extremely hard from nothing to get where he is right now according to his documentary. This 58 year old businessman hates being called a babyface, and projected his insecurities onto others.");
				break;
			case 467: // 331 Alexander
				sprintf(buf, "The young Macedonian conqueror of the Ancient World lived from 356-323 BC. In his short life, he ruled an empire that stretched from Greece to India. He destroyed, but also built cities, the most well known was his namesake Alexandria of Egypt.");
				break;
			case 429: // 332 Ingrid
				sprintf(buf, "Tempted by the power of the ROSEMASTER, the Tsarina of Elignita was consumed by her true desires to not only enact revenge on Lotz, but to destroy the world with her kingdom's fall. When she charges to 100 percent, she will be one with the Dark Energy.");
				break;
			case 362: // 333 Lotz
				sprintf(buf, "When the Great and Alpha Male Prince of Hyrule wields the power of the ROSEMASTER, he grows nearly a foot in height, and that's about it. Lotz's powers are too weak even for the ROSEMASTER to use him to destroy the world. A regrettable possession.");
				break;
			case 299: // 334 Dark Aurelia
				sprintf(buf, "The hatred for the super cute fairy knight manifests itself into this creature. Dark Aurelia may look like regular Aurelia, but she's a lot meaner and less funny. And the latter difference really breaks it for all of us, take her down!");
				break;
			case 276: // 335 The Power Walrus
				sprintf(buf, "An unknown creature known to be able to manifest his own realm. He is omnipresent, always watching over you, even in your bedroom. Don't believe me? Look under your bed. The power walrus sees and judges everything you do.");
				break;
			case 330: // 336 Quaztor
				sprintf(buf, "The Glorious Warlock Commander from the eyes of Miss Muerte. His style is unmatched, look at his golden Glory Squad Symbol necklace. It kind of looks like a '96', but the symbol is like that because it looks cool.");
				break;
			case 254: // 337 Kota
				sprintf(buf, "The Glorious Sonic Commander runs 50 marathons every day as a form of practice. He becomes so fast he materializes his own projectiles by the friction of his speed. There's no evidence of him being as attractive as Miss Muerte made him out to be.");
				break;
			case 272: // 338 Iro
				sprintf(buf, "The Glorious Tricky Commander stands tall as the most charming admin of the Glory Squad. His teleportation and fireballs make him a silent killer, and one that truly captured the heart of Miss Muerte.");
				break;
			case 297: // 339 Mushi
				sprintf(buf, "The Glorious Phantom Commander may seem sidelined in his group. But he is known to be one of the highest ranking officers of the Glory Squad. He specializes in laser attacks, one that becomes so powerful it materializes itself into clones of himself.");
				break;
			case 307: // 340 Kotairo
				sprintf(buf, "The Glorious Fused Commander may seem like some fanfiction Miss Muerte came up with. But their fusion uses the same type of energy Takagon used to fuse them a long time ago. That's why it took so long for this trading card mechanic to work.");
				break;
			case 282: // 341 Miss Muerte
				sprintf(buf, "The Glorious queen of death herself. Dr. Meg Muerte became radicalized during her time in University. There, she dreamed of a revolution against Hyrule greater than Elignita, there, she found her true obsession, the Glory Squad.");
				break;
			case 312: // 342 Takagon
				sprintf(buf, "The Dark Lord of the Glory Squad masters the element of electricity. His long history predates even the creation of the Glory Squad. His forbidden knowledge of the Ancient Hylian language allows him to command an army of cult-like followers.");
				break;
			case 431: // 343 Aries
				sprintf(buf, "If you were born between March 21 - April 19, your zodiac sign is Aries. A fierce and competitive sign that is never afraid to tackle things head on. There is nothing that brings more joy to an Aries than a worthy challenger.");
				break;
			case 432: // 344 Taurus
				sprintf(buf, "If you were born between April 20 - May 20, your zodiac sign is Taurus. The stable and backbone of the entire group. This sign is reliable, sturdy, and will never back down in a fight. Even to the point of stubborness.");
				break;
			case 433: // 345 Gemini
				sprintf(buf, "If you were born between May 21 - June 20, your zodiac sign is Gemini. A creative sign that is clearly out of the ordinary. Despite the differences, they are intelligent, creative, but there's a dark secret under that mask.");
				break;
			case 434: // 346 Cancer
				sprintf(buf, "If you were born between June 21 - July 22, your zodiac sign is Cancer. Underappreciated but the most caring of the bunch. Ready to protect what they deem worthy, this sign is as loyal as loyalty can get.");
				break;
			case 435: // 347 Leo
				sprintf(buf, "If you were born between July 23 - August 22, your zodiac sign is Leo. The proudest of the bunch, which comes with its own side of ego. Such confidence of this sign may already be enough to defeat anyone in battle.");
				break;
			case 436: // 348 Virgo
				sprintf(buf, "If you were born between August 23 - September 22, your zodiac sign is Virgo. A quick-witted sign known for their unmatched beauty. Such vanity could hold this sign back, but its passion could be enough to overwhelm any adversary.");
				break;
			case 437: // 349 Libra
				sprintf(buf, "If you were born between September 23 - October 22, your zodiac sign is Libra. Balance and order is such a life for this sign. If things go to disarray, they will do anything in their power to reverse such a state.");
				break;
			case 438: // 350 Scorpio
				sprintf(buf, "If you were born between October 23 - November 21, your zodiac sign is Scorpio. Mysterious, yet powerful. This sign can easily charm anyone with its derivative approach to challenge. But they hold a secret that may be too dark to tell.");
				break;
			case 439: // 351 Sagittarius
				sprintf(buf, "If you were born between November 22 - December 21, your zodiac sign is Sagittarius. A sign that goes head on with unmatched courage. It fights for what is right, no matter how powerful the enemy can be, even if it compromises their safety.");
				break;
			case 440: // 352 Capricorn
				sprintf(buf, "If you were born between December 22 - January 19, your zodiac sign is Capricorn. A reserved sign, but one that is not afraid to stand up when times are tough. When they finally awake from their slumber, the whole world will know.");
				break;
			case 441: // 353 Aquarius
				sprintf(buf, "If you were born between January 20 - February 18, your zodiac sign is Aquarius. A sign filled with empathy and care. The world could not be complete without their soothing embrace, but it's clear this sign is the odd one out.");
				break;
			case 442: // 354 Pisces
				sprintf(buf, "If you were born between February 19 - March 20, your zodiac sign is Pices. The most trustworthy of companions and one that will fight along with their friends until the day they die. They fight together, never alone.");
				break;
			case 449: // 355 Vampire Goddess
				sprintf(buf, "Before Keese sleep, they pray to this goddess every day to give them the strength to live a happy and batty life tomorrow. She commands the strongest of keese, emitting fireballs formed from the combined prayers of all things bat.");
				break;
			case 253: // 356 Black Dragon
				sprintf(buf, "The youngest of the seven dragon siblings. It's pretty obvious that this little guy is a bit edgy. He befriended zombies back in high school, which was weird to his family. But it doesn't matter, as now he commands a frightening undead team.");
				break;
			case 239: // 357 Purple Dragon
				sprintf(buf, "The most stylish of the group. Her weapon of choice is bubbles? Perhaps there is something in bubbles we do not know, and this dragon found the secret in utilizing its full potential. Also, she is small.");
				break;
			case 257: // 358 Orange Dragon
				sprintf(buf, "A hopeless romantic. He thought hanging out with the pretty Asmody would give him a chance. But she got engaged to someone else anyway. Heartbroken, he secluded himself in the Ice dungeon, but his heart still burns bright for the fiend.");
				break;
			case 324: // 359 Green Dragon
				sprintf(buf, "After this dragon learned how to fly, he would spend most of his youth at a Casino in Macau. After losing all his money, he had no choice but to follow his family's lifestyle of being a superboss. His gambling passion still seeps in his battle, though.");
				break;
			case 228: // 360 Blue Dragon
				sprintf(buf, "The most sophisticated brother of the Dragon family. He is well-versed in magic that is colored blue, like ice, or blue lasers. He looks down upon his younger siblings, as he himself sees the art of battling to be one that should be taken seriously.");
				break;
			case 406: // 361 Silver Dragon
				sprintf(buf, "The shy second eldest brother knows what it's like to be behind the strongest. His empathy and passion manifests itself into his ability to turn invisible. Just one hit should tell you where he is, though.");
				break;
			case  43: // 362 Red Dragon
				sprintf(buf, "The eldest of the seven dragons. He listens to no one but the Dragon Tsar itself. He commands an army of mobs in which he categorizes them as weak, medium, to strong. He only respects those who can take down his strongest platoon.");
				break;
			case 480: // 363 Number 1
				sprintf(buf, "The common security system built into the Skyward Tree. It was originally meant to counter terrorism, but now this enigma is used to block off the most important of places. Many have died of exhaustion from trying to break through this thing's health.");
				break;
			case 481: // 364 Number 2
				sprintf(buf, "Comes installed with a function that causes its targets to gain a fate worse than death. Do not strike this when a Number 1 is still present. They are linked by BlueTooth, so killing Number 1 should send a signal to this to turn into something else.");
				break;
			case 482: // 365 Number 3
				sprintf(buf, "A rare variant of the number machines. Linking the three numbers all together in the same room uses more electricity than the annual electricity usage of North America. This might explain why there's only one in the bunch.");
				break;
			case 483: // 366 Scindo
				sprintf(buf, "The legendary spirit of the Master Sword has been split apart and lost their memory. Only a tough fight can one restore this spirit in its full glory. After becoming Fi once again, she can fuse the two blades to become one. The True Master Sword.");
				break;
			case 419: // 367 Dragon Tsar
				sprintf(buf, "The fierce dragon god that is responsible for the Master Sword's split. Meant to be the answer to Elignita's prayers to destroy Hyrule, this creature was barely stopped by the sword itself. For now it roams the Skyward Tree, waiting for the chosen one.");
				break;
			case 427: // 368 Judas Iscariot
				sprintf(buf, "This treacherous disciple begged for forgiveness, and God gave him one chance to get out of hell. His one purpose, to guard the Dread Tower. Knowing that his failure would result in eternal damnation, he fights with his life to end such a cycle.");
				break;
			case 430: // 369 Ingrid
				sprintf(buf, "The Tsarina of Elignita gained unfounded new power through a purple aura caused by the Original Glory Squad Card. Miss Muerte wanted her creations to change fate, perhaps this too can change the course of Ingrid's own fate.");
				break;
			case 503: // 370 Ramiel
				sprintf(buf, "The great angel of God, he who leads those worthy to their right place in the universe. A final test of clensing must be made to prepare Link. And at last, our hero can finally go to where he truly belongs.");
				break;	
            default:
                sprintf(buf, "");
				break;
        }
    }

    // Icons for all bestiary entries by ID
    void Bestiary_StatIcons(int icons1, int icons2, int icons3, int id)
    {
        switch(id)
        {
            case  38: // 001 Keese (L1)
                ArrayCopySetSize(icons1, {7,11});
                ArrayCopySetSize(icons2, {1});
                break;
			case  40: // 002 Keese (L2)
				ArrayCopySetSize(icons1, {7,11});
                ArrayCopySetSize(icons2, {2});
				break;
			case  90: // 003 Keese (L3)
				ArrayCopySetSize(icons1, {7,11});
                ArrayCopySetSize(icons2, {2,1});
				break;
			case 185: // 004 Popo (L1)
				ArrayCopySetSize(icons1, {1});
				ArrayCopySetSize(icons2, {1});
				break;
			case 186: // 005 Popo (L2)
				ArrayCopySetSize(icons1, {1});
				ArrayCopySetSize(icons2, {2});
				break;
			case 187: // 006 Popo (L3)
				ArrayCopySetSize(icons1, {1});
				ArrayCopySetSize(icons2, {2,1});
				break;
			case  41: // 007 Stalfos (L1)
				ArrayCopySetSize(icons1, {9});
				ArrayCopySetSize(icons2, {1});
				break;
			case  79: // 008 Stalfos (L2)
				ArrayCopySetSize(icons1, {9});
				ArrayCopySetSize(icons2, {2});
				break;
			case 120: // 009 Stalfos (L3)
				ArrayCopySetSize(icons1, {9});
				ArrayCopySetSize(icons2, {2,1});
				break;
			case 479: // 010 Stalfos (L4)
				ArrayCopySetSize(icons1, {9});
				ArrayCopySetSize(icons2, {2,2});
				break;
			case 160: // 011 Rat
				ArrayCopySetSize(icons2, {1});
				break;
			case  20: // 012 Octorok (L1)
				ArrayCopySetSize(icons1, {3});
				ArrayCopySetSize(icons2, {1});
				break;
			case  21: // 013 Octorok (L2)
				ArrayCopySetSize(icons1, {3});
				ArrayCopySetSize(icons2, {1});
				break;
			case 139: // 014 Octorok (L3)
				ArrayCopySetSize(icons1, {3});
				ArrayCopySetSize(icons2, {2});
				break;
			case  25: // 015 Tektite (L1)
				ArrayCopySetSize(icons1, {3,4,5});
				ArrayCopySetSize(icons2, {1});
				break;
			case  24: // 016 Tektite (L2)
				ArrayCopySetSize(icons1, {3,4,5});
				ArrayCopySetSize(icons2, {1});
				break;
			case  42: // 017 Tektite (L3)
				ArrayCopySetSize(icons1, {3,4,5});
				ArrayCopySetSize(icons2, {2});
				break;
			case  26: // 018 Leever (L1)
				ArrayCopySetSize(icons2, {1});
				break;
			case  27: // 019 Leever (L2)
