							 329,  37,  39, 258, 204, 214, 333,  49,  50, 159, // 050 - 060
							 165,  60,  54, 335,  52, 336,  48,  65, 231, 230, // 060 - 070
							 198, 236,  59, 255,  75, 188, 189, 190, 216, 138, // 070 - 080
							 323, 259, 343, 193, 194, 334, 496, 201, 261, 345, // 080 - 090
							 347,  36, 229, 252, 238, 332, 497,  30,  31,  56, // 090 - 100
							 243,  57, 100, 113, 443, 162, 166, 444, 358, 390, // 100 - 110
							  85, 176, 256, 338,  55, 414, 263, 310, 408, 265, // 110 - 120
							 342, 300, 350, 274, 367, 279, 292,  82, 455, 278, // 120 - 130
							 450, 283, 191, 423, 206, 289, 290, 288, 291, 286, // 130 - 140
							 316, 142, 309, 153, 448, 318, 294, 319, 121, 313, // 140 - 150
							 363, 111, 351, 352, 353, 328, 140, 360, 383, 494, // 150 - 160
							 364, 415, 320, 212, 155, 365, 372, 392, 396,  70, // 160 - 170
							 397, 327, 398, 405, 413, 118, 341,  51,  87,  81, // 170 - 180
							  91, 122, 359, 495, 135, 478,  35, 161, 464, 227, // 180 - 190
							 277,  73,  76,  72, 354, 454, 424, 476, 489, 490, // 190 - 200
							 457, 477, 461, 421, 475, 466, 473, 487, 488, 463, // 200 - 210
							 301, 411, 158, 157, 446, 447, 474, 356, 484, 205, // 210 - 220
							 203, 202, 233, 207,  62, 174, 211,  68, 180, 164, // 220 - 230
							 213, 355, 217, 218, 219,  61, 220, 222, 223, 225, // 230 - 240
							 234, 242, 246, 244, 248, 250, 262, 285, 271, 287, // 240 - 250
							 275, 273, 305, 284, 298, 302, 308, 293, 321, 152, // 250 - 260
							  58, 337, 109, 339, 340, 295, 366, 368, 374, 375, // 260 - 270
							 376, 377, 378, 382, 395, 399, 192, 400, 401,  77, // 270 - 280
							 141, 172,  66, 145, 143, 151, 232, 169, 235, 304, // 280 - 290
							 306, 163, 407, 389, 445, 420, 425, 226, 150, 215, // 290 - 300
							 168, 361, 105, 112, 426, 107, 384,  69, 409, 385, // 300 - 310
							 386, 387, 388, 410, 412, 317,  74, 416, 417, 303, // 310 - 320
							 418, 452, 281, 326, 456, 458, 460, 462, 428, 465, // 320 - 330
							 467, 429, 362, 299, 276, 330, 254, 272, 297, 307, // 330 - 340
							 282, 312, 431, 432, 433, 434, 435, 436, 437, 438, // 340 - 350
							 439, 440, 441, 442, 449, 253, 239, 257, 324, 228, // 350 - 360
							 406,  43, 480, 481, 482, 483, 419, 427, 430, 503  // 360 - 370
						  };
        ArrayCopySetSize(arr, enemyList);
        return;
    }

