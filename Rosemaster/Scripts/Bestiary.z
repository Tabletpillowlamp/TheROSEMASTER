enum
{
    GSUBBIT_TEXTBOX,
    GSUBBIT_OVERLAY,

    GSUBBIT_SIZE
};

generic script GlobalSubscreenBitmaps
{
    void run()
    {
        this->ExitState[GENSCR_ST_CONTINUE] = true;
        this->ExitState[GENSCR_ST_RELOAD] = true;

        bitmap textbox = Game->CreateBitmap(256, 176);
        bitmap overlay = Game->CreateBitmap(256, 176);
        textbox->Own();
        overlay->Own();
        this->DataSize = GSUBBIT_SIZE;
        this->Data[GSUBBIT_TEXTBOX] = textbox;
        this->Data[GSUBBIT_OVERLAY] = overlay;
        while(true)
        {
            Waitframe();
        }
    }
}