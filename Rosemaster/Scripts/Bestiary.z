namespace Bestiary
{
    // Create the following widgets with the following labels to add new elements
    // to the subscreen. Labels that don't exist on the subscreen will be ignored:

    // Essential components:

    // Tile Block: BESTIARY_ICON
    // Text: BESTIARY_NAME
    // Text Box: BESTIARY_DESCRIPTION
    // Rectange: BESTIARY_LIST

    // Scrollbars to show the progress of scrolling elements:

    // Rectangle (Optional): BESTIARY_DESCRIPTION_SCROLLBAR
    // Rectangle (Optional): BESTIARY_LIST_SCROLLBAR

    // Stat counters for some stats set in the enemy editor:

    // Text (Optional): BESTIARY_STAT_HP
    // Text (Optional): BESTIARY_STAT_DAMAGE
    // Text (Optional): BESTIARY_STAT_WDAMAGE
    // Text (Optional): BESTIARY_STAT_STEP

    // Stat counters for some stats that are set by script:

    // Text (Optional): BESTIARY_STAT_CUSTOM_X (replace X with the number of the stat starting with 0)

    // Stat icon sets for things like strengths and weaknesses:

    // Tile Block (Optional): BESTIARY_STAT_ICONS_0
    // Tile Block (Optional): BESTIARY_STAT_ICONS_1
    // Tile Block (Optional): BESTIARY_STAT_ICONS_2

    // Configurable strings that change per enemy:

    // Text (Optional): BESTIARY_STAT_STRING_0
    // Text (Optional): BESTIARY_STAT_STRING_1
    // Text (Optional): BESTIARY_STAT_STRING_2

    // Bestiary completion indicators:

    // Text (Optional): BESTIARY_COMPLETION_FRACTIONAL
    // Text (Optional): BESTIARY_COMPLETION_PERCENT

    CONFIGB BESTIARY_SHOW_ENEMY_NUMBERS = true; // If true, enemy numbers are drawn before names
    CONFIGB BESTIARY_ENEMY_NUMBERS_ZERO_INDEXED = false; // If true, enemy numbers count starting from 0

    CONFIG BESTIARY_PAGE = 3; // Page the bestiary widgets go on
    CONFIG BESTIARY_MAX_ENEMY_STATS = 5; // Maximum number of custom enemy stats
    CONFIG BESTIARY_ENEMY_LIST_VISIBLE_COUNT = 10; // Number of enemy entries visible at once
    CONFIG BESTIARY_STAT_ICON_SPACING = 16; // How far spaced apart stat icons should be
    CONFIG BESTIARY_DESCRIPTION_LINE_PADDING = 2; // Spacing between each line in descriptions

    CONFIG TIL_BESTIARY_DRAW_OVERLAY = 105560; // A 16x11 block of tiles that gets overlaid on the whole subscreen for draws commands

    // Tile, cset, and scale for scrollbars
    CONFIG TIL_SCROLLBAR = 105532;
    CONFIG CS_SCROLLBAR = 7;
    CONFIG SCROLLBAR_WIDTH = 6;
    CONFIG SCROLLBAR_HEIGHT = 5;

    // Tile and cset for the selector tile
    CONFIG TIL_SELECTOR = 105534;
    CONFIG CS_SELECTOR = 7;

    CONFIG FONT_BESTIARY_ENEMY_LIST = FONT_Z3SMALL; // Font for the list of enemies
    CONFIG SHD_BESTIARY_ENEMY_LIST = SHD_OUTLINED8; // Shadow style for the enemy list

    CONFIG C_TEXT_BESTIARY_ENEMY_LIST = 0x01; // Names of enemies in the list
    CONFIG C_TEXT_BESTIARY_ENEMY_LIST_SELECTED = 0x88; // Names of selected enemies in the list
    CONFIG C_TEXT_BESTIARY_ENEMY_LIST_UNREAD = 0x73; // Names of enemies that have not been read yet
    CONFIG C_TEXT_BESTIARY_ENEMY_LIST_UNKNOWN = 0x02; // Names of unnown enemies in the list
    CONFIG C_TEXT_BESTIARY_OUTLINE = 0x0F; // Outline color for the bestiary

    // Buttons for scrolling the enemy list (slow)
    CONFIG CB_SELECTUP = CB_UP;
    CONFIG CB_SELECTDOWN = CB_DOWN;
    // Buttons for scrolling the enemy list (fast)
    CONFIG CB_FSELECTUP = CB_EX1;
    CONFIG CB_FSELECTDOWN = CB_EX2;
    // Buttons for scrolling the enemy description
    CONFIG CB_DESCSCROLLUP = CB_B;
    CONFIG CB_DESCSCROLLDOWN = CB_A;

    CONFIG TEXT_SCROLL_SPEED = 1; // Speed the enemy description scrolls by

    CONFIG SFX_BESTIARY_CURSOR = SFX_CURSOR; // Sound of the cursor moving in the list

    using namespace StringWrapping;
    using namespace MenuInputHandler;

    // Gets the list of all enemy IDs in the order they appear
    void Bestiary_GetEntryList(int arr)
    {
        // Array of all enemies in order
        int enemyList[] = { 
							  38,  40,  90, 185, 186, 187,  41,  79, 120, 479, // 000 - 010
							 160,  20,  21, 139,  25,  24,  42,  26,  27, 137, // 010 - 020
