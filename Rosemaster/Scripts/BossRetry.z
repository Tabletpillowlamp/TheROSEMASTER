		//printf("===P5=== %d\n", idChar);
		
		// Setting up Player FFC
		if(idChar == c_LINK)	  { fcpD = LINK_Down;  fcpU = LINK_Up;  fcpC = LINK_Cset; }
		else if(idChar == c_CAIN) { fcpD = CAIN_Down;  fcpU = CAIN_Up;  fcpC = CAIN_Cset; }
		else if(idChar == c_CIEL1){ fcpD = CIEL1_Down; fcpU = CIEL1_Up; fcpC = CIEL_Cset; }
		else if(idChar == c_CIEL2){ fcpD = CIEL2_Down; fcpU = CIEL2_Up; fcpC = CIEL_Cset; }
		else if(idChar == c_AURE1){ fcpD = AURE1_Down; fcpU = AURE1_Up; fcpC = AURE_Cset; }
		else if(idChar == c_AURE2){ fcpD = AURE2_Down; fcpU = AURE2_Up; fcpC = AURE_Cset; }
		else if(idChar == c_INGR1){ fcpD = INGR1_Down; fcpU = INGR1_Up; fcpC = INGR_Cset; }
		else if(idChar == c_INGR2){ fcpD = INGR2_Down; fcpU = INGR2_Up; fcpC = INGR_Cset; }
		
		// Printing FFC
		ffc p = Screen->LoadFFC(5);
		ffc enemy1 = Screen->LoadFFC(6);
		ffc enemy2 = Screen->LoadFFC(7);
		
		p->Data = fcpD;
		p->CSet = fcpC;
		
		enemy1->X 			= fcX1;
		enemy1->Y 			= fcY1;
		enemy1->TileWidth 	= fcW1;
		enemy1->TileHeight 	= fcH1;
		enemy1->CSet 		= fcC1;
		enemy1->Data 		= fcD1;
		
		enemy2->X 			= fcX2;
		enemy2->Y 			= fcY2;
		enemy2->TileWidth 	= fcW2;
		enemy2->TileHeight 	= fcH2;
		enemy2->CSet 		= fcC2;
		enemy2->Data 		= fcD2;
		
		
		// Wait for other animation to finish
		for(int i=0; i<140; ++i){
			Link->Action=LA_STUNNED;
			WaitNoAction();
		}
		
		int deathCount[256];
		int curPos = 0;
		
		// Display Menu
		while(true){
			Link->Action=LA_STUNNED;
			// Display Text
			sprintf(deathCount," Deaths: %d",Game->NumDeaths);
			Screen->DrawString(6, 32, 56, 69, 0x7C, -1, TF_CENTRED, deathCount, OP_OPAQUE);
			Screen->DrawString(6, 128, 136, 69, 0x01, -1, TF_CENTRED, "Retry this fight?", OP_OPAQUE);
			Screen->DrawString(6, 96, 152, 69, 0x88, -1, TF_CENTRED, "Yes", OP_OPAQUE);
			Screen->DrawString(6, 160, 152, 69, 0x88, -1, TF_CENTRED, "No", OP_OPAQUE);
			// Draw Cursor
			if(curPos == 0){FastTile(6,68,148,61,8,OP_OPAQUE);}
			else{FastTile(6,132,148,61,8,OP_OPAQUE);}
			// Move Left or Right
			if(Link->PressLeft||Link->PressRight){
				Game->PlaySound(5);
				if(curPos == 0){curPos = 1;}
				else{curPos = 0;}
			}
			// Confirm
			if(Link->PressA||Link->PressStart){
				break;
			}
			WaitNoAction();
		}
		
		// Play Confirm Sound
		Game->PlaySound(91);
		
		// Flashing
		for(int i=0; i<50; ++i){
			// Display Text
			sprintf(deathCount," Deaths: %d",Game->NumDeaths);
			Screen->DrawString(6, 32, 56, 69, 0x7C, -1, TF_CENTRED, deathCount, OP_OPAQUE);
			Screen->DrawString(6, 128, 136, 69, 0x01, -1, TF_CENTRED, "Retry this fight?", OP_OPAQUE);
			// Flash Yes
			if(curPos == 0){
				if(i % 4 > 1){
					Screen->DrawString(6, 96, 152, 69, 0x73, -1, TF_CENTRED, "Yes", OP_OPAQUE);	
				}
				else{
					Screen->DrawString(6, 96, 152, 69, 0x88, -1, TF_CENTRED, "Yes", OP_OPAQUE);
				}
				Screen->DrawString(6, 160, 152, 69, 0x88, -1, TF_CENTRED, "No", OP_OPAQUE);
			}
			else{
				if(i % 4 > 1){
					Screen->DrawString(6, 160, 152, 69, 0x73, -1, TF_CENTRED, "No", OP_OPAQUE);	
				}
				else{
					Screen->DrawString(6, 160, 152, 69, 0x88, -1, TF_CENTRED, "No", OP_OPAQUE);
				}
				Screen->DrawString(6, 96, 152, 69, 0x88, -1, TF_CENTRED, "Yes", OP_OPAQUE);	
			}
			// Draw Cursor
			if(curPos == 0){FastTile(6,68,148,61,8,OP_OPAQUE);}
			else{FastTile(6,132,148,61,8,OP_OPAQUE);}
			Link->Action=LA_STUNNED;
			WaitNoAction();
		}
		
		
		
		if(curPos == 0){
			
			//Add Death Counter
			Game->NumDeaths += 1;
			Game->PlaySound(94);
			
			for(int i=0; i<100; ++i){
				// Display Text
				if(i == 50){ // Get Up
					p->Data = fcpU;
					Game->PlaySound(60);
				}
				sprintf(deathCount," Deaths: %d",Game->NumDeaths);
				Screen->DrawString(6, 32, 56, 69, 0x7C, -1, TF_CENTRED, deathCount, OP_OPAQUE);
				Link->Action=LA_STUNNED;
				WaitNoAction();
			}
			
			// Wait
			for(int i=0; i<30; ++i){
				Link->Action=LA_STUNNED;
				WaitNoAction();
			}
			
			// Play Message
			if (idText > 0){
				Screen->Message(idText);
				// Wait one more time
				for(int i=0; i<30; ++i){
					Link->Action=LA_STUNNED;
					WaitNoAction();
				}
			}
			
			// Heal up and Warp Back to Fight
			Game->LoadGenericData(CheckGenericScript("IvoryBlessing"))->Running = false;
			Game->LoadGenericData(CheckGenericScript("CureTomeGen"))->Running = false;
			itemdata idat = Game->LoadItemData(226);
			idat->Tile = 23759;
			idat->SetDisplayName("Cure Tome");
			Link->MP = Link->MaxMP;
			Game->BottleState[1] = gd->Data[1];
			Game->BottleState[2] = gd->Data[2];
			Game->BottleState[3] = gd->Data[3];
			Game->BottleState[4] = gd->Data[4];
			Game->Counter[1] = gd->Data[5];	// Rupees
			Game->Counter[2] = gd->Data[6];	// Bombs
			Game->Counter[3] = gd->Data[7];	// Arrows
			Game->Counter[6] = gd->Data[8];	// Super Bombs
			Game->Counter[7] = gd->Data[9];	// Bombchus
			if(mChange >= 0){
				Game->PlayMIDI(mChange);
				Waitframes(1);
				Link->WarpEx({WT_IWARP,idDmap,idScr,-1,3,WARPEFFECT_OPENWIPE,25,0,idDir});
			}
			else{
				Link->WarpEx({WT_IWARP,idDmap,idScr,-1,3,WARPEFFECT_OPENWIPE,25,4,idDir});
			}
			
			
		}
		else{	// Kill Link
			Link->Kill(true);
		}
		
	}
}

