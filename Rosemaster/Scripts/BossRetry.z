generic script BossRetryVariables
{
    void run()
    {
        /*
			
			Data[0]: Boss ID
			Data[1]: Bottle 1 Content
			Data[2]: Bottle 2 Content
			Data[3]: Bottle 3 Content
			Data[4]: Bottle 4 Content
			Data[5]: Rupee Count
			Data[6]: Bomb Count
			Data[7]: Arrow Count
			Data[8]: Super Bomb Count
			Data[9]: Bombchu Count
		
		*/
    }
}

ffc script RetryBossExceptions{
	void run(int type){
		
		/*
			type == 0: Save Bottle Types
			type == 1: 
			type == 2: Final Boss Autolose
		*/
		
		genericdata gd = Game->LoadGenericData(CheckGenericScript("BossRetryVariables"));
		gd->DataSize = 10;
		
		if(type == 0){
			gd->Data[1] = Game->BottleState[1];
			gd->Data[2] = Game->BottleState[2];
			gd->Data[3] = Game->BottleState[3];
			gd->Data[4] = Game->BottleState[4];
			gd->Data[5] = Game->Counter[1];   // Rupees
			gd->Data[6] = Game->Counter[2];   // Bombs
			gd->Data[7] = Game->Counter[3];   // Arrows
			gd->Data[8] = Game->Counter[6];   // Super Bombs
			gd->Data[9] = Game->Counter[7];   // Bombchus
		}
		else if(type == 1){
			// Heal up and Warp Back to Fight
			Game->LoadGenericData(CheckGenericScript("IvoryBlessing"))->Running = false;
			Game->LoadGenericData(CheckGenericScript("CureTomeGen"))->Running = false;
			itemdata idat = Game->LoadItemData(226);
			idat->Tile = 23759;
			idat->SetDisplayName("Cure Tome");
			Link->MP = Link->MaxMP;
			Game->BottleState[1] = gd->Data[1];
			Game->BottleState[2] = gd->Data[2];
			Game->BottleState[3] = gd->Data[3];
			Game->BottleState[4] = gd->Data[4];
			if(Game->Counter[1] < gd->Data[5]){
				Game->Counter[1] = gd->Data[5];	// Rupees
			}
			Game->Counter[2] = gd->Data[6];	// Bombs
			Game->Counter[3] = gd->Data[7];	// Arrows
			Game->Counter[6] = gd->Data[8];	// Super Bombs
			Game->Counter[7] = gd->Data[9];	// Bombchus
		}
		else if(type == 2){
			if(Link->Item[146]){
				if(Link->Item[151]){
					gd->Data[0] = 154;
				}
				else{
					gd->Data[0] = 132;
				}
				Link->WarpEx({WT_IWARP,372,0x20,-1,0,WARPEFFECT_NONE,25,4});
			}
			else{
				Link->Kill(true);
			}
		}
		
	}
}

ffc script RetryBossMain{
	void run(int bossID, int noSave){
		
		genericdata gd = Game->LoadGenericData(CheckGenericScript("BossRetryVariables"));
		gd->DataSize = 10;
		
		// Setting the initial properties
		if(noSave == 0){
			gd->Data[0] = bossID;
			gd->Data[1] = Game->BottleState[1];
			gd->Data[2] = Game->BottleState[2];
			gd->Data[3] = Game->BottleState[3];
			gd->Data[4] = Game->BottleState[4];
			gd->Data[5] = Game->Counter[1];   // Rupees
			gd->Data[6] = Game->Counter[2];   // Bombs
			gd->Data[7] = Game->Counter[3];   // Arrows
			gd->Data[8] = Game->Counter[6];   // Super Bombs
			gd->Data[9] = Game->Counter[7];   // Bombchus
		}
		
		// Boss Loop
		while(true){
			if ( Link->HP <= 0 &&
			    (Game->BottleState[1] != 6 && Game->BottleState[1] != 7) && 
				(Game->BottleState[2] != 6 && Game->BottleState[2] != 7) && 
				(Game->BottleState[3] != 6 && Game->BottleState[3] != 7) && 
				(Game->BottleState[4] != 6 && Game->BottleState[4] != 7) &&
				 Link->Item[146] == true){
				// Fully Heal Link
				Link->HP = Link->MaxHP;
				// Warp Link
				Link->WarpEx({WT_IWARP,372,0x20,-1,0,WARPEFFECT_NONE,25,4});
			}
			Waitframe();
		}
	}
}

