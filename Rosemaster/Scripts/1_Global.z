global script onContinue	//Run this on both onSaveLoad and onContinue
{
    void run()
    {
		dMapMidiChange();
		
		// Let Link Move again if F6-ing out mid-pause
		Game->Suspend[susptLINK] = false;
		Game->Suspend[susptGUYS] = false;
		Game->Suspend[susptEWEAPONS] = false;
		
		// Initialize Generic Variables
		RunGenericScript(CheckGenericScript("DamageNumbersGeneric"));
		RunGenericScript(CheckGenericScript("GlobalSubscreenBitmaps"));
		RunGenericScript(CheckGenericScript("EquipBackup"));
		RunGenericScript(CheckGenericScript("BossRetryVariables"));
		
		//Change Cure Tome's Graphic
		Game->LoadItemData(226)->Tile = 23759;
		Game->LoadItemData(226)->SetDisplayName("Cure Tome");
		
		//Vodka Effects Remove
		if (Player->Item[252]){Player->Item[252]=false;}
		
		//Change Shields to reflect current equipped one
		Game->LoadItemData(135)->Level = 1;
		Game->LoadItemData(shield_sel)->Level = 2;
    }
}


global script onSaveAndExit	//Runs when on the F6 screen and exiting
{
    void run()
    {
		EquipButtonItems(0);
    }
}


	