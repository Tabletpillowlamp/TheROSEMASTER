// ======================== BARRIERS ========================

// Function that makes preparations for barriers on each screen and starts an FFC script
void Barriers_NewScreen(){
	// Search for a barrier-related combo
	for (int i = 0; i <= 175; ++i) {
		int cd = Screen->ComboD[i];
		if (cd == BARRIER_A_RAISED || cd == BARRIER_A_LOWERED || cd == BARRIER_A_SWITCH ||
			cd == BARRIER_B_RAISED || cd == BARRIER_B_LOWERED || cd == BARRIER_B_SWITCH ||
			cd == BARRIER_A_RAISED+40 || cd == BARRIER_A_LOWERED+40 || cd == BARRIER_A_SWITCH+40 ||
			cd == BARRIER_B_RAISED+40 || cd == BARRIER_B_LOWERED+40 || cd == BARRIER_B_SWITCH+40 ||
			cd == BARRIER_A_RAISED+192 || cd == BARRIER_A_LOWERED+192 || cd == BARRIER_A_SWITCH+192 ||
			cd == BARRIER_B_RAISED+192 || cd == BARRIER_B_LOWERED+192 || cd == BARRIER_B_SWITCH+192 ){
			// A barrier-related combo was found
			
			// Make initial changes to combos
			if (barriers[Game->GetCurDMap()]){
				for (int j = i; j <= 175; ++j){
					int cd = Screen->ComboD[j];
					if (cd == BARRIER_A_RAISED) Screen->ComboD[j] = BARRIER_A_LOWERED;
					else if (cd == BARRIER_B_LOWERED) Screen->ComboD[j] = BARRIER_B_RAISED;
					else if (cd == BARRIER_A_SWITCH) Screen->ComboD[j] = BARRIER_B_SWITCH;
					else if (cd == BARRIER_A_RAISED+40) Screen->ComboD[j] = BARRIER_A_LOWERED+40;
					else if (cd == BARRIER_B_LOWERED+40) Screen->ComboD[j] = BARRIER_B_RAISED+40;
					else if (cd == BARRIER_A_SWITCH+40) Screen->ComboD[j] = BARRIER_B_SWITCH+40;
					else if (cd == BARRIER_A_RAISED+192) Screen->ComboD[j] = BARRIER_A_LOWERED+192;
					else if (cd == BARRIER_B_LOWERED+192) Screen->ComboD[j] = BARRIER_B_RAISED+192;
					else if (cd == BARRIER_A_SWITCH+192) Screen->ComboD[j] = BARRIER_B_SWITCH+192;
				}
			}
			else {
				for (int j = i; j <= 175; j++){
					int cd = Screen->ComboD[j];
					if (cd == BARRIER_B_RAISED) Screen->ComboD[j] = BARRIER_B_LOWERED;
					else if (cd == BARRIER_A_LOWERED) Screen->ComboD[j] = BARRIER_A_RAISED;
					else if (cd == BARRIER_B_SWITCH) Screen->ComboD[j] = BARRIER_A_SWITCH;
					else if (cd == BARRIER_B_RAISED+40) Screen->ComboD[j] = BARRIER_B_LOWERED+40;
					else if (cd == BARRIER_A_LOWERED+40) Screen->ComboD[j] = BARRIER_A_RAISED+40;
					else if (cd == BARRIER_B_SWITCH+40) Screen->ComboD[j] = BARRIER_A_SWITCH+40;
					else if (cd == BARRIER_B_RAISED+192) Screen->ComboD[j] = BARRIER_B_LOWERED+192;
					else if (cd == BARRIER_A_LOWERED+192) Screen->ComboD[j] = BARRIER_A_RAISED+192;
					else if (cd == BARRIER_B_SWITCH+192) Screen->ComboD[j] = BARRIER_A_SWITCH+192;
				}
			}
			// So run FFCscript to control barriers
			int args[] = {0,0,0,0,0,0,0,0};
			RunFFCScript(SCRIPT_BARRIERS, args);
			break;
		}
	}
}

// This lets you toggle barriers on any dmap
bool ToggleBarriers(int dmap) {
	if (dmap == Game->GetCurDMap()) ToggleBarriers();
	else barriers[dmap] = !barriers[dmap];
	return barriers[dmap];
}

// This toggles barriers on the current dmap
bool ToggleBarriers() {
	int curdmap = Game->GetCurDMap();
	if (!barriers[curdmap]){
		barriers[curdmap] = true;
		for (int i = 0; i <= 175; i++){
			int cd = Screen->ComboD[i];
			if (cd == BARRIER_A_RAISED || cd == BARRIER_A_WALKABLE || cd == BARRIER_A_ANIMRAISE){
				Screen->ComboD[i] = BARRIER_A_ANIMLOWER;
			}
			else if (cd == BARRIER_B_LOWERED || cd == BARRIER_B_ANIMLOWER){
				Screen->ComboD[i] = BARRIER_B_ANIMRAISE;
			}
			else if (cd == BARRIER_A_SWITCH){
				Screen->ComboD[i] = BARRIER_B_SWITCH;
			}
			else if (cd == BARRIER_A_RAISED+40 || cd == BARRIER_A_WALKABLE+40 || cd == BARRIER_A_ANIMRAISE+40){
				Screen->ComboD[i] = BARRIER_A_ANIMLOWER+40;
			}
			else if (cd == BARRIER_B_LOWERED+40 || cd == BARRIER_B_ANIMLOWER+40){
				Screen->ComboD[i] = BARRIER_B_ANIMRAISE+40;
			}
			else if (cd == BARRIER_A_SWITCH+40){
				Screen->ComboD[i] = BARRIER_B_SWITCH+40;
			}
			else if (cd == BARRIER_A_RAISED+192 || cd == BARRIER_A_WALKABLE+192 || cd == BARRIER_A_ANIMRAISE+192){
				Screen->ComboD[i] = BARRIER_A_ANIMLOWER+192;
			}
			else if (cd == BARRIER_B_LOWERED+192 || cd == BARRIER_B_ANIMLOWER+192){
				Screen->ComboD[i] = BARRIER_B_ANIMRAISE+192;
			}
			else if (cd == BARRIER_A_SWITCH+192){
				Screen->ComboD[i] = BARRIER_B_SWITCH+192;
			}
		}
	}
	else {
		barriers[curdmap] = false;
		for (int i = 0; i <= 175; i++){
			int cd = Screen->ComboD[i];
			if (cd == BARRIER_B_RAISED || cd == BARRIER_B_WALKABLE || cd == BARRIER_B_ANIMRAISE){
				Screen->ComboD[i] = BARRIER_B_ANIMLOWER;
			}
			else if (cd == BARRIER_A_LOWERED || cd == BARRIER_A_ANIMLOWER){
				Screen->ComboD[i] = BARRIER_A_ANIMRAISE;
			}
			else if (cd == BARRIER_B_SWITCH){
				Screen->ComboD[i] = BARRIER_A_SWITCH;
			}
			else if (cd == BARRIER_B_RAISED+40 || cd == BARRIER_B_WALKABLE+40 || cd == BARRIER_B_ANIMRAISE+40){
				Screen->ComboD[i] = BARRIER_B_ANIMLOWER+40;
			}
			else if (cd == BARRIER_A_LOWERED+40 || cd == BARRIER_A_ANIMLOWER+40){
				Screen->ComboD[i] = BARRIER_A_ANIMRAISE+40;
			}
			else if (cd == BARRIER_B_SWITCH+40){
				Screen->ComboD[i] = BARRIER_A_SWITCH+40;
			}
			else if (cd == BARRIER_B_RAISED+192 || cd == BARRIER_B_WALKABLE+192 || cd == BARRIER_B_ANIMRAISE+192){
				Screen->ComboD[i] = BARRIER_B_ANIMLOWER+192;
			}
			else if (cd == BARRIER_A_LOWERED+192 || cd == BARRIER_A_ANIMLOWER+192){
				Screen->ComboD[i] = BARRIER_A_ANIMRAISE+192;
			}
			else if (cd == BARRIER_B_SWITCH+192){
				Screen->ComboD[i] = BARRIER_A_SWITCH+192;
			}
		}
	}
	return barriers[curdmap];
}	

