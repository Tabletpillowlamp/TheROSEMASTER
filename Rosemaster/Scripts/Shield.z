generic script ShieldSelection
{
	void run(int itemID)
	{
		Game->PlaySound(91);
		
		Game->LoadItemData(135)->Level = 1;	//None
		Game->LoadItemData(93)->Level = 1; 	//Small Shield
		Game->LoadItemData(210)->Level = 1;	//Moogle
		Game->LoadItemData(213)->Level = 1;	//Chocobo
		Game->LoadItemData(212)->Level = 1;	//Baby Link
		Game->LoadItemData(211)->Level = 1;	//Linkle
		Game->LoadItemData(136)->Level = 1;	//Knight's Armor
		Game->LoadItemData(8)->Level = 1; 	//Big Shield
		Game->LoadItemData(37)->Level = 1;	//Mirror Shield
		Game->LoadItemData(187)->Level = 1;	//Business Suit
		Game->LoadItemData(168)->Level = 1;	//Ninja Gear
		Game->LoadItemData(239)->Level = 1;	//Lana Outfit
		Game->LoadItemData(240)->Level = 1;	//Omega Tank
		Game->LoadItemData(103)->Level = 1;	//Classic Mode
		Game->LoadItemData(12)->Level = 1;	//Black Dragon
		Game->LoadItemData(105)->Level = 1;	//Purple Dragon
		Game->LoadItemData(65)->Level = 1; 	//Orange Dragon
		Game->LoadItemData(63)->Level = 1;	//Green Dragon
		Game->LoadItemData(26)->Level = 1;	//Blue Dragon
		Game->LoadItemData(118)->Level = 1;	//White Dragon
		Game->LoadItemData(90)->Level = 1;	//Red Dragon
		
		Game->LoadItemData(itemID)->Level = 2;	
		shield_sel = itemID;
		
		Waitframe();
	}
}