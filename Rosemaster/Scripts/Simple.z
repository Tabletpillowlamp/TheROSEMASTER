ffc script DragonMusic{
	void run(int bmidi, int nmidi, int type){
		int color = 1; int stringLeft = 7843; int stringDragGet = 7849;
		while(true){
			if(Screen->D[2] < 0||Screen->SecretsTriggered()){
				if(Screen->SecretsTriggered()){
					if (Screen->D[2] == -3){
						for(int i = 0; i <= 360; i++){
							if(i == 50 || i == 150 || i == 270){
								Game->PlaySound(89);
								if(type==1){color = 0xB9;}
								else if(type==2){color = 0xA4;} else if(type==3){color = 0x88;}
								else if(type==4){color = 0x78;} else if(type==5){color = 0x74;}
								else if(type==6){color = 0x72;} else if(type==7){color = 0x84;}
								RunFFCScript(56, {color, 40, 0});
							}
							if(i == 210){
								Screen->Message(stringLeft + Game->Counter[33]);
							}
							if(i == 330){
								if(nmidi < 0){ //Green Dragon nMusic
									if(Game->Counter[11] < 8){Game->PlayMIDI(69);}
									else{Game->PlayMIDI(71);}
								}
								else{Game->PlayMIDI(nmidi);}
								Screen->Message(stringDragGet + type);
							}
							Game->SkipF6 = true; Link->InputStart = false; Link->PressStart = false;
							Link->InputMap = false; Link->PressMap = false;
							Link->InputL = false; Link->PressL = false;
							Link->InputR = false; Link->PressR = false;
							NoAction(); Waitframe();
						}
						Screen->D[2] = 4;
					}
					if(nmidi < 0){ //Green Dragon nMusic
						if(Game->Counter[11] < 8){Game->PlayMIDI(69);}
						else{Game->PlayMIDI(71);}
					}
					else{Game->PlayMIDI(nmidi);}
				}
				else{
					Game->SkipF6 = true; Link->InputStart = false; Link->PressStart = false;
					Link->InputMap = false; Link->PressMap = false;
					Link->InputL = false; Link->PressL = false;
					Link->InputR = false; Link->PressR = false;
					NoAction(); Game->PlayMIDI(0);
				}
			}
			else{
				Game->PlayMIDI(bmidi);
				Link->PressMap = false; Link->InputMap = false;
			}
			Waitframe();
		}
	}
}

ffc script EnemyMusic
{
	void run(int bmidi, int nmidi, int mainBoss)
	{
		if (mainBoss != 0){
			while(true){
				if (Screen->D[2] < 0){
					if (Screen->SecretsTriggered()){
						if (Screen->D[2] == -2){
							Screen->D[2] = 3;
						}
						Game->PlayMIDI(nmidi);
					}
					else{
						Game->PlayMIDI(0);
					}
				}
				else{
					if (Screen->SecretsTriggered()){
						Game->PlayMIDI(nmidi);
					}
					else {
						Game->PlayMIDI(bmidi);
						Link->PressMap = false; Link->InputMap = false;
					}
				}
				Waitframe();
			}
		}
		else{
			while(true)
			{
				if (Screen->NumNPCs() != 0)
				{
					Game->PlayMIDI(bmidi);
				}
				else
				{
					Game->PlayMIDI(nmidi);
				}
				Waitframe();
			}
		}
	}
}

