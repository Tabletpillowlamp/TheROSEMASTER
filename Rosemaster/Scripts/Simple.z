// Number of frames and A.Speed for animations
// Walking
CONFIG TERRORPIN_FRAMES_WALK = 2;
CONFIG TERRORPIN_ASPEED_WALK = 8;
// Flipped over
CONFIG TERRORPIN_FRAMES_FLIP = 2;
CONFIG TERRORPIN_ASPEED_FLIP = 8;

// Settings for the enemy's flip arc
CONFIG TERRORPIN_FLIP_JUMP = 2.4; // Initial jump
CONFIG TERRORPIN_FLIP_BOUNCES = 2; // Extra bounces
CONFIG TERRORPIN_FLIP_DECAY = 0.3; // Decay of the jump value for each bounce
CONFIG TERRORPIN_FLIP_SPEED_MULT = 1.0; // Multiplier for the enemy's movement speed in mid air

// Settings for 8-way fireballs
CONFIG TERRORPIN_FIREBALL_STEP = 250;
CONFIG SFX_TERRORPIN_FIREBALL = SFX_FIREBALL;

@InitD0("Hammer Distance"),
@InitDHelp0("Distance in pixels the enemy detects hammer hits for. 40 by default."),
@InitD1("Flip Time"),
@InitDHelp1("How many frames the enemy stays flipped for. 180 by default."),
@InitD2("Can Reflip?"),
@InitDHelp2("If true, the hammer can still flip the enemy when vulnerable."),
@InitD3("Firing Min Steps"),
@InitDHelp3("If >0, the enemy takes this many steps before firing (minimum)."),
@InitD4("Firing Max Steps"),
@InitDHelp4("If >0, the enemy takes this many steps before firing (maximum).")
npc script Terrorpin
{
    using namespace NPCAnim;
    using namespace GhostBasedMovement;
    enum Animations
    {
        ANIM_WALK,
        ANIM_FLIP
    };
    void run(int hammerDist, int flipTime, bool canReflip, int fireMin, int fireMax)
    {
        Waitspawn(this);
        
        if(!hammerDist)
            hammerDist = 40;
        if(!flipTime)
            flipTime = 180;
        AnimHandler aptr = new AnimHandler(this);
        aptr->AddAnim(ANIM_WALK, 0, TERRORPIN_FRAMES_WALK, TERRORPIN_ASPEED_WALK, 0);
        aptr->AddAnim(ANIM_FLIP, TERRORPIN_FRAMES_WALK, TERRORPIN_FRAMES_FLIP, TERRORPIN_ASPEED_FLIP, 0);

        int defenses[MAX_DEFENSE];
        for(int i=0; i<MAX_DEFENSE; ++i)
        {
            defenses[i] = this->Defense[i];
            this->Defense[i] = i==NPCD_HAMMER?NPCDT_IGNORE:NPCDT_BLOCK;
        }

        int counter = -1;
        while(true)
        {
            int fireTimer = Rand(fireMin, fireMax);
            int oldPos = ComboAt(this->X+8, this->Y+8);
            int pos = oldPos;
            // Walking
            while(true)
            {
                pos = ComboAt(this->X+8, this->Y+8);
                if(pos!=oldPos)
                {
                    oldPos = pos;
                    if(fireTimer)
                    {
                        --fireTimer;
                        if(!fireTimer)
                        {
                            fireTimer = Rand(fireMin, fireMax);
                            for(int j=0; j<48; ++j)
                            {
                                if(DetectHammer(this, hammerDist, false))
                                    break;
                                if(j==16)
                                {
                                    for(int i=0; i<8; ++i)
                                    {
                                        eweapon e = FireEWeaponDir(WeaponTypeToID(this->Weapon), this->X, this->Y, i, TERRORPIN_FIREBALL_STEP, this->WeaponDamage, this->WeaponSprite, SFX_TERRORPIN_FIREBALL);
                                    }
                                }
                                Waitframe(this);
                            }
                        }
                    }
                }
                counter = ConstWalk4(this, counter);
                if(DetectHammer(this, hammerDist, false))
                    break;
                Waitframe(this);
            }
            // Flipping
            aptr->PlayAnim(ANIM_FLIP);
            int jump = TERRORPIN_FLIP_JUMP;
            this->Dir = AngleDir4(Angle(Link->X, Link->Y, this->X, this->Y));
            for(int i=0; i<TERRORPIN_FLIP_BOUNCES+1; ++i)
            {
                this->Jump = jump;
                jump *= TERRORPIN_FLIP_DECAY;
                while(this->Jump>0||this->Z>0)
                {
                    this->Move(OppositeDir(this->Dir), this->Step/100*TERRORPIN_FLIP_SPEED_MULT);
                    Waitframe(this);
                }
            }
            // Make vulnerable
            for(int i=0; i<MAX_DEFENSE; ++i)
                this->Defense[i] = defenses[i];
            int frames = flipTime;
            while(true)
            {
                if(frames)
                    --frames;
                if(frames<60)
                {
                    this->DrawXOffset = (frames%4<2)?-1:1;
                }
                if(frames==0||(canReflip&&DetectHammer(this, hammerDist, true)))
                    break;
                Waitframe(this);
            }
            this->DrawXOffset = 0;
            // Make invulnerable
            for(int i=0; i<MAX_DEFENSE; ++i)
                this->Defense[i] = i==NPCD_HAMMER?NPCDT_IGNORE:NPCDT_BLOCK;
            // Flipping
            aptr->PlayAnim(ANIM_WALK);
            jump = TERRORPIN_FLIP_JUMP;
            this->Dir = AngleDir4(Angle(this->X, this->Y, Link->X, Link->Y));
            for(int i=0; i<TERRORPIN_FLIP_BOUNCES+1; ++i)
            {
                this->Jump = jump;
                jump *= TERRORPIN_FLIP_DECAY;
                while(this->Jump>0||this->Z>0)
                {
                    this->Move(this->Dir, this->Step/100*TERRORPIN_FLIP_SPEED_MULT);
                    Waitframe(this);
                }
            }
            // Slide back onto the grid
            int tX = GridX(this->X+8);
            int tY = GridY(this->Y+8);
            int safety = Ceiling(32/(this->Step/100));
            while(safety&&Distance(this->X, this->Y, tX, tY)>this->Step/100)
            {
                --safety;
                this->MoveAtAngle(Angle(this->X, this->Y, tX, tY), this->Step/100);
                Waitframe(this);
            }
            counter = -1;
        }
    }
    bool DetectHammer(npc this, int hammerDist, bool checkInvFrames)
    {
        if(this->HitBy[HIT_BY_LWEAPON])
            return false;
        if(checkInvFrames&&this->InvFrames)
            return false;
        for(int i=Screen->NumLWeapons(); i>0; --i)
        {
            lweapon l = Screen->LoadLWeapon(i);
            if(l->ID==LW_HAMMER)
            {
                if((l->Tile-l->OriginalTile)%3==2)
                {
                    int cx = l->X+l->HitWidth/2;
                    int cy = l->Y+l->HitHeight/2;
                    if(Distance(this->X+8, this->Y+8, cx, cy)<hammerDist)
                        return true;
                }
            }
        }
        return false;
    }
}

generic script freezeScreenGeneric{
	void run(int frames, int sfx, int flashColor, int flashFrames){
		Game->PlaySound(sfx);
		while(flashFrames > 0 && flashColor > 0){
			if(Link->Item[47]){
				if(flashFrames % 40 < 20){
					Screen->Rectangle(6, 0, 0, 256, 172, flashColor, 1, 0, 0, 0, true, 64);
				}
			}
			else{
				if(flashFrames % 2 == 0){
					Screen->Rectangle(6, 0, 0, 256, 172, flashColor, 1, 0, 0, 0, true, 64);
				}
			}
			flashFrames--;
			frames--;
			Waitframe();
		}
		if(frames > 0){
			Waitframes(frames);
		}
	}
}

generic script donkiElevator{
	void run(){
		int fontE = 69; int warping = 0;
		int floorCur[255]; int floorOp1[255];
		int floorOp2[255]; int floorOp3[255];
		int floorCurText; int floorOp1Text;
		int floorOp2Text; int floorOp3Text;
		int curPos = 0; int cy = 64;
		int donkiDmap = 333; int goUp = 0x00; int goDown = 0x10; int goDir = 0;
		int op1Go = 0; int op2Go = 0; int op3Go = 0;
		bool opUp1 = true; bool opUp2 = true; bool opUp3 = true;
		switch(Game->Counter[17]){
			case 0:
				sprintf(floorCur,"1F"); sprintf(floorOp1,"2F");
				sprintf(floorOp2,"3F"); sprintf(floorOp3,"4F");
				opUp1 = true; opUp2 = true; opUp3 = true;
				op1Go = 1; op2Go = 2; op3Go = 3;
				break;
			case 1:
				sprintf(floorCur,"2F"); sprintf(floorOp1,"1F");
				sprintf(floorOp2,"3F"); sprintf(floorOp3,"4F");
				opUp1 = false; opUp2 = true; opUp3 = true;
				op1Go = 0; op2Go = 2; op3Go = 3;
				break;
			case 2:
				sprintf(floorCur,"3F"); sprintf(floorOp1,"1F");
				sprintf(floorOp2,"2F"); sprintf(floorOp3,"4F");
				opUp1 = false; opUp2 = false; opUp3 = true;
				op1Go = 0; op2Go = 1; op3Go = 3;
				break;
			case 3:
				sprintf(floorCur,"4F"); sprintf(floorOp1,"1F");
				sprintf(floorOp2,"2F"); sprintf(floorOp3,"3F");
				opUp1 = false; opUp2 = false; opUp3 = false;
				op1Go = 0; op2Go = 1; op3Go = 2;
				break;
		}
		floorCurText = floorCur; floorOp1Text = floorOp1;
		floorOp2Text = floorOp2; floorOp3Text = floorOp3;
		while(true){
			
			Screen->DrawString(6, 13, 35, fontE, 0x79, -1, 0, "Current:", OP_OPAQUE);
			Screen->DrawString(6, 12, 34, fontE, 0x01, -1, 0, "Current:", OP_OPAQUE);
			Screen->DrawString(6, 59, 35, fontE, 0x79, -1, 0, floorCurText, OP_OPAQUE);
			Screen->DrawString(6, 58, 34, fontE, 0x78, -1, 0, floorCurText, OP_OPAQUE);
			Screen->DrawString(6, 21, 51, fontE, 0x79, -1, 0, "Go to...", OP_OPAQUE);
			Screen->DrawString(6, 20, 50, fontE, 0x01, -1, 0, "Go to...", OP_OPAQUE);
			
			Screen->DrawString(6, 21, 65, fontE, 0x89, -1, 0, "Cancel", OP_OPAQUE);
			Screen->DrawString(6, 20, 64, fontE, 0x88, -1, 0, "Cancel", OP_OPAQUE);
			
			Screen->DrawString(6, 21, 81, fontE, 0x89, -1, 0, floorOp1Text, OP_OPAQUE);
			Screen->DrawString(6, 20, 80, fontE, 0x88, -1, 0, floorOp1Text, OP_OPAQUE);
			Screen->DrawString(6, 21, 97, fontE, 0x89, -1, 0, floorOp2Text, OP_OPAQUE);
			Screen->DrawString(6, 20, 96, fontE, 0x88, -1, 0, floorOp2Text, OP_OPAQUE);
			Screen->DrawString(6, 21, 113, fontE, 0x89, -1, 0, floorOp3Text, OP_OPAQUE);
			Screen->DrawString(6, 20, 112, fontE, 0x88, -1, 0, floorOp3Text, OP_OPAQUE);
			
			switch(curPos){
				case 0: cy = 60; break;
				case 1: cy = 76; break;
				case 2: cy = 92; break;
				case 3: cy = 108; break;
			}
			FastTile(6,4,cy,61,8,OP_OPAQUE);
			
			if(Link->PressUp){
				Game->PlaySound(5);
				if(curPos == 0){ curPos = 3; }
				else{ curPos -= 1; }
			}
			if(Link->PressDown){
				Game->PlaySound(5);
				if(curPos == 3){ curPos = 0; }
				else{ curPos += 1; }
			}
			
			if(Link->PressB||(Link->PressA && curPos==0)){
				break;
			}
			
			if(Link->PressA && curPos>0){
				if(curPos == 1){
					if(opUp1){goDir = goUp;}else{goDir = goDown;}
					Game->Counter[17] = op1Go;
				}
				else if(curPos == 2){
					if(opUp2){goDir = goUp;}else{goDir = goDown;}
					Game->Counter[17] = op2Go;
				}
				else{
					if(opUp3){goDir = goUp;}else{goDir = goDown;}
					Game->Counter[17] = op3Go;
				}
				warping = 1;
				break;
			}
			Waitframe();
		}
		if(warping==1){Link->WarpEx({WT_IWARP,donkiDmap,goDir,-1,-1,WARPEFFECT_NONE,25,4});};
	}
}

eweapon script ArcingSummon
{
    void run(int tX, int tY, int enemyID)
    {
        this->MoveFlags[NPCMV_OBEYS_GRAVITY] = true;
        this->Jump = AW_PredictJumpFromDurationBruteForce(Distance(this->X, this->Y, tX, tY)/(this->Step/100), 0.16, 3.2, 0);
        while(this->Z>0||this->Jump>0)
        {
            Waitframe();
        }
        if(enemyID)
        {
            if(!Screen->isSolid(tX+8, tY+8))
            {
                npc n = CreateNPCAt(enemyID, tX, tY);
            }
        }
        else
        {
            this->Step = 0;
            Waitframe();
        }
        this->Remove();
    }
    // Predicts the duration of a jump from its force
    int AW_PredictDurationFromJump(int jump, int grav, int terminalv, int z=0)
    {
        int frames;
        while(z>0||jump>0)
        {
            z += jump;
            if(jump>=-terminalv)
                jump -= grav;
            ++frames;
        }
        return frames;
    }
    // Predicts the force of a jump from its duration
    // This uses logic from ghost.zh and is not perfectly accurate
    int AW_PredictJumpFromDuration(int frames, int grav, int terminalv)
    {
        if(frames<2)
            frames = 2;
        int ret=0;
        
        // Every increase in velocity of GH_GRAVITY means two frames in the air.
        // This might overshoot by a frame, but that's all right.
        while(ret<=terminalv)
        {
            ret+=grav;
            frames-=2;
            if(frames<=0)
                return ret;
        }
        
        // Needs to exceed terminal velocity. Slightly trickier here, because
        // an increase of GH_GRAVITY may mean more than two more frames in the air.
        int excess=0; // Distance left to fall after reaching TV
        while(frames>excess/terminalv)
        {
            ret+=grav;
            excess+=ret-terminalv;
            frames-=2;
        }
        
        return ret;
    }
    // Predicts the force of a jump from its duration
    // This uses brute forcing in addition to the ghost method to narrow down a more accurate jump value
    int AW_PredictJumpFromDurationBruteForce(int frames, int grav, int terminalv, int z)
    {
        if(frames<2)
            frames = 2;
            
        int ret = AW_PredictJumpFromDuration(Distance(0, 0, frames, z), grav, terminalv);
        int low = ret;
        int high = ret;
        int durLow = AW_PredictDurationFromJump(low, grav, terminalv, z);
        int durHigh = durLow;
        
        int closest = ret;
        int durClosest;
        
        for(int i=0; i<10; ++i)
        {
            if(durLow==frames)
                return low;
            if(durHigh==frames)
                return high;
            if(durLow>durHigh)
            {
                int tmp = low;
                int durtmp = durLow;
                low = high;
                durLow = durHigh;
                high = tmp;
                durHigh = durtmp;
            }
            if(durLow<frames&&durHigh>frames)
            {
                closest = (low+high)/2;
                durClosest = AW_PredictDurationFromJump(closest, grav, terminalv, z);
                if(durClosest<frames)
                {
                    low = closest;
                    durLow = durClosest;
                }
                else{
                    high = closest;
                    durHigh = durClosest;
                }
            }
            else if(durHigh<frames)
            {
                int pct = frames/durLow;
                high *= pct;
                durHigh = AW_PredictDurationFromJump(high, grav, terminalv, z);
            }
            else if(durLow>frames)
            {
                int pct = frames/durHigh;
                low *= pct;
                durLow = AW_PredictDurationFromJump(low, grav, terminalv, z);
            }
        }
        return closest;
    }
}

ffc script ContinueScreenSet{
	void run(int touch, int Exception, int touchID){ // Touch means Link must touch the FCC in order to spawn again.
		// Exception 1: Lotz Battle in Chapter 3 in Elignita Capital
		if(Exception == 1 && Game->Counter[12] < 8){
			Waitframe();
		}
		// Excpetion 2: Ord Desert First Entrance
		else if(Exception == 2){
			Game->ContinueDMap = 27;
			Game->ContinueScreen = 0x0F;
			Game->LastEntranceDMap = 27;
			Game->LastEntranceScreen = 0x0F;
		}
		// Excpetion 3: Ord Desert Second Entrance
		else if(Exception == 3){
			Game->ContinueDMap = 27;
			Game->ContinueScreen = 0x4C;
			Game->LastEntranceDMap = 27;
			Game->LastEntranceScreen = 0x4C;
		}
		// Excpetion 4: Sealed Realm Shadgoon Village
		else if(Exception == 4){
			Game->ContinueDMap = 237;
			Game->ContinueScreen = 0x74;
			Game->LastEntranceDMap = 237;
			Game->LastEntranceScreen = 0x74;
		}
		else{
			if(touch){
				while (Distance(Hero->X, Hero->Y, Screen->WarpReturnX[touchID], Screen->WarpReturnY[touchID]) > 4){
					Waitframe();
				}
			}
			Game->ContinueDMap = Game->GetCurDMap();
			Game->ContinueScreen = Game->GetCurScreen();
			Game->LastEntranceDMap = Game->GetCurDMap();
			Game->LastEntranceScreen = Game->GetCurScreen();
		}
	}
}

ffc script ToggleEasyMode{	//0 = OFF, 1 = ON
	void run(int id, int dragon){
		switch(id){
			case 0:
				Link->Item[203] = false;
				if(Link->Item[41]){
					Link->Item[167] = true;
					Game->Counter[37] = 1;
				}
				break;
			case 1:
				if(dragon == 0 || !Screen->SecretsTriggered()){
					Link->Item[203] = true;
					if(Link->Item[167]){
						Game->Counter[37] = 2;
						Link->Item[167] = false;
					}
				}
				break;
		}
	}
}

ffc script DeathDisabler{
	void run(int autowarp){
		while(true){
			if ( Link->HP <= 0 &&
			     (Game->BottleState[1] != 6 && Game->BottleState[1] != 7) && 
				 (Game->BottleState[2] != 6 && Game->BottleState[2] != 7) && 
				 (Game->BottleState[3] != 6 && Game->BottleState[3] != 7) && 
				 (Game->BottleState[4] != 6 && Game->BottleState[4] != 7) ){
				Link->HP = Link->MaxHP;
				Link->MP = Link->MaxMP;
				this->Data = autowarp;
				Quit();
			}
			Waitframe();
		}
	}
}	

ffc script HostBar{
	void run(int id, int wait){
		switch(id){
			case 0: //Link moves down if he declines
				int targetY = 120;
				Waitframes(wait);
				while(Link->Y <= targetY){
					Link->InputDown = true;
					Waitframe();
				}
				Waitframes(30);
				Link->WarpEx({WT_IWARP,338,0x70,-1,-1,WARPEFFECT_NONE,25,4,1});
				break;
			case 1: //Check to see if Link has the right costumes
				if( Game->LoadItemData(211)->Level == 2 || Game->LoadItemData(239)->Level == 2 || Game->LoadItemData(105)->Level == 2 ){
					Link->WarpEx({WT_IWARP,338,0x01,-1,-1,WARPEFFECT_NONE,25,4,0});
				}
				break;
			case 2: //Second Time Check (Link must have the same costume)
				if( (Game->LoadItemData(211)->Level == 2 && Game->Counter[38] == 1) || (Game->LoadItemData(239)->Level == 2 && Game->Counter[38] == 2) || (Game->LoadItemData(105)->Level == 2 && Game->Counter[38] == 3) ){
					Link->WarpEx({WT_IWARP,338,0x11,-1,-1,WARPEFFECT_NONE,25,4,0});
				}
				break;
			case 3: //Set Shad Counter
				if(shield_sel == 211){ // Linkle
					Game->Counter[38] = 1;
				}
				else if(shield_sel == 239){ // Lana
					Game->Counter[38] = 2;
				}
				else{	// Purple Dragon
					Game->Counter[38] = 3;
				}
				break;
			case 4: //Can't press start to open menu
				while(true){
					Link->InputStart = false; Link->PressStart = false;
					Waitframe();
				}
				break;
			case 5: //Link exits the Bar
				int targetY = 72;
				Waitframes(60);
				while(Link->Y <= targetY){
					Link->InputDown = true;
					Waitframe();
				}
				Link->Dir = DIR_UP;
				while(Screen->D[1] == 0){
					Waitframe();
				}
				Waitframes(60);
				while(true){
					Link->InputDown = true;
					Waitframe();
				}
				break;
			case 6: //Secrets check for 2nd visit
				if (Screen->SecretsTriggered()){
					Link->WarpEx({WT_IWARP,338,0x10,-1,-1,WARPEFFECT_NONE,25,4,0});
				}
				break;
			case 7: //Secrets check for 3rd visit
				if (Screen->SecretsTriggered()){
					Link->WarpEx({WT_IWARP,338,0x21,-1,-1,WARPEFFECT_NONE,25,4,0});
				}
				break;
		}
	}
}

ffc script KillLink{
	void run(int wait){
		Waitframes(wait);
		Link->Kill(true);
	}
}

ffc script SkywardTreeSatellite{
	void run(int type){
		if(type == 1){ //Warp if Counter is 4 Unlocks main door
			Game->Counter[40] += 1;
			Waitframes(180);
			if(Screen->D[1] == 1){ //Cain
				Game->Counter[16] = 49;
			}
			else if(Screen->D[1] == 2){ //Ciela
				Game->Counter[16] = 53;
			}
			else if(Screen->D[1] == 3){ //Aurelia
				Game->Counter[16] = 81;
			}
			else if(Screen->D[1] == 4){ //Ingrid
				Game->Counter[16] = 85;
			}
			//Warp
			if(Game->Counter[40] >= 4){
				Link->WarpEx({WT_IWARP,341,5,16,128,WARPEFFECT_ZAP,25,0});
			}
		}
		else if(type == 2){ //Warp back after door unlocks
			Waitframes(10);
			int mapWarp = Game->Counter[16];
			int xPos = 128;
			if(mapWarp == 49 || mapWarp == 81){
				xPos = 112;
			}
			//Warp
			int wflags;
			wflags |= WARP_FLAG_SETENTRANCEDMAP;
			wflags |= WARP_FLAG_SETCONTINUEDMAP;
			Link->WarpEx({WT_IWARP,340,mapWarp,xPos,88,WARPEFFECT_WAVE,25,wflags});
		}
	}
}

ffc script DreadTower{
	void run(int type, int id1, int id2, int id3){
		int cMin = 41;	int cSec = 42; int cFra = 43;
		int bMin = 44;	int bSec = 45; int bFra = 46;
		if(type == 0){ //Timer Running (id1 = 1, no stop sec)
			while(!(Screen->SecretsTriggered()&&id1==0)&&!(Game->Counter[cMin]==99&&Game->Counter[cSec]>=59&&Game->Counter[cFra]>=59)){
				Waitframe();
				if(Game->Counter[cFra] >= 59){
					if(Game->Counter[cSec] >= 59){
						Game->Counter[cMin]++;
						Game->Counter[cSec] = 0;
					}
					else{
						Game->Counter[cSec]++;
					}
					Game->Counter[cFra] = 0;
				}
				else{
					Game->Counter[cFra]++;
				}
			}
		}
		else if(type == 1){ //Reset Current Timer
			Game->Counter[41] = 0;
			Game->Counter[42] = 0;
			Game->Counter[43] = 0;
		}
		else if(type == 2){ //Entering a new floor (id1 = x, id2 = y)
			//Move Link either until he's in position or 4 seconds have passed
			for(int i=0; i<=240&&(Link->X!=id1||Link->Y!=id2); i++){
				//Prevent moving around while moving Link into position
				Link->InputStart = false; Link->PressStart = false;
				Link->InputMap = false; Link->PressMap = false;
				PegasusBoots::UserInterruptDash();
				NoAction();
				//Apply inputs that should be active
				if(Abs(Link->X-id1)<=2){
					Link->X = id1;
				}
				else{
					if(Link->X<id1)
						Link->InputRight = true;
					else if(Link->X>id1)
						Link->InputLeft = true;
				}
				if(Abs(Link->Y-id2)<=2){
					Link->Y = id2;
				}
				else{
					if(Link->Y<id2)
						Link->InputDown = true;
					else if(Link->Y>id2)
						Link->InputUp = true;
				}
				Waitframe();
			}
			
			//Close Door
			if(id3 > 0){
				Game->PlaySound(9);
			}
			if(id3 == 1){ //Door Up
				Game->LoadTempScreen(0)->ComboD[ComboAt(112,16)] = 4118;
				Game->LoadTempScreen(0)->ComboD[ComboAt(128,16)] = 4119;
			}
			else if(id3 == 2){ //Door Down
				Game->LoadTempScreen(0)->ComboD[ComboAt(112,144)] = 4122;
				Game->LoadTempScreen(0)->ComboD[ComboAt(128,144)] = 4123;
			}
			else if(id3 == 3){ //Door Left
				Game->LoadTempScreen(0)->ComboD[ComboAt(16,64)] = 4116;
				Game->LoadTempScreen(0)->ComboD[ComboAt(16,80)] = 4120;
				Game->LoadTempScreen(0)->ComboD[ComboAt(16,96)] = 4124;
			}
			else if(id3 == 4){ //Door Right
				Game->LoadTempScreen(0)->ComboD[ComboAt(224,64)] = 4117;
				Game->LoadTempScreen(0)->ComboD[ComboAt(224,80)] = 4121;
				Game->LoadTempScreen(0)->ComboD[ComboAt(224,96)] = 4125;
			}
			else if(id3 == 5){ //Sideview Left
				Game->LoadTempScreen(0)->ComboD[ComboAt(0,112)] = 17792;
				Game->LoadTempScreen(0)->ComboD[ComboAt(0,128)] = 17792;
			}
			else if(id3 == 6){ //Sideview Down
				Game->LoadTempScreen(0)->ComboD[ComboAt(96,160)] = 15871;
			}
			else if(id3 == 7){ //Sideview Right
				Game->LoadTempScreen(0)->ComboD[ComboAt(240,112)] = 17806;
				Game->LoadTempScreen(0)->ComboD[ComboAt(240,128)] = 17806;
			}
		}
		else if(type == 3){ //Saving Best Time
			Waitframes(60);
			if(!Screen->SecretsTriggered() || Game->Counter[cMin] < Game->Counter[bMin]){
				Game->Counter[bMin] = Game->Counter[cMin];
				Game->Counter[bSec] = Game->Counter[cSec];
				Game->Counter[bFra] = Game->Counter[cFra];
			}
			else if (Game->Counter[cMin] == Game->Counter[bMin] && Game->Counter[cSec] < Game->Counter[bSec]){
				Game->Counter[bSec] = Game->Counter[cSec];
				Game->Counter[bFra] = Game->Counter[cFra];	
			}
			else if (Game->Counter[cSec] == Game->Counter[bSec] && Game->Counter[cFra] < Game->Counter[bFra]){
				Game->Counter[bFra] = Game->Counter[cFra];
			}
		}
		else if(type == 4){ //Display Best Time
			if(Screen->SecretsTriggered()){
				int bestMin[256]; int bestSec[256]; int bestFra[256];
				
				if(Game->Counter[bMin] == 0){sprintf(bestMin,"00");}
				else if(Game->Counter[bMin] < 10){sprintf(bestMin,"0%d",Game->Counter[bMin]);}
				else{sprintf(bestMin,"%d",Game->Counter[bMin]);}
				
				if(Game->Counter[bSec] == 0){sprintf(bestSec,"00");}
				else if(Game->Counter[bSec] < 10){sprintf(bestSec,"0%d",Game->Counter[bSec]);}
				else{sprintf(bestSec,"%d",Game->Counter[bSec]);}
				
				if(Game->Counter[bFra] == 0){sprintf(bestFra,"00");}
				else if(Game->Counter[bFra] < 10){sprintf(bestFra,"0%d",Game->Counter[bFra]);}
				else{sprintf(bestFra,"%d",Game->Counter[bFra]);}
				
				while(true){
					Screen->DrawString(2, 129, 30, FONT_SUBSCREEN3, 0x88, -1, TF_NORMAL, bestMin, OP_OPAQUE, SHD_SHADOWED, 0x89);
					Screen->DrawString(2, 142, 30, FONT_SUBSCREEN3, 0x88, -1, TF_NORMAL, ":", OP_OPAQUE, SHD_SHADOWED, 0x89);
					Screen->DrawString(2, 146, 30, FONT_SUBSCREEN3, 0x88, -1, TF_NORMAL, bestSec, OP_OPAQUE, SHD_SHADOWED, 0x89);
					Screen->DrawString(2, 159, 30, FONT_SUBSCREEN3, 0x88, -1, TF_NORMAL, ":", OP_OPAQUE, SHD_SHADOWED, 0x89);
					Waitframe();
					Screen->DrawString(2, 163, 30, FONT_SUBSCREEN3, 0x88, -1, TF_NORMAL, bestFra, OP_OPAQUE, SHD_SHADOWED, 0x89);
				}
			}
		}
		else if(type == 5){ //Purple Glory Squad Card
			int id1; int id2; int warpScreen;
			if(Link->Item[151]){
				warpScreen = 102;
			}
			else{
				warpScreen = 118;
			}
			
			if(Link->Y <= 64){
				id1 = 112; id2 = 64;
				while(Link->X!=id1||Link->Y!=id2){
					//Prevent moving around while moving Link into position
					Link->InputStart = false; Link->PressStart = false;
					Link->InputMap = false; Link->PressMap = false;
					PegasusBoots::UserInterruptDash();
					NoAction();
					//Apply inputs that should be active
					if(Abs(Link->X-id1)<=2){
						Link->X = id1;
					}
					else{
						if(Link->X<id1)
							Link->InputRight = true;
						else if(Link->X>id1)
							Link->InputLeft = true;
					}
					if(Abs(Link->Y-id2)<=2){
						Link->Y = id2;
					}
					else{
						if(Link->Y<id2)
							Link->InputDown = true;
						else if(Link->Y>id2)
							Link->InputUp = true;
					}
					Waitframe();
				}
				while(Link->Y!=96){
					Link->InputStart = false; Link->PressStart = false;
					Link->InputMap = false; Link->PressMap = false;
					PegasusBoots::UserInterruptDash();
					NoAction();
					if(Abs(Link->Y-96)<=2){
						Link->Y = 96;
					}
					else{
						if(Link->Y<96)
							Link->InputDown = true;
						else if(Link->Y>96)
							Link->InputUp = true;
					}
					Waitframe();
				}
			}
			id1 = 128; id2 = 104;
			while(Link->X!=id1||Link->Y!=id2){
				//Prevent moving around while moving Link into position
				Link->InputStart = false; Link->PressStart = false;
				Link->InputMap = false; Link->PressMap = false;
				PegasusBoots::UserInterruptDash();
				NoAction();
				//Apply inputs that should be active
				if(Abs(Link->X-id1)<=2){
					Link->X = id1;
				}
				else{
					if(Link->X<id1)
						Link->InputRight = true;
					else if(Link->X>id1)
						Link->InputLeft = true;
				}
				if(Abs(Link->Y-id2)<=2){
					Link->Y = id2;
				}
				else{
					if(Link->Y<id2)
						Link->InputDown = true;
					else if(Link->Y>id2)
						Link->InputUp = true;
				}
				Waitframe();
			}
			Link->Dir = DIR_UP;
			Waitframes(60);
			Link->WarpEx({WT_IWARP,357,warpScreen,-1,-1,WARPEFFECT_NONE,25,4});
		}
		else if(type == 6){ //Display Seth Shop
			int sethInvest[256];
			
			sprintf(sethInvest,"%d",Game->Counter[13]);
			
			int colorA = 0x84; int colorB = 0x85;
			
			if(Game->Counter[13] >= 6000){ // Gun Reward
				colorA = 0x78; colorB = 0x79;
			}
			else if(Game->Counter[13] >= 4000){ // 500 Rupee Reward
				colorA = 0x88; colorB = 0x89;
			}
			else if(Game->Counter[13] >= 2000){ // 50 Seashell Reward
				colorA = 0x89; colorB = 0x8A;
			}
			
			while(true){
				Screen->DrawString(2, 168, 14, FONT_SUBSCREEN3, colorA, -1, TF_CENTERED, sethInvest, OP_OPAQUE, SHD_SHADOWED, colorB);
				Waitframe();
			}
		}
	}
}

ffc script timerDisplay{
	void run(int secs){
		int onesTimer = 25791;
		int tensTimer = 25811;
		int timerX = 192;
		int timerY = 0;
		int winCset = 7;
		int i2 = secs;
		
		for(int i=secs*60; i>0; i--){
			if(i!=secs*60&&i%60==0){
				i2-=1;
				if(i2 <= 5){Game->PlaySound(5);}
			}
			if(i2 <= 5){winCset = 8;}
			FastTile(3, timerX, timerY, tensTimer-Floor(i2/10), winCset, OP_OPAQUE);
			FastTile(3, timerX+16, timerY, onesTimer-(i2%10), winCset, OP_OPAQUE);
			Waitframe();
		}
		
		FastTile(3, timerX, timerY, "", 7, OP_OPAQUE);
		
	}
}

