						if (i==1){sprintf(bDes1,"Red Potion");}
						else if (i==2){sprintf(bDes2,"Red Potion");}
						else if (i==3){sprintf(bDes3,"Red Potion");}
						else if (i==4){sprintf(bDes4,"Red Potion");}
						break;
					case 2: 
						bGrap[i] = 21790;
						if (i==1){sprintf(bDes1,"Green Potion");}
						else if (i==2){sprintf(bDes2,"Green Potion");}
						else if (i==3){sprintf(bDes3,"Green Potion");}
						else if (i==4){sprintf(bDes4,"Green Potion");}
						break;
					case 3: 
						bGrap[i] = 21791; 
						if (i==1){sprintf(bDes1,"Yellow Potion");}
						else if (i==2){sprintf(bDes2,"Yellow Potion");}
						else if (i==3){sprintf(bDes3,"Yellow Potion");}
						else if (i==4){sprintf(bDes4,"Yellow Potion");}
						break;
					case 4: 
						bGrap[i] = 21792; 
						if (i==1){sprintf(bDes1,"Blue Potion");}
						else if (i==2){sprintf(bDes2,"Blue Potion");}
						else if (i==3){sprintf(bDes3,"Blue Potion");}
						else if (i==4){sprintf(bDes4,"Blue Potion");}
						break;
					case 5: 
						bGrap[i] = 21793; 
						if (i==1){sprintf(bDes1,"Crystal Potion");}
						else if (i==2){sprintf(bDes2,"Crystal Potion");}
						else if (i==3){sprintf(bDes3,"Crystal Potion");}
						else if (i==4){sprintf(bDes4,"Crystal Potion");}
						break;
					case 6: 
						bGrap[i] = 21794; 
						if (i==1){sprintf(bDes1,"Fairy");}
						else if (i==2){sprintf(bDes2,"Fairy");}
						else if (i==3){sprintf(bDes3,"Fairy");}
						else if (i==4){sprintf(bDes4,"Fairy");}
						break;
					case 7: 
						bGrap[i] = 21795; 
						if (i==1){sprintf(bDes1,"Golden Fairy");}
						else if (i==2){sprintf(bDes2,"Golden Fairy");}
						else if (i==3){sprintf(bDes3,"Golden Fairy");}
						else if (i==4){sprintf(bDes4,"Golden Fairy");}
						break;
					case 8: 
						bGrap[i] = 21796; 
						if (i==1){sprintf(bDes1,"Supplement Goop");}
						else if (i==2){sprintf(bDes2,"Supplement Goop");}
						else if (i==3){sprintf(bDes3,"Supplement Goop");}
						else if (i==4){sprintf(bDes4,"Supplement Goop");}
						break;
					case 9: 
						bGrap[i] = 21797;
						if (i==1){sprintf(bDes1,"White Potion");}
						else if (i==2){sprintf(bDes2,"White Potion");}
						else if (i==3){sprintf(bDes3,"White Potion");}
						else if (i==4){sprintf(bDes4,"White Potion");}
						break;
					case 10: 
						bGrap[i] = 21798; 
						if (i==1){sprintf(bDes1,"Black Potion");}
						else if (i==2){sprintf(bDes2,"Black Potion");}
						else if (i==3){sprintf(bDes3,"Black Potion");}
						else if (i==4){sprintf(bDes4,"Black Potion");}
						break;
					case 11: 
						bGrap[i] = 21799; 
						if (i==1){sprintf(bDes1,"Seashell Vodka");}
						else if (i==2){sprintf(bDes2,"Seashell Vodka");}
						else if (i==3){sprintf(bDes3,"Seashell Vodka");}
						else if (i==4){sprintf(bDes4,"Seashell Vodka");}
						break;
				}
			}
			//Cancel if Link has no Bottle
			if(!Link->Item[bot1]){bType[1] = -1; bGrap[1] = 34;}
			if(!Link->Item[bot2]){bType[2] = -1; bGrap[2] = 34;}
			if(!Link->Item[bot3]){bType[3] = -1; bGrap[3] = 34;}
			if(!Link->Item[bot4]){bType[4] = -1; bGrap[4] = 34;}
			FastTile(6,60,104,bGrap[1],8,OP_OPAQUE);
			FastTile(6,100,104,bGrap[2],8,OP_OPAQUE);
			FastTile(6,140,104,bGrap[3],8,OP_OPAQUE);
			FastTile(6,180,104,bGrap[4],8,OP_OPAQUE);
			
			if(sel2 == 0){
				if (sel1 == 0){
					cX = 44; cY = 128; selText = bDes0;
				}
				else if (sel1 == 1){
					cX = 44; cY = 104; selText = bDes1;
					if(!Link->Item[bot1]){selText = bDes0;}
				}
				else if (sel1 == 2){
					cX = 84; cY = 104; selText = bDes2;
					if(!Link->Item[bot2]){selText = bDes0;}
				}
				else if (sel1 == 3){
					cX = 124; cY = 104; selText = bDes3;
					if(!Link->Item[bot3]){selText = bDes0;}
				}
				else if (sel1 == 4){
					cX = 164; cY = 104; selText = bDes4;
					if(!Link->Item[bot4]){selText = bDes0;}
				}
				Screen->DrawString(6, 60, 132, fontC, 6, -1, 0, "Cancel", OP_OPAQUE);
				Screen->DrawString(6, 196, 132, fontS, 136, -1, TF_RIGHT, selText, OP_OPAQUE);
				if(Link->PressUp){
					Game->PlaySound(5);
					if (sel1 == 0){sel1 = 1;}
					else if (sel1 == 1||sel1 == 2||sel1 == 3||sel1 == 4){sel1 = 0;}
				}
				if(Link->PressDown){
					Game->PlaySound(5);
					if (sel1 == 0){sel1 = 1;}
					else if (sel1 == 1||sel1 == 2||sel1 == 3||sel1 == 4){sel1 = 0;}
				}
				if(Link->PressLeft){
					Game->PlaySound(5);
					if (sel1 == 0){sel1 = 4;}
					else if (sel1 == 1){sel1 = 4;}
					else if (sel1 == 2){sel1 = 1;}
					else if (sel1 == 3){sel1 = 2;}
					else if (sel1 == 4){sel1 = 3;}
				}
				if(Link->PressRight){
					Game->PlaySound(5);
					if (sel1 == 0){sel1 = 1;}
					else if (sel1 == 1){sel1 = 2;}
					else if (sel1 == 2){sel1 = 3;}
					else if (sel1 == 3){sel1 = 4;}
					else if (sel1 == 4){sel1 = 1;}
				}
				if(Link->PressB){
					Quit();
				}
				if(Link->PressA){
					if (sel1 == 0){Quit();}
					else{
						if(Game->BottleState[sel1] <= 0){
							Game->PlaySound(68);
						}
						else{
							Game->PlaySound(91);
							sel2 = 1;
						}
					}
				}
			}
			else{	//Confirmation
				Screen->DrawString(6, 60, 132, fontC, 6, -1, 0, "Discard?", OP_OPAQUE);
				if (sel2 == 1){
					ccX = 120; ccY = 128;
				}
				else if (sel2 == 2){
					ccX = 160; ccY = 128;
				}
				Screen->DrawString(6, 136, 134, fontS, 136, -1, 0, "No", OP_OPAQUE);
				Screen->DrawString(6, 176, 134, fontS, 136, -1, 0, "Yes", OP_OPAQUE);
				if(Link->PressLeft||Link->PressRight){
					Game->PlaySound(5);
					sel2 += 1;
					if (sel2 > 2){sel2 = 1;}
				}
				if(Link->PressB||(Link->PressA&&sel2==1)){
					Game->PlaySound(5);
					sel2 = 0;
				}
				if (Link->PressA&&sel2==2){
					Game->PlaySound(94);
					Game->BottleState[sel1] = 0;
					sel2 = 0;
				}
				FastTile(6,ccX,ccY,cursorG,11,OP_OPAQUE);
			}
			FastTile(6,cX,cY,cursorG,8,OP_OPAQUE);
			
			
			Waitframe();
			
		}
	}
}

ffc script setCounter{
	void run(int counter, int amount, int type){
		// Type = 0: Set
		// Type = 1: Add
		// Type = 2: Sub
		if(type == 0){
			Game->Counter[counter] = amount;
		}
		else if(type == 1){
			Game->Counter[counter] += amount;
		}
		else{
			if(counter==1){ //rupees
				Game->DCounter[counter] -= amount;
			}
			else{
				Game->Counter[counter] -= amount;
			}
		}
	}
}

ffc script SidewarpSecretChange
{
    void run(int dmap, int screen, int dir, int type)
    {
        while (!Screen->State[ST_SECRET])
        {
            Waitframe();
        }
        Screen->SetSideWarp(dir, screen, dmap, type);
    }
}

ffc script screenDataChange{
	void run(int id,int v, int Dragon){
		if (id < 0){
			SetLevelItem(id *= -1, LI_TRIFORCE,1);
		}
		else{
			if (Screen->D[2] >= 0 || Dragon == 1){
				Screen->D[id] = v;
			}
		}
	}
}

ffc script changeDmapSettings{
	void run(int type){
		if (type == 0){
			dMapMidiChange();
		}
		else if (type == 1) { //Before Skillmore Battle in Chapter 6
			changeDMapProperties(119, 87, 14);
		}
	}
}

ffc script LinkItemModifier{
	void run(int type){
		if (type == 0){	//Setting up Moogle Costume for scenario choose
		
			Link->Item[210] = true; //Adding Moogle Costume
			
			//====== Switch Costume ======
			Game->LoadItemData(135)->Level = 1;	//None
			Game->LoadItemData(93)->Level = 1; 	//Small Shield
			Game->LoadItemData(8)->Level = 1; 		//Big Shield
			Game->LoadItemData(212)->Level = 1;	//Baby Link
			Game->LoadItemData(211)->Level = 1;	//Linkle
			Game->LoadItemData(213)->Level = 1;	//Chocobo
			Game->LoadItemData(136)->Level = 1;	//Knight's Armor
			Game->LoadItemData(65)->Level = 1; 	//Orange Dragon
			Game->LoadItemData(105)->Level = 1;	//Purple Dragon
			Game->LoadItemData(12)->Level = 1;		//Black Dragon
			
			Game->LoadItemData(210)->Level = 2;	
			shield_sel = 210;
			//=========================
			
		}
		
		else if (type == 1) { //Removing all potions for Solarette scenario (NO LONGER USED)
		
			for (int i=1; i <= 4; ++i){
				Game->BottleState[i] = 0;
			}
		
		}
		
		else if (type == 2) { //Removing all items for Chapter 8
		
			//Reset Bottles
			for (int i=1; i <= 4; ++i){
				Game->BottleState[i] = 0;
			}
			
			//Removing Items
			Link->Item[3] = false; 		// Bombs
			Link->Item[5] = false; 		// Link's Sword
			Link->Item[6] = false; 		// Master Sword
			Link->Item[10] = false; 	// Lantern
			Link->Item[15] = false; 	// Wooden Bow
			Link->Item[23] = false; 	// Boomerang
			Link->Item[24] = false; 	// Magic Boomerang
			Link->Item[25] = false; 	// Magic Rod
