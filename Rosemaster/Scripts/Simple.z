			Link->Item[201] = false; 	// Fairy Lamp (From Aurelia)
			Link->Item[227] = false;	// Kunai (From Cain)
			
			Link->Item[74] = false; 	// Quiver L1
			Link->Item[75] = false; 	// Quiver L2
			Link->Item[81] = false; 	// Bomb Bag L1
			Link->Item[82] = false; 	// Bomb Bag L2
			Link->Item[148] = false; 	// Bombchu Bag L1
			Link->Item[149] = false; 	// Bomchu Bag L2
			Link->Item[51] = false; 	// Flippers
			Link->Item[19] = false; 	// Bracelets
			Link->Item[174] = false; 	// Cross Ring
			Link->Item[169] = false; 	// Medical Kit
			
			Link->Item[7] = false; 		// Verdant Longblade
			Link->Item[121] = false; 	// Invincibility Cloak
			Link->Item[235] = false; 	// Inferno Rod
			
			//Rupee Reset and Save
			Game->Counter[39] = Game->Counter[1];
			Game->Counter[1] = 0;
			
			//Reset Counters
			Game->Counter[2] = 0;		//Bombs
			Game->MCounter[2] = 0;	
			Game->Counter[3] = 0;		//Arrows
			Game->MCounter[3] = 0;	
			Game->Counter[6] = 0;		//Super Bombs
			Game->MCounter[6] = 0;	
			Game->Counter[7] = 0;		//Bombchus
			Game->MCounter[7] = 0;	
			
			//====== Switch Costume ======
			Game->LoadItemData(210)->Level = 1;	//Changing Moogle Outfit
			Game->LoadItemData(135)->Level = 2;	
			shield_sel = 135;
			//=========================
		
		}
		
		else if (type == 3) { //Remove Temp Costumes
			Link->Item[234] = false;
			Link->Item[251] = false;
		}
		
		else if (type == 4) { //Reset Score for Minigame
			Game->Counter[17] = 0;
		}		
		
		else if (type == 5) { //+1 Score (Final Level Pot Maze)
			Game->Counter[17] += 1;
		}	

		else if (type == 6) { //Reset ROSEMASTER Charge for Final Boss
			Game->Counter[10] = 0;
		}			
		
		else if (type == 7) { //Set Strings for Final Lotz Battle
			messagedata md01 = Game->LoadMessageData(7601);
			messagedata md02 = Game->LoadMessageData(7602);
			messagedata md03 = Game->LoadMessageData(7603);
			messagedata md04 = Game->LoadMessageData(7604);
			messagedata md05 = Game->LoadMessageData(7605);
			messagedata md06 = Game->LoadMessageData(7606);
			messagedata md07 = Game->LoadMessageData(7607);
			messagedata md08 = Game->LoadMessageData(7608);
			messagedata md09 = Game->LoadMessageData(7609);
			messagedata md10 = Game->LoadMessageData(7610);
			
			md01->PortraitTile = 55246; md01->Y = 120; md01->PortraitY = 125;
			char32 str01[1000];
			sprintf(str01, "You should know very well that I was the one behind the %c%c%cROSEMASTER%c%c%c Project.",sc(1),sc(8),sc(5),sc(1),sc(0),sc(1));
			md01->Set(str01);
			md01->Next = 7602;
			md02->PortraitTile = 55246; md02->Y = 120; md02->PortraitY = 125;
			md02->Set("I should have every right to wield this magnificant weapon!");
			md02->Next = 0;
			
			md03->PortraitTile = 55246; md03->Y = 120; md03->PortraitY = 125;
			char32 str03[1000];
			sprintf(str03, "Let's face it, the weak don't deserve resources. %cI had to do what I must in Hinnow Village.",sc(30));
			md03->Set(str03);
			md03->Next = 7604;
			md04->PortraitTile = 55246; md04->Y = 120; md04->PortraitY = 125;
			char32 str04[1000];
			sprintf(str04, "They are weak, and we live by the %c%c%claw of the jungle%c%c%c. Strong men like me deserve %c%c%cEVERYTHING%c%c%c!",sc(1),sc(8),sc(12),sc(1),sc(0),sc(1),sc(1),sc(8),sc(12),sc(1),sc(0),sc(1));
			md04->Set(str04);
			md04->Next = 0;
			
			md05->PortraitTile = 55246; md05->Y = 120; md05->PortraitY = 125;
			md05->Set("Loyalty is a sign of weakness. Which was why I left to Hyrule. I saw an opportunity here, for me.");
			md05->Next = 0;
			
			md06->PortraitTile = 55246; md06->Y = 120; md06->PortraitY = 125;
			char32 str06[1000];
			sprintf(str06, "A man is nothing if he isn't stacked with %c%c%crupees%c%c%c. %cThat's why I made a business deal with Malo!",sc(1),sc(7),sc(8),sc(1),sc(0),sc(1),sc(30));
			md06->Set(str06);
			md06->Next = 0;
			
			md07->PortraitTile = 55246; md07->Y = 120; md07->PortraitY = 125;
			char32 str07[1000];
			sprintf(str07, "Do you see how every Hyrulean here is on their phone? %cMan, they're so easy to manipulate!",sc(30));
			md07->Set(str07);
			md07->Next = 0;
			
			md08->PortraitTile = 55246; md08->Y = 120; md08->PortraitY = 125;
			char32 str08[1000];
			sprintf(str08, "I don't understand why you're trying to take me down. %cAre you just jealous, little boy?",sc(30));
			md08->Set(str08);
			md08->Next = 7609;
			md09->PortraitTile = 55246; md09->Y = 120; md09->PortraitY = 125;
			md09->Set("If you would've just bought my financial course, we could've ruled the world together with ease!");
			md09->Next = 0;
			
			md10->PortraitTile = 55246; md10->Y = 120; md10->PortraitY = 125;
			char32 str10[1000];
			sprintf(str10, "The Tsarina has been defeated. I'm the only ruler left. %cI'm the best leader this world ever had!",sc(30));
			md10->Set(str10);
			md10->Next = 0;
					
		}
		
		else if (type == 8) { //Defeated Cucco Man
			Game->Counter[17] = 999;
		}	
		
		else if (type == 9) { // Set Continue Screen to Link's Room in Elignita Capital. (After Lotz and Zelda Cutscene)
			Game->ContinueDMap = 4;
			Game->ContinueScreen = 0x10;
			Game->LastEntranceDMap = 4;
			Game->LastEntranceScreen = 0x10;	
		}	
		
	}
	int sc (int value){
		return value + 1;
	}
}

item script Ch7Rupees{	//Regain Rupees
	void run(int m){
		// Gain 500 rupees regardless of past rupee count
		if(Game->Counter[39] < 500){
			Game->DCounter[1] += 500;
		}
		else{
			Game->DCounter[1] += Game->Counter[39];
		}
		int item_message[] = "ItemMessageFFC";
		int script_num = Game->GetFFCScript(item_message);
		int args[8] = {m, 0, 0, 0, 0, 0, 0, 0};
		RunFFCScript(script_num, args);
	}
}

ffc script zodiacBoss{	//Randomize and Warp to Random Zodiac Boss
	void run(int id, int amount){
		if (id==0){
			for (int i=1; i<=12; ++i){
				int rng = Rand(1,12);
				while(rng!=0){
					if((rng==1)&&(Game->Counter[19]==0)){
						Game->Counter[19] = i;
						rng = 0;
					}
					else if((rng==2)&&(Game->Counter[20]==0)){
						Game->Counter[20] = i;
						rng = 0;
					}
					else if((rng==3)&&(Game->Counter[21]==0)){
						Game->Counter[21] = i;
						rng = 0;
					}
					else if((rng==4)&&(Game->Counter[22]==0)){
						Game->Counter[22] = i;
						rng = 0;
					}
					else if((rng==5)&&(Game->Counter[23]==0)){
						Game->Counter[23] = i;
						rng = 0;
					}
					else if((rng==6)&&(Game->Counter[24]==0)){
						Game->Counter[24] = i;
						rng = 0;
					}
					else if((rng==7)&&(Game->Counter[25]==0)){
						Game->Counter[25] = i;
						rng = 0;
					}
					else if((rng==8)&&(Game->Counter[26]==0)){
						Game->Counter[26] = i;
						rng = 0;
					}
					else if((rng==9)&&(Game->Counter[27]==0)){
						Game->Counter[27] = i;
						rng = 0;
					}
					else if((rng==10)&&(Game->Counter[28]==0)){
						Game->Counter[28] = i;
						rng = 0;
					}
					else if((rng==11)&&(Game->Counter[29]==0)){
						Game->Counter[29] = i;
						rng = 0;
					}
					else if((rng==12)&&(Game->Counter[30]==0)){
						Game->Counter[30] = i;
						rng = 0;
					}
					else{
						rng = Rand(1,12);
					}
				}
			}
		}
		else if (id==1){ //Zodiac Reset
			Game->Counter[31] = amount;
		}
		else if (id==2){ //Zodiac 1 Battle
			int z0;
			Waitframes(60);
			if(Game->Counter[31]<3){
				if(Game->Counter[31]==0){z0=19;}
				if(Game->Counter[31]==1){z0=20;}
				if(Game->Counter[31]==2){z0=21;}
				if(Game->Counter[z0]==1){Link->WarpEx({WT_IWARP,291,9,-1,-1,WARPEFFECT_NONE,25,4});}
				if(Game->Counter[z0]==2){Link->WarpEx({WT_IWARP,291,25,-1,-1,WARPEFFECT_NONE,25,4});}
				if(Game->Counter[z0]==3){Link->WarpEx({WT_IWARP,291,41,-1,-1,WARPEFFECT_NONE,25,4});}
				if(Game->Counter[z0]==4){Link->WarpEx({WT_IWARP,291,57,-1,-1,WARPEFFECT_NONE,25,4});}
				if(Game->Counter[z0]==5){Link->WarpEx({WT_IWARP,291,73,-1,-1,WARPEFFECT_NONE,25,4});}
				if(Game->Counter[z0]==6){Link->WarpEx({WT_IWARP,291,89,-1,-1,WARPEFFECT_NONE,25,4});}
