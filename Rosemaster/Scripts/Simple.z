ffc script Signpost{
    void run(int m,int input){
        int loc = ComboAt(this->X,this->Y);
        while(true){
            while(!AgainstComboBase(loc) || !SelectPressInput(input)) Waitframe();
            SetInput(input,false);
            Screen->Message(m);
            Waitframe();
        }
    }
    bool AgainstComboBase(int loc){
        return Link->Z == 0 && (Link->Dir == DIR_UP && Link->Y == ComboY(loc)+8 && Abs(Link->X-ComboX(loc)) < 8);
    }
}


item script Message{
	void run(int m){
		int item_message[] = "ItemMessageFFC";
		int script_num = Game->GetFFCScript(item_message);
		int args[8] = {m, 0, 0, 0, 0, 0, 0, 0};
		RunFFCScript(script_num, args);
	}
}

ffc script RemoveFairy{
	void run(){
		for (int i=1; i <= 4; ++i){
			if(Game->BottleState[i] == 6 || Game->BottleState[i] == 7){
				Game->BottleState[i] = 0;
			}
		}
	}
}

ffc script DirectionSet{ //0 = Up, 1 = Down, 2 = Left, 3 = Right
	void run(int dir, int wait){
		Waitframes(wait);
		Link->Dir = dir;
	}
}

item script MessageSpecial{
	void run(){
		Game->Counter[32] += 1;
		int m;
		int item_message[] = "ItemMessageFFC";
		int script_num = Game->GetFFCScript(item_message);
		if ( Game->Generic[GEN_HEARTPIECES] == 0 ) {m = 232;}
		else if ( Game->Generic[GEN_HEARTPIECES] == 1 ) {m = 233;}
		else if ( Game->Generic[GEN_HEARTPIECES] == 2 ) {m = 234;}
		else if ( Game->Generic[GEN_HEARTPIECES] == 3 ) {m = 235;}
		
		int args[8] = {m, 0, 0, 0, 0, 0, 0, 0};
		RunFFCScript(script_num, args);
	}
}

