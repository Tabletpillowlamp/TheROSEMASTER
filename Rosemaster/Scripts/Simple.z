			FastTile(6,92,96,9020,8,OP_OPAQUE); FastTile(6,108,96,9021,8,OP_OPAQUE);
			FastTile(6,92,112,9040,8,OP_OPAQUE); FastTile(6,108,112,9041,8,OP_OPAQUE);
			FastTile(6,132,96,9020,8,OP_OPAQUE); FastTile(6,148,96,9021,8,OP_OPAQUE);
			FastTile(6,132,112,9040,8,OP_OPAQUE); FastTile(6,148,112,9041,8,OP_OPAQUE);
			FastTile(6,172,96,9020,8,OP_OPAQUE); FastTile(6,188,96,9021,8,OP_OPAQUE);
			FastTile(6,172,112,9040,8,OP_OPAQUE); FastTile(6,188,112,9041,8,OP_OPAQUE);
			Screen->DrawString(6, 96, 80, fontT, 1, -1, 0, "Discard Bottles", OP_OPAQUE);
			for(int i = 1; i <= 4; i++){
