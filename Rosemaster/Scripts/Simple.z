ffc script Biggerer{
	void run(int bigwidth, int bigheight, int layer){
		while(true){
			for(int wi=0; wi<=bigwidth-1; wi++){
				for(int hi=0; hi<=bigheight-1; hi++){
					Screen->FastTile(layer, this->X+16*wi, this->Y+16*hi, Game->ComboTile(this->Data)+wi+20*hi, this->CSet, 128);
				}
			}
			Waitframe();
		}
	}
}

ffc script PortalTile
{
    void run(int comboid, int x, int y)
    {
		while(true){
			if(LinkCollision(this)&&(Screen->ComboD[ComboAt(this->X, this->Y)] == comboid))
			{
				
				Screen->TriggerCombo(0, ComboAt(this->X,this->Y));
					
				Game->PlaySound(120);
				Link->X = x;
				Link->Y = y;
			}	
			Waitframe();
		}
	}
}

item script CureTome{
	void run(){
		genericdata gd = Game->LoadGenericData(CheckGenericScript("CureTomeGen"));
		if(!gd->Running)
		{
			gd->Running = true;
		}
		Waitframes(50);
	}
}

generic script CureTomeGen
{
    void run()
    {
		this->ExitState[GENSCR_ST_CONTINUE] = true;
		this->ExitState[GENSCR_ST_RELOAD] = true;
		
		if( Link->MP >= (16 * (Game->Generic[GEN_MAGICDRAINRATE]/2)) ){
			Game->PlaySound(35);
			for(int i=0; i<48; i++){
				FastCombo(6,Link->X,Link->Y-18,9446,10,OP_OPAQUE);
				Link->Action=LA_NONE;
				Link->Action=LA_ATTACKING;
				Waitframe();
			}
			Link->Action=LA_NONE;
			Link->MP -= (16 * (Game->Generic[GEN_MAGICDRAINRATE]/2));
			Game->PlaySound(124);
			RunFFCScript(56, {0xA8, 40, 0});
			Link->HP += 320;
		}
		
		itemdata idat = Game->LoadItemData(226);
		idat->Tile = 23819;
		idat->SetDisplayName("Cure Tome (Used)");
		
		while(true)
		{
			Waitframe();
		}
	}
	
}

item script BottleEffects{
	void run(int dummy, int id){
		//White Potion
		if(Game->BottleState[id]==9){
			bitmap b = Game->CreateBitmap(16,16);
			b->Own();
			Game->PlaySound(35);
			Waitframe();
			int args[8] = {9, 60, 0};
			RunFFCScript(56, args);
			Game->PlaySound(124);
			for(int i = 0; i<360; i++){
				b->Clear(0);
				b->FastTile(0,0,0,Link->Tile,6,OP_OPAQUE);
				if(i%4 < 2){
					b->ReplaceColors(0,0x01,0x01,0xFF);
					b->Blit(SPLAYER_PLAYER_DRAW,RT_SCREEN,0,0,16,16,Link->X,Link->Y-Link->Z,16,16,0,0,0,BITDX_NORMAL,0,true);
				}
				FastCombo(6,240,0,15331,11,OP_OPAQUE);
				Hero->InvFrames = 8;
				Waitframe();
				if (i==300){
					RunFFCScript(56, args);
					Game->PlaySound(124);
				}
			}
		}
		//Black Potion
		if(Game->BottleState[id]==10){
			Game->PlaySound (35);
			Waitframe();
			int args[8] = {15, 60, 0};
			RunFFCScript(56, args);
			Game->PlaySound(89);
			Screen->Wavy = 15;
			npc enemys;
			for(int i = 1; i<=Screen->NumNPCs(); i++){
				enemys = Screen->LoadNPC(i); 
				enemys->HP-=64; 
			}
		}
		//	Seashell Vodka (+1 effect for every 500 Seashells)
		//	1. Increased Speed, Power, and Defense
		//	2. Completely refill health
		//  3. Completely refill magic
		//  4. Regenerating Health
		//  5. Ring of Beams
		//  6. Screenwide Attack
		//  7. Invincibility
		//  8. Spawn Ammo
		//  3500 Seashells - All effects activate.
		//  4500 Seashells - Effects last for 6 seconds.
		//  6000 Seashells - Effects last for 7 seconds.
		if(Game->BottleState[id]==11){
			bitmap b = Game->CreateBitmap(16,16);
			b->Own();
			Game->PlaySound (35);	
			Waitframe();
			int args[8] = {10, 60, 0};
			int effect1 = 0;
			int effect2 = 0;
			int effect3 = 0;
			int effect4 = 0;
			int effect5 = 0;
			int effect6 = 0;
			int effect7 = 0;
			int effect8 = 0;
			int RNG = 0;
			int num = 1;
			int tim = 300;
			
			//Seashell Check
			if(Game->Counter[14]>=3500){num = 8;}
			else if(Game->Counter[14]>=3000){num = 7;}
			else if(Game->Counter[14]>=2500){num = 6;}
			else if(Game->Counter[14]>=2000){num = 5;}
			else if(Game->Counter[14]>=1500){num = 4;}
			else if(Game->Counter[14]>=1000){num = 3;}
			else if(Game->Counter[14]>=500){num = 2;}
			
			//Generate Randomness
			for(int i=0; i<num; ++i){
				RNG = Rand(1,8);
				while(RNG < 10){
					if((RNG==1)&&(effect1==0)){
						effect1 = 1;
						RNG = 10;
					}
					else if((RNG==2)&&(effect2==0)){
						effect2 = 1;
						RNG = 10;
					}
					else if((RNG==3)&&(effect3==0)){
						effect3 = 1;
						RNG = 10;
					}
					else if((RNG==4)&&(effect4==0)){
						effect4 = 1;
						RNG = 10;
					}
					else if((RNG==5)&&(effect5==0)){
						effect5 = 1;
						RNG = 10;
					}
					else if((RNG==6)&&(effect6==0)){
						effect6 = 1;
						RNG = 10;
					}
					else if((RNG==7)&&(effect7==0)){
						effect7 = 1;
						RNG = 10;
					}
					else if((RNG==8)&&(effect8==0)){
						effect8 = 1;
						RNG = 10;
					}
					else{
						RNG = Rand(1,8);
					}
				}
			}
			
			//Effects
			RunFFCScript(56, args);
			Game->PlaySound(124);
			
			if(effect1){
				Player->Item[252]=true;
			}
			if(effect2){
				Link->HP = Link->MaxHP;
			}
			if(effect3){
				Link->MP = Link->MaxMP;
			}
			if(effect6){
				Game->PlaySound(89);
				Screen->Wavy = 15;
				npc enemys;
				for(int i = 1; i<=Screen->NumNPCs(); i++){
					enemys = Screen->LoadNPC(i); //Targets those enemies.
					enemys->HP-=32; 
				}
			}
			if(effect8){
				CreateItemAt(73, ((Link->X)-24), ((Link->Y)-24));
				CreateItemAt(80, ((Link->X)+24), ((Link->Y)-24));
				CreateItemAt(154, ((Link->X)-24), ((Link->Y)+24));
				CreateItemAt(60, ((Link->X)+24), ((Link->Y)+24));
			}
			if(Game->Counter[14]>=4500){tim = 360;}
			if(Game->Counter[14]>=6000){tim = 720;}
			if(effect1||effect4||effect5||effect7){
				for(int i = 0; i<tim; i++){
					if(effect1){
						FastCombo(6,240,0,15590,7,OP_OPAQUE);
					}
					if(effect4){
						if(i%2){Link->HP += 1;}
						if(effect1){
							FastCombo(6,224,0,15556,8,OP_OPAQUE);
						}
						else{
							FastCombo(6,240,0,15556,8,OP_OPAQUE);
						}
					}
					if(effect7){
						b->Clear(0);
						b->FastTile(0,0,0,Link->Tile,6,OP_OPAQUE);
						if(i%4 < 2){
							b->ReplaceColors(0,0x01,0x01,0xFF);
							b->Blit(SPLAYER_PLAYER_DRAW,RT_SCREEN,0,0,16,16,Link->X,Link->Y-Link->Z,16,16,0,0,0,BITDX_NORMAL,0,true);
						}
						Hero->InvFrames = 8;
						if(effect1&&effect4){
							FastCombo(6,208,0,15331,11,OP_OPAQUE);
						}
						else if(effect1||effect4){
							FastCombo(6,224,0,15331,11,OP_OPAQUE);
						}
						else{
							FastCombo(6,240,0,15331,11,OP_OPAQUE);
						}
					}
					if((effect5)&&(i%60==0)){
						for(int i; i < 15; i++){
						Game->PlaySound(32);
						lweapon magic = CreateLWeaponAt(2, Link->X, Link->Y);
						magic->Angular = true;
						magic->Angle = DegtoRad(i*24);
						magic->Step = 420;
						magic->UseSprite(183);
						magic->Damage = 22;
						}
					}
					Waitframe();
					if (i==(tim-60)){
						RunFFCScript(56, args);
						Game->PlaySound(124);
					}
				}
			}
			Player->Item[252]=false;
		}
	}
}

generic script bottleDiscard{
	void run(){
		
		//Setup Bottles
