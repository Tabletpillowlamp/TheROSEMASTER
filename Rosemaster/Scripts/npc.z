const int RESET_NPC_LAYER_ON_ENTRY = 0; //This fix will replace all CMB_NPC_SOLID tiles with CMB_NPC_HIDDEN 
										//when entering the screen. This should prevent problems with shared
										//layers. If you don't want this fix, set it to 0.

const int LAYER_NPC = 1; //The layer NPCs use for solid combos
const int CMB_NPC_HIDDEN = 47; //Non-solid combo used for hidden NPCs
const int CMB_NPC_SOLID = 43; //Solid combo placed under visible NPCs

const int LAYER_NPC_CANTALK = 4; //The layer used for the speech bubble
const int CMB_NPC_CANTALK = 9059; //The combo used for the speech bubble
const int CS_NPC_CANTALK = 8; //The CSet used for the speech bubble

const int NPCBT_NONE = 0; //Regular NPCs
const int NPCBT_FACELINK = 1; //NPCs that turn to face Link
const int NPCBT_GUARDH = 2; //NPCs that move along a horizontal path
const int NPCBT_GUARDV = 3; //NPCs that move along a vertical path

ffc script NPCScript{
	void run(int String, int ItemCheck, int Type, int Arg1, int Arg2, int NoSolid, int Script){
		//Stores the NPC's combo, hides it
		int Combo = this->Data;
		this->Data = CMB_NPC_HIDDEN;
		
		//Waits until the NPC should appear and shows it
		//If value is 300, NPC disappears when secrets are triggered.
		if(ItemCheck==300){
			if(!Screen->SecretsTriggered()){
				this->Data = Combo;
				if(Type==NPCBT_FACELINK){
					this->Data = Combo + Arg1;
				}
			//else{
			//	Waitframe();
			//}
			}
		}
		else if(ItemCheck==301){		//Exception 1 (Cain in Bed, appears only if counter 12 is exactly 10)
			while(Game->Counter[12] != 10){
				Waitframe();
			}
			else{
				this->Data = Combo;
				if(Type==NPCBT_FACELINK){
					this->Data = Combo + Arg1;
				}
			}
		}
		else if(ItemCheck==302){		//Exception 2 (Solarette second appearance, from event 6-14. Chapter 3-4)
			while((Game->Counter[12] < 6) || (Game->Counter[12] > 13)){
				Waitframe();
			}
			else{
				this->Data = Combo;
				if(Type==NPCBT_FACELINK){
					this->Data = Combo + Arg1;
				}
			}
		}
		else if(ItemCheck==303){		//Exception 3 (Juan confronting guard, from event 14-16)
			while((Game->Counter[12] < 14) || (Game->Counter[12] > 15)){
				Waitframe();
			}
			else{
				this->Data = Combo;
				if(Type==NPCBT_FACELINK){
					this->Data = Combo + Arg1;
				}
			}
		}
		else if(ItemCheck==304){		//Exception 4 (Seth Shop Sign in the Demilitarized Zone, from event 4-20)
			while((Game->Counter[12] < 4) || (Game->Counter[12] > 19)){
				Waitframe();
			}
			else{
				this->Data = Combo;
				if(Type==NPCBT_FACELINK){
					this->Data = Combo + Arg1;
				}
			}
		}
		else if(ItemCheck==305){		//Exception 5 (Juan in Chapter 5, from event 16-20)
			while((Game->Counter[12] < 16) || (Game->Counter[12] > 19)){
				Waitframe();
			}
			else{
				this->Data = Combo;
				if(Type==NPCBT_FACELINK){
					this->Data = Combo + Arg1;
				}
			}
		}
		else if(ItemCheck==306){		//Exception 6 (Soldier from Outpost, from event 10-20)
			while((Game->Counter[12] < 10) || (Game->Counter[12] > 19)){
				Waitframe();
			}
			else{
				this->Data = Combo;
				if(Type==NPCBT_FACELINK){
					this->Data = Combo + Arg1;
				}
			}
		}
		else if(ItemCheck==307){		//Exception 7 (Auditorium Guard (Disappears after ticket or flippers)
			while((Link->Item[Abs(139)]) || (Link->Item[Abs(51)])){
				Waitframe();
			}
			else{
				this->Data = Combo;
				if(Type==NPCBT_FACELINK){
					this->Data = Combo + Arg1;
				}
			}
		}
		else if(ItemCheck==308){		//Exception 8 (Saria in the Library)
			while(Game->Counter[15] != 4){
				Waitframe();
			}
			else{
				this->Data = Combo;
				if(Type==NPCBT_FACELINK){
					this->Data = Combo + Arg1;
				}
			}
		}
		else if(ItemCheck==309){		//Exception 9 (Medley in Grass Land, from event 37-39)
			while((Game->Counter[12] < 37) || (Game->Counter[12] > 38)){
				Waitframe();
			}
			else{
				this->Data = Combo;
				if(Type==NPCBT_FACELINK){
					this->Data = Combo + Arg1;
				}
			}
		}
		else if(ItemCheck==310){		//Exception 10 (Ciela in the Diner of Courage from event 33-38)
			while((Game->Counter[12] < 33) || (Game->Counter[12] > 37)){
				Waitframe();
			}
			else{
				this->Data = Combo;
				if(Type==NPCBT_FACELINK){
					this->Data = Combo + Arg1;
				}
			}
		}
		else if(ItemCheck==311){		//Exception 11 (Medley's Tea House Sign from event 34-41)
			while((Game->Counter[12] < 34) || (Game->Counter[12] > 40)){
				Waitframe();
			}
			else{
				this->Data = Combo;
				if(Type==NPCBT_FACELINK){
					this->Data = Combo + Arg1;
				}
			}
		}
		else if(ItemCheck==312){		//Exception 12 (Aurelia in Diner of Courage, from event2 13, disappears on event1 42 and 43 only if Link chooses Ending A)
			while((Game->Counter[15] < 13) || (Game->Counter[12] == 42) || (Link->Item[180]) || (Game->Counter[12] >= 44)){
				Waitframe();
			}
			else{
				this->Data = Combo;
				if(Type==NPCBT_FACELINK){
					this->Data = Combo + Arg1;
				}
			}
		}
		else if(ItemCheck==313){		//Exception 13 (Ciela in Diner of Courage 2F, only event 42)
			while((Game->Counter[12] != 42)){
				Waitframe();
			}
			else{
				this->Data = Combo;
				if(Type==NPCBT_FACELINK){
					this->Data = Combo + Arg1;
				}
			}
		}
		else if(ItemCheck==314){		//Exception 14 (Ciela DoC Office, Appears at event 41 and 44+)
			while((Game->Counter[12] < 41) || (Game->Counter[12] == 42) || (Game->Counter[12] == 43)){
				Waitframe();
			}
			else{
				this->Data = Combo;
				if(Type==NPCBT_FACELINK){
					this->Data = Combo + Arg1;
				}
			}
		}
		else if(ItemCheck==315){		//Exception 15 (Ciela 2 in Diner of Courage 2F, only event 43)
			while((Game->Counter[12] != 43)){
				Waitframe();
			}
			else{
				this->Data = Combo;
				if(Type==NPCBT_FACELINK){
					this->Data = Combo + Arg1;
				}
			}
		}
		else if(ItemCheck==316){		//Exception 16 (Soja, Event1 is 10 or greater, leaves if Ending A chosen)
			while((Game->Counter[12] < 10) || (Link->Item[180])){
				Waitframe();
			}
			else{
				this->Data = Combo;
				if(Type==NPCBT_FACELINK){
					this->Data = Combo + Arg1;
				}
			}
		}
		else if(ItemCheck==317){		//Exception 17 (Elena in the Diner of Courage)
			while((Game->Counter[15] < 13) || (Game->Counter[12] >= 44)){
				Waitframe();
			}
			else{
				this->Data = Combo;
				if(Type==NPCBT_FACELINK){
					this->Data = Combo + Arg1;
				}
			}
		}
		else if(ItemCheck==318){		//Exception 18 (Cain in the Diner of Courage)
			while((Game->Counter[12] < 41) || (Game->Counter[12] >= 48)){
				Waitframe();
			}
			else{
				this->Data = Combo;
				if(Type==NPCBT_FACELINK){
					this->Data = Combo + Arg1;
				}
			}
		}
		else if(ItemCheck==319){		//Exception 19 (Colin in Hyrule Castle Progress 22-44)
			while((Game->Counter[12] < 22) || (Game->Counter[12] >= 44)){
				Waitframe();
			}
			else{
				this->Data = Combo;
				if(Type==NPCBT_FACELINK){
					this->Data = Combo + Arg1;
				}
			}
		}
		else if(ItemCheck==320){		//Exception 20 (Kalin and Elena in Estate B2 Only 45)
			while(Game->Counter[12] != 45){
				Waitframe();
			}
			else{
				this->Data = Combo;
				if(Type==NPCBT_FACELINK){
					this->Data = Combo + Arg1;
				}
			}
		}
		else if(ItemCheck==321){				//Exception 21 (Aurelia Secret)	
			while(Screen->SecretsTriggered() || !Link->Item[181]){
				Waitframe();
			}
			else{
				this->Data = Combo;
				if(Type==NPCBT_FACELINK){
					this->Data = Combo + Arg1;
				}
			}
		}
		else if(ItemCheck==322){				//Exception 22 Soldier near Desert entrance in Chapter 2
			while((Game->Counter[12] < 5) || (Game->Counter[11] >= 3)){
				Waitframe();
			}
			else{
				this->Data = Combo;
				if(Type==NPCBT_FACELINK){
					this->Data = Combo + Arg1;
				}
			}
		}
		else if(ItemCheck==323){				//Exception 23 Hal in Diner of Courage
			while(!Game->LoadMapData(132, 0x3F)->State[ST_ITEM]){
				Waitframe();
			}
			else{
				this->Data = Combo;
				if(Type==NPCBT_FACELINK){
					this->Data = Combo + Arg1;
				}
			}
		}
		else if(ItemCheck==324){				//Exception 24 Boss Rush Guy in Link's Estate
			while((!Link->Item[64] && !Link->Item[243]) || Screen->SecretsTriggered()){
				Waitframe();
			}
			else{
				this->Data = Combo;
				if(Type==NPCBT_FACELINK){
					this->Data = Combo + Arg1;
				}
			}
		}
		//NPC Appears if Progress 1
		else if((ItemCheck>400) && (ItemCheck<500)){
			int count = ItemCheck - 400;
			while(count > Game->Counter[12]){
				Waitframe();
			}
			else{
				this->Data = Combo;
				if(Type==NPCBT_FACELINK){
					this->Data = Combo + Arg1;
				}
			}
		}	
		//NPC Appears if Progress 2
		else if((ItemCheck>500) && (ItemCheck<600)){
			int count = ItemCheck - 500;
			while(count > Game->Counter[15]){
				Waitframe();
			}
			else{
				this->Data = Combo;
				if(Type==NPCBT_FACELINK){
					this->Data = Combo + Arg1;
				}
			}
		}
		//NPC Disappears if Progress 1
		else if((ItemCheck>1000) && (ItemCheck<2000)){
			int count = ItemCheck - 1000;
			while(count <= Game->Counter[12]){
				Waitframe();
			}
			else{
				this->Data = Combo;
				if(Type==NPCBT_FACELINK){
					this->Data = Combo + Arg1;
				}
			}
		}		
		//NPC Disappears if Progress 2
		else if(ItemCheck>2000){
			int count = ItemCheck - 2000;
			while(count <= Game->Counter[15]){
				Waitframe();
			}
			else{
				this->Data = Combo;
				if(Type==NPCBT_FACELINK){
					this->Data = Combo + Arg1;
				}
			}
		}	
		else if(ItemCheck<0){
			while(!Link->Item[Abs(ItemCheck)]){
				Waitframe();
			}
			this->Data = Combo;
			if(Type==NPCBT_FACELINK){
				this->Data = Combo + Arg1;
			}
		}
		else if(ItemCheck>0){
			if(!Link->Item[Abs(ItemCheck)]){
				this->Data = Combo;
				if(Type==NPCBT_FACELINK){
					this->Data = Combo + Arg1;
				}
			}
		}
		else if(ItemCheck==0){
			this->Data = Combo;
			if(Type==NPCBT_FACELINK){
				this->Data = Combo + Arg1;
			}
		}
			
		//Saves the width and height of the FFC for collision checks
		int Width = 16;
		int Height = 16;
		if(this->EffectWidth!=16)
			Width = this->EffectWidth;
		else if(this->TileWidth>1)
			Width = this->TileWidth*16;
		if(this->EffectHeight!=16)
			Height = this->EffectHeight;
		else if(this->TileHeight>1)
			Height = this->TileHeight*16;
		//Wait until the screen is done scrolling to avoid a weird ZC crashing bug
		Waitframe();
		while(Link->Action==LA_SCROLLING){
			Waitframe();
		}
		//Shared Layer Fix
		if(RESET_NPC_LAYER_ON_ENTRY==1){
			if(Screen->LoadFFC(FindFFCRunning(this->Script))==this){
				for(int i=0; i<176; i++){
					if(GetLayerComboD(LAYER_NPC, i)==CMB_NPC_SOLID){
						SetLayerComboD(LAYER_NPC, i, CMB_NPC_HIDDEN);
					}
				}
			}
		}
		//Sets the space below the NPC or the space a guard NPC occupies to be solid
		if(LAYER_NPC>-1&&NoSolid==0){
			if(Type==NPCBT_GUARDH){
				for(int x=Arg1; x<=Arg2+this->TileWidth-1; x++){
					for(int y=Floor(this->Y/16); y<=Floor(this->Y/16)+this->TileHeight-1; y++){
						SetLayerComboD(LAYER_NPC, y*16+x, CMB_NPC_SOLID);
					}
				}
			}
			else if(Type==NPCBT_GUARDV){
				for(int x=Floor(this->X/16); x<=Floor(this->X/16)+this->TileWidth-1; x++){
					for(int y=Arg1; y<=Arg2+this->TileHeight-1; y++){
						SetLayerComboD(LAYER_NPC, y*16+x, CMB_NPC_SOLID);
					}
				}
			}
			else{
				for(int x=Floor(this->X/16); x<=Floor(this->X/16)+this->TileWidth-1; x++){
					for(int y=Floor(this->Y/16); y<=Floor(this->Y/16)+this->TileHeight-1; y++){
						SetLayerComboD(LAYER_NPC, y*16+x, CMB_NPC_SOLID);
					}
				}
			}
		}
		while(true){
			//Removes NPCs if Link has the required item
			if(ItemCheck>0){
				if((Link->Item[ItemCheck] && ItemCheck<=255) || (ItemCheck==300 && Screen->SecretsTriggered())){
					this->Data = CMB_NPC_HIDDEN;
					if(LAYER_NPC>-1&&NoSolid==0){
						if(Type==NPCBT_GUARDH){
							for(int x=Arg1; x<=Arg2+this->TileWidth-1; x++){
								for(int y=Floor(this->Y/16); y<=Floor(this->Y/16)+this->TileHeight-1; y++){
									SetLayerComboD(LAYER_NPC, y*16+x, CMB_NPC_HIDDEN);
								}
							}
						}
						else if(Type==NPCBT_GUARDV){
							for(int x=Floor(this->X/16); x<=Floor(this->X/16)+this->TileWidth-1; x++){
								for(int y=Arg1; y<=Arg2+this->TileHeight-1; y++){
									SetLayerComboD(LAYER_NPC, y*16+x, CMB_NPC_HIDDEN);
								}
							}
						}
						else{
							for(int x=Floor(this->X/16); x<=Floor(this->X/16)+this->TileWidth-1; x++){
								for(int y=Floor(this->Y/16); y<=Floor(this->Y/16)+this->TileHeight-1; y++){
									SetLayerComboD(LAYER_NPC, y*16+x, CMB_NPC_HIDDEN);
								}
							}
						}
					}
					Quit();
				}
			}
			//Handles animation for turning NPCs
			if(Type==NPCBT_FACELINK&&(Link->X>0&&Link->X<240&&Link->Y>0&&Link->Y<160)){
				if(Distance(CenterLinkX(), CenterLinkY(), CenterX(this), CenterY(this))<Arg2)
					this->Data = Combo + AngleDir4(Angle(CenterX(this), CenterY(this), CenterLinkX(), CenterLinkY()));
				else
					this->Data = Combo + Arg1;
			}
			//Handles movement for guard NPCs
			else if(Type==NPCBT_GUARDH){
				if(Link->X>16*Arg1-32&&Link->X<16*Arg2+32&&Link->Y>this->Y-32&&Link->Y<this->Y+32){
					this->X = Clamp(this->X+(-this->X + Link->X)/4, 16*Arg1, 16*Arg2);
				}
			}
			else if(Type==NPCBT_GUARDV){
				if(Link->X>this->X-32&&Link->X<this->X+32&&Link->Y>16*Arg1-32&&Link->Y<16*Arg2+32){
					this->Y = Clamp(this->Y+(-this->Y + Link->Y)/4, 16*Arg1, 16*Arg2);
				}
			}
			//Facing Up
			if(Link->Dir==DIR_UP&&Link->Y>=this->Y&&Link->Y<=this->Y+Height-8&&Link->X>=this->X-8&&Link->X<=this->X+Width-8){
				if(CMB_NPC_CANTALK>0)
					Screen->FastCombo(LAYER_NPC_CANTALK, Link->X, Link->Y-16, CMB_NPC_CANTALK, CS_NPC_CANTALK, 128);
				if(Link->PressA){
					Link->InputA = false;
					Link->PressA = false;
					Screen->Message(String);
					if(Script>0){
						RunFFCScript(Script, 0);
					}
				}
			}
			//Facing Down
			else if(Link->Dir==DIR_DOWN&&Link->Y>=this->Y-16&&Link->Y<=this->Y+Height-16&&Link->X>=this->X-8&&Link->X<=this->X+Width-8){
				if(CMB_NPC_CANTALK>0)
					Screen->FastCombo(LAYER_NPC_CANTALK, Link->X, Link->Y-16, CMB_NPC_CANTALK, CS_NPC_CANTALK, 128);
				if(Link->PressA){
					Link->InputA = false;
					Link->PressA = false;
					Screen->Message(String);
					if(Script>0){
						RunFFCScript(Script, 0);
					}
				}
			}
			//Facing Left
			else if(Link->Dir==DIR_LEFT&&Link->Y>=this->Y-8&&Link->Y<=this->Y+Height-8&&Link->X>=this->X&&Link->X<=this->X+Width){
				if(CMB_NPC_CANTALK>0)
					Screen->FastCombo(LAYER_NPC_CANTALK, Link->X, Link->Y-16, CMB_NPC_CANTALK, CS_NPC_CANTALK, 128);
				if(Link->PressA){
					Link->InputA = false;
					Link->PressA = false;
					Screen->Message(String);
					if(Script>0){
						RunFFCScript(Script, 0);
					}
				}
			}
			//Facing Right
			else if(Link->Dir==DIR_RIGHT&&Link->Y>=this->Y-8&&Link->Y<=this->Y+Height-8&&Link->X>=this->X-16&&Link->X<=this->X+Width-16){
				if(CMB_NPC_CANTALK>0)
					Screen->FastCombo(LAYER_NPC_CANTALK, Link->X, Link->Y-16, CMB_NPC_CANTALK, CS_NPC_CANTALK, 128);
				if(Link->PressA){
					Link->InputA = false;
					Link->PressA = false;
					Screen->Message(String);
					if(Script>0){
						RunFFCScript(Script, 0);
					}
				}
			}
			Waitframe();
		}
	}
}

ffc script NPCScript_Simple{
	void run(int String, int Script, int D0, int D1, int D2, int D3, int D4, int D5){
		//Saves the width and height of the FFC for collision checks
		int Width = 16;
		int Height = 16;
		if(this->EffectWidth!=16)
			Width = this->EffectWidth;
		else if(this->TileWidth>1)
			Width = this->TileWidth*16;
		if(this->EffectHeight!=16)
			Height = this->EffectHeight;
		else if(this->TileHeight>1)
			Height = this->TileHeight*16;
		while(true){
			//Facing Up
			if(Link->Dir==DIR_UP&&Link->Y>=this->Y&&Link->Y<=this->Y+Height-8&&Link->X>=this->X-8&&Link->X<=this->X+Width-8){
				if(CMB_NPC_CANTALK>0)
					Screen->FastCombo(LAYER_NPC_CANTALK, Link->X, Link->Y-16, CMB_NPC_CANTALK, CS_NPC_CANTALK, 128);
				if(Link->PressA){
					Link->InputA = false;
					Link->PressA = false;
					Screen->Message(String);
					if(Script>0){
						int Args[8] = {D0, D1, D2, D3, D4, D5};
						RunFFCScript(Script, Args);
					}
				}
			}
			//Facing Down
			else if(Link->Dir==DIR_DOWN&&Link->Y>=this->Y-16&&Link->Y<=this->Y+Height-16&&Link->X>=this->X-8&&Link->X<=this->X+Width-8){
				if(CMB_NPC_CANTALK>0)
					Screen->FastCombo(LAYER_NPC_CANTALK, Link->X, Link->Y-16, CMB_NPC_CANTALK, CS_NPC_CANTALK, 128);
				if(Link->PressA){
					Link->InputA = false;
					Link->PressA = false;
					Screen->Message(String);
					if(Script>0){
						int Args[8] = {D0, D1, D2, D3, D4, D5};
						RunFFCScript(Script, Args);
					}
				}
			}
			//Facing Left
			else if(Link->Dir==DIR_LEFT&&Link->Y>=this->Y-8&&Link->Y<=this->Y+Height-8&&Link->X>=this->X&&Link->X<=this->X+Width){
				if(CMB_NPC_CANTALK>0)
					Screen->FastCombo(LAYER_NPC_CANTALK, Link->X, Link->Y-16, CMB_NPC_CANTALK, CS_NPC_CANTALK, 128);
				if(Link->PressA){
					Link->InputA = false;
					Link->PressA = false;
					Screen->Message(String);
					if(Script>0){
						int Args[8] = {D0, D1, D2, D3, D4, D5};
						RunFFCScript(Script, Args);
					}
				}
			}
			//Facing Right
			else if(Link->Dir==DIR_RIGHT&&Link->Y>=this->Y-8&&Link->Y<=this->Y+Height-8&&Link->X>=this->X-16&&Link->X<=this->X+Width-16){
				if(CMB_NPC_CANTALK>0)
					Screen->FastCombo(LAYER_NPC_CANTALK, Link->X, Link->Y-16, CMB_NPC_CANTALK, CS_NPC_CANTALK, 128);
				if(Link->PressA){
					Link->InputA = false;
					Link->PressA = false;
					Screen->Message(String);
					if(Script>0){
						int Args[8] = {D0, D1, D2, D3, D4, D5};
						RunFFCScript(Script, Args);
					}
				}
			}
			Waitframe();
		}
	}
}

const int D_TRADE = 0; //Screen->D value used for the trade sequence state

ffc script TradeSequence{
	void run(int CheckItem, int TradeItem, int NoItemString, int HasItemString, int TradedString){
		//Check if the player has already traded
		if(Screen->D[D_TRADE]==0){
			//If player hasn't traded and has the required item, play HasItemString, give the new item, and take the old item
			if(Link->Item[CheckItem]){
				Screen->Message(HasItemString);
				WaitNoAction();
				item itm = CreateItemAt(TradeItem, Link->X, Link->Y);
				itm->Pickup = IP_HOLDUP;
				Link->Item[CheckItem] = false;
				Screen->D[D_TRADE] = 1;
				WaitNoAction();
			}
			//If player hasn't traded and doesn't have the required item, play NoItemString
			else{
				Screen->Message(NoItemString);
				WaitNoAction();
			}
		}
		//If the player has already traded, play TradedString
		else{
			Screen->Message(TradedString);
			WaitNoAction();
		}
	}
}